index 0000000000000000000000000000000000000000..2f2dbef2cee0d204973d48b9ebfc41eb4d902f35
--- /dev/null
+++ b/android/src/main/java/com/cloudflare/realtimekit/WebRTCModule/ScreenProjectionService.java
@@ -0,0 +1,93 @@
+package com.cloudflare.realtimekit.WebRTCModule;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.ResultReceiver;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.IntConsumer;
+
+public final class ScreenProjectionService extends Service {
+    private static final String CHANNEL = "screen-projection";
+    private static final String RESULT = "result";
+    private static final int NOTIFICATION_ID = 14683;
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static final AtomicInteger TOKENS = new AtomicInteger();
+    private static ScreenProjectionService active;
+
+    private int token;
+    private int latestStartId;
+
+    static void start(Context context, IntConsumer ready) {
+        ResultReceiver result = new ResultReceiver(MAIN) {
+            @Override
+            protected void onReceiveResult(int resultCode, Bundle ignored) {
+                ready.accept(resultCode);
+            }
+        };
+        Intent intent = new Intent(context, ScreenProjectionService.class).putExtra(RESULT, result);
+        try {
+            context.startForegroundService(intent);
+        } catch (RuntimeException failure) {
+            ready.accept(0);
+        }
+    }
+
+    static void release(int token) {
+        if (token == 0) return;
+        MAIN.post(() -> {
+            ScreenProjectionService current = active;
+            // A stopped or replaced projection cannot stop the newer service owner.
+            if (current != null && current.token == token) {
+                current.stopSelfResult(current.latestStartId);
+            }
+        });
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        ResultReceiver result = intent == null ? null : intent.getParcelableExtra(RESULT);
+        if (result == null) {
+            stopSelfResult(startId);
+            return START_NOT_STICKY;
+        }
+        try {
+            NotificationManager notifications = getSystemService(NotificationManager.class);
+            notifications.createNotificationChannel(
+                    new NotificationChannel(CHANNEL, "Screen sharing", NotificationManager.IMPORTANCE_LOW));
+            Notification notification = new Notification.Builder(this, CHANNEL)
+                    .setContentTitle(getApplicationInfo().loadLabel(getPackageManager()))
+                    .setContentText("Sharing your screen")
+                    .setSmallIcon(android.R.drawable.ic_menu_camera)
+                    .setOngoing(true)
+                    .build();
+            startForeground(NOTIFICATION_ID, notification);
+            active = this;
+            latestStartId = startId;
+            token = TOKENS.incrementAndGet();
+            result.send(token, null);
+        } catch (RuntimeException failure) {
+            stopSelfResult(startId);
+            result.send(0, null);
+        }
+        return START_NOT_STICKY;
+    }
+
+    @Override
+    public void onDestroy() {
+        if (active == this) active = null;
+        super.onDestroy();
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+}

{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "composite": true,
    "paths": {
      "@chalk/diagnostics-contracts": ["../../../packages/diagnostics-contracts/dist/index.d.ts"]

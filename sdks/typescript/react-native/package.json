{
  "name": "@q9labsai/chalk-react-native",
  "version": "4.1.12",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/chalk.git",
    "directory": "sdks/typescript/react-native"
  },
  "files": [
    "dist",
    "src",
    "embedded",
    "android",
    "ios",
    "*.podspec"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "android": [
        "./dist/android.d.ts"
      ],
      "ios": [
        "./dist/ios.d.ts"
      ],
      "ios-phone": [
        "./dist/ios-phone.d.ts"
      ],
      "ios-pad": [
        "./dist/ios-pad.d.ts"
      ],
      "macos": [
        "./dist/macos.d.ts"
      ],
      "runtime": [
        "./dist/runtime.d.ts"
      ],
      "clipboard": [
        "./dist/clipboard.d.ts"
      ],
      "diagnostics": [
        "./dist/diagnostics.d.ts"
      ],
      "invites": [
        "./dist/invites.d.ts"
      ],
      "theme": [
        "./dist/ui/theme.d.ts"
      ],
      "appearance": [
        "./dist/ui/appearance.d.ts"
      ],
      "client": [
        "./dist/client.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./android": {
      "types": "./dist/android.d.ts",
      "react-native": "./dist/android.js",
      "import": "./dist/android.js",
      "default": "./dist/android.js"
    },
    "./ios": {
      "types": "./dist/ios.d.ts",
      "react-native": "./dist/ios.js",
      "import": "./dist/ios.js",
      "default": "./dist/ios.js"
    },
    "./ios-phone": {
      "types": "./dist/ios-phone.d.ts",
      "react-native": "./dist/ios-phone.js",
      "import": "./dist/ios-phone.js",
      "default": "./dist/ios-phone.js"
    },
    "./ios-pad": {
      "types": "./dist/ios-pad.d.ts",
      "react-native": "./dist/ios-pad.js",
      "import": "./dist/ios-pad.js",
      "default": "./dist/ios-pad.js"
    },
    "./macos": {
      "types": "./dist/macos.d.ts",
      "react-native": "./dist/macos.js",
      "import": "./dist/macos.js",
      "default": "./dist/macos.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "react-native": "./dist/runtime.js",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "react-native": "./dist/clipboard.js",
      "import": "./dist/clipboard.js",
      "default": "./dist/clipboard.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "react-native": "./dist/diagnostics.js",
      "import": "./dist/diagnostics.js",
      "default": "./dist/diagnostics.js"
    },
    "./invites": {
      "types": "./dist/invites.d.ts",
      "react-native": "./dist/invites.js",
      "import": "./dist/invites.js",
      "default": "./dist/invites.js"
    },
    "./theme": {
      "types": "./dist/ui/theme.d.ts",
      "react-native": "./dist/ui/theme.js",
      "import": "./dist/ui/theme.js",
      "default": "./dist/ui/theme.js"
    },
    "./appearance": {
      "types": "./dist/ui/appearance.d.ts",
      "react-native": "./dist/ui/appearance.js",
      "import": "./dist/ui/appearance.js",
      "default": "./dist/ui/appearance.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "react-native": "./dist/client.js",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsup ./src/index.ts ./src/client.ts ./src/android.ts ./src/ios.ts ./src/ios-phone.ts ./src/ios-pad.ts ./src/macos.ts ./src/runtime.ts ./src/clipboard.ts ./src/diagnostics.ts ./src/invites.ts ./src/ui/theme.ts ./src/ui/appearance.ts --format esm --out-dir ./dist --platform browser --external react --external react-native --external react-native-webview --external @q9labsai/chalk-whiteboard --external @cloudflare/react-native-webrtc --external @cloudflare/realtimekit-react-native && pnpm run build:types && pnpm run sync:whiteboard-assets",
    "build:types": "rm -f tsconfig.tsbuildinfo && tsc --build tsconfig.json",
    "dev": "tsup ./src/index.ts ./src/client.ts ./src/android.ts ./src/ios.ts ./src/ios-phone.ts ./src/ios-pad.ts ./src/macos.ts ./src/runtime.ts ./src/clipboard.ts ./src/diagnostics.ts ./src/invites.ts ./src/ui/theme.ts ./src/ui/appearance.ts --format esm --out-dir ./dist --platform browser --external react --external react-native --external react-native-webview --external @q9labsai/chalk-whiteboard --external @cloudflare/react-native-webrtc --external @cloudflare/realtimekit-react-native --watch",
    "sync:whiteboard-assets": "node ./scripts/sync-whiteboard-assets.mjs",
    "test": "pnpm exec vitest run",
    "check-types": "tsc --project tsconfig.check-types.json --noEmit",
    "check:tokens": "node ./scripts/check-tokenized-styles.mjs",
    "check:client-package": "node ./scripts/check-client-package.mjs",
    "lint": "pnpm run check:tokens && pnpm exec oxfmt --check . && tsc --project tsconfig.check-types.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@q9labsai/chalk-client": "workspace:^4.1.12",
    "@q9labsai/chalk-whiteboard": "workspace:^4.1.12",
    "@q9labsai/facehash": "workspace:^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "react-native-webview": "13.16.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@cloudflare/react-native-webrtc": "~125.0.1 || ~125.0.3",
    "@cloudflare/realtimekit-react-native": "1.1.0",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react-native": "^1.0.13",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.77",
    "react-native-svg": "^15.15.3",
    "react-native-webview": "^13.16.1"
  }
}

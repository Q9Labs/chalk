{
  "name": "@q9labsai/chalk-react-native",
  "version": "5.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/chalk.git",
    "directory": "sdks/typescript/react-native"
  },
  "files": [
    "dist",
    "src",
    "embedded",
    "android",
    "ios",
    "*.podspec"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "runtime": [
        "./dist/runtime.d.ts"
      ],
      "clipboard": [
        "./dist/clipboard.d.ts"
      ],
      "diagnostics": [
        "./dist/diagnostics.d.ts"
      ],
      "invites": [
        "./dist/invites.d.ts"
      ],
      "client": [
        "./dist/client.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "react-native": "./dist/runtime.js",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "react-native": "./dist/clipboard.js",
      "import": "./dist/clipboard.js",
      "default": "./dist/clipboard.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "react-native": "./dist/diagnostics.js",
      "import": "./dist/diagnostics.js",
      "default": "./dist/diagnostics.js"
    },
    "./invites": {
      "types": "./dist/invites.d.ts",
      "react-native": "./dist/invites.js",
      "import": "./dist/invites.js",
      "default": "./dist/invites.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "react-native": "./dist/client.js",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsup ./src/index.ts ./src/client.ts ./src/runtime.ts ./src/clipboard.ts ./src/diagnostics.ts ./src/invites.ts --format esm --out-dir ./dist --platform browser --external react --external react-native --external react-native-webview --external @q9labsai/chalk-whiteboard --external @cloudflare/react-native-webrtc --external expo-audio --external expo-haptics --external react-native-gesture-handler --external react-native-reanimated --external react-native-safe-area-context --external react-native-svg --loader .wav=copy && pnpm run build:types && pnpm run sync:whiteboard-assets",
    "build:types": "rm -f tsconfig.tsbuildinfo && tsc --build tsconfig.json",
    "dev": "tsup ./src/index.ts ./src/client.ts ./src/runtime.ts ./src/clipboard.ts ./src/diagnostics.ts ./src/invites.ts --format esm --out-dir ./dist --platform browser --external react --external react-native --external react-native-webview --external @q9labsai/chalk-whiteboard --external @cloudflare/react-native-webrtc --external expo-audio --external expo-haptics --external react-native-gesture-handler --external react-native-reanimated --external react-native-safe-area-context --external react-native-svg --loader .wav=copy --watch",
    "sync:whiteboard-assets": "node ./scripts/sync-whiteboard-assets.mjs",
    "test": "pnpm exec vitest run",
    "check-types": "tsc-rs --project tsconfig.check-types.json --noEmit",
    "check:tokens": "node ./scripts/check-tokenized-styles.mjs",
    "check:client-package": "node ./scripts/check-client-package.mjs",
    "lint": "pnpm run check:tokens && pnpm exec oxfmt --check . && tsc --project tsconfig.check-types.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@q9labsai/chalk-client": "workspace:^5.0.0",
    "@q9labsai/chalk-whiteboard": "workspace:^5.0.0",
    "@q9labsai/facehash": "workspace:^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "expo-audio": "~55.0.18",
    "expo-haptics": "~55.0.18",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "^15.15.3",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.7.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@cloudflare/react-native-webrtc": "~125.0.1 || ~125.0.3",
    "expo-audio": "~55.0.18",
    "expo-haptics": "~55.0.18",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.77",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "^15.15.3",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.7.2"
  }
}

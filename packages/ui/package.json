{
  "name": "@q9labsai/chalk-ui",
  "version": "4.1.12",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/chalk.git",
    "directory": "packages/ui"
  },
  "style": "./dist/styles.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "assets": [
        "./dist/assets.d.ts"
      ],
      "badge": [
        "./dist/badge.d.ts"
      ],
      "button": [
        "./dist/button.d.ts"
      ],
      "card": [
        "./dist/card.d.ts"
      ],
      "input": [
        "./dist/input.d.ts"
      ],
      "menu": [
        "./dist/menu.d.ts"
      ],
      "select": [
        "./dist/select.d.ts"
      ],
      "sidebar": [
        "./dist/sidebar.d.ts"
      ],
      "textarea": [
        "./dist/textarea.d.ts"
      ],
      "spinner": [
        "./dist/spinner.d.ts"
      ],
      "skeleton": [
        "./dist/skeleton.d.ts"
      ],
      "icon-button": [
        "./dist/icon-button.d.ts"
      ],
      "progress-bar": [
        "./dist/progress-bar.d.ts"
      ],
      "reactions": [
        "./dist/reactions.d.ts"
      ],
      "status-badge": [
        "./dist/status-badge.d.ts"
      ],
      "toast": [
        "./dist/toast.d.ts"
      ],
      "toggle": [
        "./dist/toggle.d.ts"
      ],
      "toggle-group": [
        "./dist/toggle-group.d.ts"
      ],
      "tooltip": [
        "./dist/tooltip.d.ts"
      ],
      "utils": [
        "./dist/lib/utils.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    },
    "./sidebar": {
      "types": "./dist/sidebar.d.ts",
      "import": "./dist/sidebar.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "import": "./dist/textarea.js"
    },
    "./spinner": {
      "types": "./dist/spinner.d.ts",
      "import": "./dist/spinner.js"
    },
    "./skeleton": {
      "types": "./dist/skeleton.d.ts",
      "import": "./dist/skeleton.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button.d.ts",
      "import": "./dist/icon-button.js"
    },
    "./progress-bar": {
      "types": "./dist/progress-bar.d.ts",
      "import": "./dist/progress-bar.js"
    },
    "./logos/*": "./dist/logos/*",
    "./reactions": {
      "types": "./dist/reactions.d.ts",
      "import": "./dist/reactions.js"
    },
    "./status-badge": {
      "types": "./dist/status-badge.d.ts",
      "import": "./dist/status-badge.js"
    },
    "./toast": {
      "types": "./dist/toast.d.ts",
      "import": "./dist/toast.js"
    },
    "./toggle": {
      "types": "./dist/toggle.d.ts",
      "import": "./dist/toggle.js"
    },
    "./toggle-group": {
      "types": "./dist/toggle-group.d.ts",
      "import": "./dist/toggle-group.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsup ./src/index.ts ./src/assets.ts ./src/badge.tsx ./src/button.tsx ./src/card.tsx ./src/input.tsx ./src/menu.tsx ./src/select.tsx ./src/sidebar.tsx ./src/textarea.tsx ./src/spinner.tsx ./src/skeleton.tsx ./src/icon-button.tsx ./src/progress-bar.tsx ./src/lib/utils.ts ./src/reactions.ts ./src/status-badge.tsx ./src/toast.tsx ./src/toggle.tsx ./src/toggle-group.tsx ./src/tooltip.tsx --format esm --out-dir ./dist --platform node --no-splitting --external react --external @base-ui/react --external @q9labsai/chalk-assets --external class-variance-authority --external clsx --external tailwind-merge && pnpm run build:types && pnpm run build:css && pnpm run build:logos",
    "build:types": "rm -f tsconfig.tsbuildinfo && tsc --emitDeclarationOnly --declaration --outDir dist",
    "build:css": "mkdir -p ./dist && cp ./src/styles/index.css ./dist/styles.css",
    "build:logos": "mkdir -p ./dist && cp -R ../assets/src/logos ./dist/",
    "dev": "pnpm run build:css && pnpm run build:logos && tsup ./src/index.ts ./src/assets.ts ./src/badge.tsx ./src/button.tsx ./src/card.tsx ./src/input.tsx ./src/menu.tsx ./src/select.tsx ./src/sidebar.tsx ./src/textarea.tsx ./src/spinner.tsx ./src/skeleton.tsx ./src/icon-button.tsx ./src/progress-bar.tsx ./src/lib/utils.ts ./src/reactions.ts ./src/status-badge.tsx ./src/toast.tsx ./src/toggle.tsx ./src/toggle-group.tsx ./src/tooltip.tsx --format esm --out-dir ./dist --platform node --no-splitting --external react --external @base-ui/react --external @q9labsai/chalk-assets --external class-variance-authority --external clsx --external tailwind-merge --watch",
    "check-types": "tsc --project tsconfig.check-types.json --noEmit",
    "lint": "pnpm exec oxfmt --check . && tsc --project tsconfig.check-types.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@q9labsai/chalk-assets": "workspace:^4.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.2",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalk.dev/schemas/safe-id-classes.v1.schema.json",
  "title": "Safe ID Class Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "classes", "unknownClass"],
  "properties": {
    "schemaVersion": { "const": "SafeIdClassRegistry/v1" },
    "version": { "const": 1 },
    "unknownClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "copyable", "unknownReason"],
      "properties": {
        "storage": { "const": "hmac" },
        "copyable": { "const": false },
        "unknownReason": { "const": "provider_opaque" }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idClass", "storage", "copyable", "maxLength", "alphabet"],
        "properties": {
          "idClass": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9_-]+)*$" },
          "storage": { "enum": ["raw", "hmac"] },
          "copyable": { "type": "boolean" },
          "maxLength": { "type": "integer", "minimum": 1, "maximum": 1024 },
          "alphabet": { "enum": ["hex", "token", "safe"] }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalk.dev/schemas/diagnostic-event.v1.schema.json",
  "title": "DiagnosticEventDraft/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "eventId", "producerSequence", "occurredAt", "source", "name", "phase", "state"],
  "properties": {
    "version": { "const": 1 },
    "eventId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
    "producerOperationRef": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
    "parentProducerOperationRef": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
    "producerSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "occurredAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "source": { "enum": ["ui", "sdk", "api", "sync", "rtc", "provider", "worker"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9_.-]*$" },
    "phase": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z][a-z0-9_]*$" },
    "state": { "enum": ["started", "observed", "succeeded", "failed", "cancelled", "timed_out", "not_observable", "late_observed"] },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "checkpoint", "checkpointClass"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "version": { "type": "integer", "minimum": 1, "maximum": 255 },
        "checkpoint": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,95}$" },
        "checkpointClass": { "enum": ["required", "conditional", "best_effort"] },
        "deadlineAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "journeyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
        "traceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
        "spanId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
        "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
        "commandId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
        "providerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
        "retryGroupRef": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" },
        "sourceCommit": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$" }
      }
    },
    "attributes": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": false,
      "patternProperties": {
        "^(action|checkpoint|reason|result|status|kind|direction|transport|media_kind|track_state|permission|target_state|response_class|delivery_status|storage_state|object_ref_class|attachment_type|size_bucket|safe_id_class|visibility|recipient_count|projection_count|observable_recipient_count|attempt|retryable|budget_remaining|duration_ms|latency_ms|bytes|count|cursor|sequence|grace_ms|deadline_ms|state_version|policy_version|release_channel|close_code)$": {
          "type": ["boolean", "number", "string"],
          "maxLength": 256
        }
      }
    }
  },
  "x-encoded-max-bytes": 2048,
  "x-allowed-event-name-roots": [
    "episode",
    "access",
    "participant",
    "microphone",
    "camera",
    "media_request",
    "screen",
    "sync",
    "chat",
    "reaction",
    "admission",
    "moderation",
    "recovery",
    "recording",
    "transcription",
    "cleanup",
    "artifact",
    "webhook",
    "whiteboard",
    "coverage",
    "operation",
    "checkpoint",
    "issue",
    "branch",
    "diagnostic"
  ],
  "x-allowed-phases": [
    "intent",
    "validation",
    "authorized",
    "denied",
    "enqueued",
    "attempt",
    "retry",
    "started",
    "observed",
    "connected",
    "authenticated",
    "snapshot",
    "live",
    "reconnected",
    "disconnected",
    "acquired",
    "prepared",
    "published",
    "subscribed",
    "first_frame",
    "committed",
    "receipt",
    "projected",
    "paged",
    "read",
    "deduped",
    "expired",
    "callback",
    "finalized",
    "delivered",
    "exhausted",
    "fan_in",
    "unsupported",
    "succeeded",
    "failed",
    "cancelled",
    "timed_out",
    "not_observable",
    "late_observed"
  ],
  "x-attribute-allowlist": [
    "action",
    "checkpoint",
    "reason",
    "result",
    "status",
    "kind",
    "direction",
    "transport",
    "media_kind",
    "track_state",
    "permission",
    "target_state",
    "response_class",
    "delivery_status",
    "storage_state",
    "object_ref_class",
    "attachment_type",
    "size_bucket",
    "safe_id_class",
    "visibility",
    "recipient_count",
    "projection_count",
    "observable_recipient_count",
    "attempt",
    "retryable",
    "budget_remaining",
    "duration_ms",
    "latency_ms",
    "bytes",
    "count",
    "cursor",
    "sequence",
    "grace_ms",
    "deadline_ms",
    "state_version",
    "policy_version",
    "release_channel",
    "close_code"
  ]
}

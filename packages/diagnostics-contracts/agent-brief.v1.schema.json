{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalk.dev/schemas/agent-brief.v1.schema.json",
  "title": "AgentBrief/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "reference", "captureTime", "observedSummary", "environment", "resolverCommand", "releaseCommits", "visibleGaps", "counts", "omissions"],
  "properties": {
    "schemaVersion": { "const": "AgentBrief/v1" },
    "version": { "const": 1 },
    "reference": { "type": "string", "pattern": "^chalkdiag:v1:(localhost|development|staging):[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?::(op|issue|event):[A-Za-z0-9][A-Za-z0-9_-]{0,127})?(?:@[0-9]+)?$" },
    "focusedReference": { "type": "string", "pattern": "^chalkdiag:v1:(localhost|development|staging):[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?::(op|issue|event):[A-Za-z0-9][A-Za-z0-9_-]{0,127})?(?:@[0-9]+)?$" },
    "captureTime": { "type": "string", "format": "date-time" },
    "selectedCursor": { "type": "integer", "minimum": 0 },
    "runEndCursor": { "type": "integer", "minimum": 0 },
    "observedSummary": { "type": "string", "minLength": 1, "maxLength": 512 },
    "environment": { "enum": ["localhost", "development", "staging"] },
    "resolverCommand": { "type": "string", "pattern": "^pnpm trace:inspect .{1,511}$" },
    "releaseCommits": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release"],
        "properties": {
          "release": { "type": "string", "maxLength": 160 },
          "sourceCommit": { "type": "string", "maxLength": 160 },
          "unknownReason": { "type": "string", "maxLength": 32 }
        }
      }
    },
    "visibleGaps": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary", "reason"],
        "properties": {
          "kind": { "type": "string", "maxLength": 128 },
          "summary": { "type": "string", "maxLength": 256 },
          "reason": { "type": "string", "maxLength": 64 },
          "firstCursor": { "type": "integer", "minimum": 0 },
          "lastCursor": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "episodeSummary": { "type": "string", "maxLength": 512 },
    "issues": { "type": "array", "maxItems": 1000 },
    "operations": { "type": "array", "maxItems": 1000 },
    "branches": { "type": "array", "maxItems": 1000 },
    "counts": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "omissions": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 160 } }
  }
}

{
  "name": "@q9labsai/chalk-whiteboard",
  "version": "4.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Q9Labs/chalk.git",
    "directory": "packages/whiteboard"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "collab": [
        "./dist/collab/index.d.ts"
      ],
      "embedded": [
        "./dist/embedded/index.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "react-native": "./dist/react/index.js",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./collab": {
      "types": "./dist/collab/index.d.ts",
      "react-native": "./dist/collab/index.js",
      "import": "./dist/collab/index.js",
      "default": "./dist/collab/index.js"
    },
    "./embedded": {
      "types": "./dist/embedded/index.d.ts",
      "react-native": "./dist/embedded/index.js",
      "import": "./dist/embedded/index.js",
      "default": "./dist/embedded/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsup ./src/index.ts ./src/react/index.ts ./src/collab/index.ts ./src/embedded/index.ts --format esm --out-dir ./dist --platform browser --splitting --external react --external react-dom --external @excalidraw/excalidraw && pnpm run build:types && pnpm run build:renderer",
    "build:types": "rm -f tsconfig.tsbuildinfo && tsc --emitDeclarationOnly --declaration --outDir dist && node ../../scripts/rewrite-declaration-specifiers.mjs ./dist",
    "build:embedded": "pnpm run build:embedded-module && pnpm run build:renderer",
    "build:embedded-module": "tsup ./src/embedded/index.ts --format esm --out-dir ./dist/embedded --platform browser && tsc --project tsconfig.embedded.json --emitDeclarationOnly --declaration --outDir dist && node ../../scripts/rewrite-declaration-specifiers.mjs ./dist",
    "build:renderer": "node ./scripts/build-embedded.mjs",
    "dev": "tsup ./src/index.ts ./src/react/index.ts ./src/collab/index.ts ./src/embedded/index.ts --format esm --out-dir ./dist --platform browser --splitting --external react --external react-dom --external @excalidraw/excalidraw --watch",
    "test": "pnpm exec vitest run && pnpm run test:declarations",
    "test:declarations": "node --test scripts/rewrite-declaration-specifiers-proof.mjs",
    "check-types": "tsc --noEmit",
    "lint": "pnpm exec oxfmt --check . && tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@noble/hashes": "2.3.0",
    "mathjax": "4.1.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.2",
    "happy-dom": "^20.11.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}

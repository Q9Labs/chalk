# Code that each EntryLeave step mirrors. `run.sh` fails when a
# fragment is gone, so a change to these guards forces a fresh look at the model.
# Format: <action><TAB><path from repo root><TAB><fragment>. Whitespace runs in
# the file and the fragment compare as one space.
AdmitNewEntry	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats/admit.ex	if policy.status == "active" && participant && participant.status in ["joining", "active", "leaving"] do
AdmitNewEntry	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats/admit.ex	and target_participant_generation=$5 and operation_name='participant_leave' and status='pending' and attempt_count > 0 limit 1
AdmitNewEntry	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats/admit.ex	_ -> Postgrex.rollback(connection, {:retryable, :admission_pending})
AdmitNewEntry	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats/admit.ex	update participant_join_seats set issued_entry_generation=issued_entry_generation+1, issued_entry_expires_at=clock_timestamp()+interval '120 seconds'
ClaimEntry	apps/sync/lib/chalk_sync/stateholder/postgres/lifecycle.ex	if decision.result in [:applied, :already_applied], do: JoinSeats.claim_entry(connection, identity)
ClaimEntry	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats.ex	confirmed_entry_generation >= $6 or issued_entry_expires_at > clock_timestamp()
ClaimEntry	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats.ex	update participant_join_seats set confirmed_entry_generation=$6 where tenant_id=$1 and space_id=$2 and episode_id=$3 and participant_id=$4 and generation=$5 and state='joined' and confirmed_entry_generation < $6 and $6 <= issued_entry_generation
ClaimEntry	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats.ex	target_participant_id in (select participant_id from claimed) and target_participant_generation=$5 and operation_name='participant_leave' and status='pending' and coalesce((payload->>'entryGeneration')::bigint,0) < $6
ClaimEntry	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats.ex	update participants set status='active', updated_at=now() where tenant_id=$1 and space_id=$2 and episode_id=$3 and id=$4 and generation=$5 and status='leaving' and exists(select 1 from superseded)
AcceptLeave	apps/sync/lib/chalk_sync/stateholder/postgres/external_operation_planner.ex	:ok <- JoinSeats.validate_leave(connection, identity, operation),
AcceptLeave	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats.ex	and generation=$5 and confirmed_entry_generation <> $6
AcceptLeave	apps/sync/lib/chalk_sync/stateholder/postgres/external_operation_planner/prepare.ex	defp validate_leave_acceptance(_state, _target), do: {:error, :participant_inactive}
AcceptLeave	apps/sync/lib/chalk_sync/stateholder/postgres/external_operation_planner/persist.ex	case JoinSeats.prepare_leave(connection, episode, external.external_operation_id) do :ready -> ExternalOperationFinalizer.finalize_transaction( connection, episode, external.external_operation_id, {:confirmed, :local} ) :pending -> ExternalOperationDecision.build(external, :original) end
AcceptLeave	apps/sync/lib/chalk_sync/stateholder/postgres/sql/external_operation_planner.ex	set status = 'leaving', updated_at = now() where tenant_id = $1 and space_id = $2 and episode_id = $3 and id = $4 and generation = $5 and status = 'active'
Defers	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats.ex	seat.issued_entry_generation > coalesce((operation.payload->>'entryGeneration')::bigint,0) and seat.issued_entry_expires_at > clock_timestamp()
Defers	apps/sync/lib/chalk_sync/stateholder/postgres/join_seats.ex	[["pending", true]] -> :pending [["pending", _]] -> :ready _ -> :superseded
ConsumerClaim	apps/sync/lib/chalk_sync/stateholder/postgres/sql/external_operation_claims.ex	attempt_count = least(operation.attempt_count + 1, 100), next_attempt_at = now() + interval '#{@lease_seconds} seconds'
ConsumerPrepare	apps/sync/lib/chalk_sync/external_operation_consumer/dispatch.ex	case prepare_entry_leave(episode, operation) do :ready -> dispatch_provider_context(episode, operation, media_plane, recording_plane, timeout_ms) :pending -> :pending :superseded -> {:terminal_failure, :participant_inactive} end
ConsumerFinalize	apps/sync/lib/chalk_sync/stateholder/postgres/external_operation_finalizer.ex	external.status != :pending -> ExternalOperationDecision.build(external, :duplicate)
ConsumerFinalize	apps/sync/lib/chalk_sync/stateholder/postgres/sql/external_operation_finalizer.ex	and id = $4 and generation = $5 and status = 'leaving' and (not $6::boolean or not exists ( select 1 from participant_join_seats seat where seat.tenant_id=$1 and seat.space_id=$2 and seat.episode_id=$3 and seat.participant_id=$4 and seat.generation=$5 and seat.confirmed_entry_generation <> coalesce($7::bigint,0) ))

#!/usr/bin/env bash
# `bench up`: the address check, the cloud-init rendering and the creation of the fleet. It is
# sourced by `bench` after its Droplet helpers, and never run on its own.

# shellcheck disable=SC2154
# One IPv4 address becomes a /32. Anything wider is refused: control is for named sources only.
host_cidr() {
  local address="${1%/32}"
  [[ "$address" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "want one IPv4 address, got: $1"
  echo "${address}/32"
}

# render_cloud_init renders infrastructure/sfu/node/cloud-init.yaml.tftpl the way OpenTofu does, for the two
# loops it has: one rule line per address in control_addresses and ssh_addresses. The ports and the UDP buffer come from the node table.
render_cloud_init() {
  awk -v control="$1" -v ssh="$2" -v control_port="$control_port" -v media_port="$media_port" -v udp_buffer="$udp_buffer" '
    /^%\{ for address in [a-z_]+ ~\}$/ { list = ($0 ~ /control_addresses/) ? control : ssh; body = ""; looping = 1; next }
    /^%\{ endfor ~\}$/ {
      count = split(list, addresses, ",")
      for (i = 1; i <= count; i++) { line = body; gsub(/\$\{address\}/, addresses[i], line); printf "%s", line }
      looping = 0; next
    }
    { gsub(/\$\{control_port\}/, control_port); gsub(/\$\{media_port\}/, media_port); gsub(/\$\{udp_buffer\}/, udp_buffer); if (looping) body = body $0 "\n"; else print }
  ' "${node_dir}/node/cloud-init.yaml.tftpl"
}

read_ready() { sfu_curl "$dir" "$1" "$control_port" --fail --max-time 5 "https://chalk-sfu:${control_port}/readyz"; }

create_node() {
  local role="$1" slug="$2" key_id="$3" user_data="$4"
  doctl compute droplet create "${name_prefix}-${role}" --region "$region" --size "$slug" --image ubuntu-24-04-x64 \
    --ssh-keys "$key_id" --tag-name "$tag" --user-data-file "$user_data" --wait --output json >"${dir}/${role}.json"
}

abandon_up() {
  local code=$?
  trap - EXIT
  echo "bench: up failed; deleting the fleet" >&2
  down || true
  exit "$code"
}

up() {
  local command
  for command in doctl jq openssl curl ssh docker awk; do
    command -v "$command" >/dev/null || die "${command} is not installed"
  done
  doctl account get >/dev/null || die "doctl is not signed in"
  [[ -f "$SFU_SSH_KEY" ]] || die "no SSH key at ${SFU_SSH_KEY}; set SFU_SSH_KEY"
  [[ "$(tagged | fleet_of | jq length)" == 0 ]] || die "a fleet already exists; run: bench down"
  [[ "$(doctl compute firewall list --output json | jq --arg name "$firewall" '[.[] | select(.name == $name)] | length')" == 0 ]] ||
    die "firewall ${firewall} exists; run: bench down"
  local key_id
  key_id="$(doctl compute ssh-key list --output json | jq -r '.[] | select(.name == "chalk-sfu-operator") | .id')"
  [[ -n "$key_id" ]] || die "no DigitalOcean SSH key named chalk-sfu-operator"

  local operator control_addresses ssh_addresses
  operator="$(operator_cidr)"
  control_addresses="$operator"
  ssh_addresses="$operator"
  local extra
  for extra in $(tr ',' ' ' <<<"${BENCH_CONTROL_ADDRESSES:-}"); do
    control_addresses+=",$(host_cidr "$extra")"
  done
  for extra in $(tr ',' ' ' <<<"${BENCH_SSH_ADDRESSES:-}"); do
    ssh_addresses+=",$(host_cidr "$extra")"
  done

  # From here a Droplet may exist, so any failure deletes the fleet rather than leave it billing.
  trap abandon_up EXIT
  rm -rf "$dir"
  mkdir -p "$dir"
  chmod 700 "$dir"

  echo "==> issuing a throwaway CA, server and client identity"
  "${node_dir}/certs" bench ca
  "${node_dir}/certs" bench server
  "${node_dir}/certs" bench operator >/dev/null

  echo "==> creating Droplets in ${region}"
  render_cloud_init "$control_addresses" "$ssh_addresses" >"${dir}/cloud-init.yaml"
  local spec role slug pids=() failed=0 pid
  for spec in "${nodes[@]}"; do
    read -r role _ slug _ <<<"$spec"
    create_node "$role" "$slug" "$key_id" "${dir}/cloud-init.yaml" &
    pids+=($!)
  done
  for pid in "${pids[@]}"; do
    wait "$pid" || failed=1
  done
  ((failed == 0)) || die "creating a Droplet failed"

  local droplet_ids
  droplet_ids="$(jq -rs '[.[][0].id] | join(",")' "${dir}"/*.json)"
  local inbound="protocol:tcp,ports:22,address:${ssh_addresses//,/,address:} protocol:udp,ports:${media_port},address:0.0.0.0/0,address:::/0 protocol:icmp,address:0.0.0.0/0,address:::/0"
  local control_rule="protocol:tcp,ports:${control_port}"
  for extra in ${control_addresses//,/ }; do
    control_rule+=",address:${extra}"
  done
  doctl compute firewall create --name "$firewall" --droplet-ids "$droplet_ids" --inbound-rules "${inbound} ${control_rule}" \
    --outbound-rules "protocol:tcp,ports:all,address:0.0.0.0/0,address:::/0 protocol:udp,ports:all,address:0.0.0.0/0,address:::/0 protocol:icmp,address:0.0.0.0/0,address:::/0" >/dev/null

  local id budget address prefix nodes_value="" incarnations=()
  for spec in "${nodes[@]}"; do
    read -r role id slug budget <<<"$spec"
    address="$(jq -r '.[0].networks.v4[] | select(.type == "public") | .ip_address' "${dir}/${role}.json")"
    echo "==> deploying the ${role} (${slug}, packet budget ${budget})"
    SFU_PACKET_BUDGET="$budget" "${node_dir}/deploy" bench "$address" | sed "s/^/[${role}] /"
    prefix=""
    if [[ "$role" == standby ]]; then prefix="standby:"; fi
    nodes_value+="${nodes_value:+,}${prefix}${id}=https://${address}:${control_port}"
  done

  echo "==> checking /readyz over mutual TLS from this machine"
  local ready
  for spec in "${nodes[@]}"; do
    read -r role id _ budget <<<"$spec"
    address="$(jq -r '.[0].networks.v4[] | select(.type == "public") | .ip_address' "${dir}/${role}.json")"
    ready=""
    for _ in $(seq 30); do
      ready="$(read_ready "$address")" && break
      sleep 2
    done
    [[ -n "$ready" ]] || die "the ${role} did not answer /readyz"
    [[ "$(jq -r .packetBudget <<<"$ready")" == "$budget" ]] || die "the ${role} runs packet budget $(jq -r .packetBudget <<<"$ready"), want ${budget}"
    incarnations+=("$(jq -r .nodeIncarnation <<<"$ready")")
    echo "${role}: /readyz 200, incarnation ${incarnations[-1]}, packet budget ${budget}"
  done
  [[ "${incarnations[0]}" != "${incarnations[1]}" ]] || die "both nodes report one incarnation"

  jq -n --arg nodes "$nodes_value" --argjson ttl "$default_reap_hours" \
    '{created_at: (now | todate), reap_after_hours: $ttl, nodes: $nodes}' >"${dir}/fleet.json"
  trap - EXIT
  echo
  echo "up in ${SECONDS}s. Delete it today: bench down. Anything forgotten: bench reap ${default_reap_hours}"
  echo "CHALK_SFU_NODES=${nodes_value}"
  echo "CHALK_SFU_SERVER_NAME=chalk-sfu"
  echo "CHALK_SFU_CA_FILE=${dir}/ca.crt"
  echo "CHALK_SFU_CLIENT_CERT_FILE=${dir}/operator.crt (valid one day)"
  echo "CHALK_SFU_CLIENT_KEY_FILE=${dir}/operator.key"
}

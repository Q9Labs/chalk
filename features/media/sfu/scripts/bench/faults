#!/usr/bin/env bash
# Runs the SFU node-level fault cases of M11 work package 5 on a fresh bench pair and deletes the pair.
#
#   faults [--long-drain]
#
# It creates the primary and the standby with `bench up`, runs the cases below against the real SFU
# processes over mutual TLS, prints a snapshot of both nodes after each case, and ends by deleting the
# pair and listing the Droplets that wear the tag. A case that fails does not stop the run. The exit
# status is 1 if a case failed or a chalk-sfu-bench-fleet-* Droplet remains. Droplets of another run
# that also wear the tag are listed and never touched. Deletion is by the Droplet IDs this run created,
# and an EXIT trap deletes them on failure or interrupt.
#
#   1 kill the primary process: its /readyz is unreachable and the standby serves a new Episode
#   2 partition the control port from this machine, then heal it
#   3 the old primary returns with a new NodeIncarnation and holds no stale Episode
#   4 a reserve hold and a source lease expire and /readyz shows the release
#   5 the standby refuses a reserve beyond its budget and counts no reservation twice
#   6 a drain meets a short deadline and is refused a silent cut, a forced replacement completes,
#     and a drain to zero allocations restarts the node
#   7 a snapshot of in/out datagrams, CPU and steal, queues and RSS, printed after every case
#
# --long-drain adds the one-hour drain: it keeps a live Episode on the primary for
# BENCH_LONG_DRAIN_SECONDS (default 3600) while the node drains, counts the refusals of new Episodes, then
# lets the Episode go and restarts the node at zero allocations. A default run does not include it.
#
# Not covered: media packets. The cases open sessions and reserves, which need no WebRTC peer, so the
# nodes carry no RTP and the snapshot's media rates, repair and layers read zero or n/a (the SFU exports
# repair and layer counters over OTLP only). Run it from a clean checkout: `deploy` builds the commit.
set -euo pipefail

# shellcheck source=bench disable=SC2154
source "$(dirname "${BASH_SOURCE[0]}")/bench"

long_drain_seconds="${BENCH_LONG_DRAIN_SECONDS:-3600}"

tenant=bench
run="r$(date +%s)"
sfu_ssh_options "${dir}/known_hosts" -o ConnectTimeout=10
status="" body=""
results=()

address_of() { jq -r '.[0].networks.v4[] | select(.type == "public") | .ip_address' "${dir}/$1.json"; }
budget_of() { local role spec; for spec in "${nodes[@]}"; do read -r role _ _ budget <<<"$spec"; [[ "$role" != "$1" ]] || echo "$budget"; done; }
node_ssh() { local role="$1"; shift; ssh "${ssh_options[@]}" "root@$(address_of "$role")" "$@"; }
unit() { node_ssh "$1" systemctl --user -M chalk-sfu@ "${@:2}" chalk-sfu; }

# sfu sends one control request over mutual TLS and sets $status (000 when nothing answered) and $body.
sfu() {
  local role="$1" method="$2" path="$3" data="${4-}" out extra=()
  [[ -z "$data" ]] || extra=(--header 'Content-Type: application/json' --data "$data")
  out="$(mktemp)"
  status="$(curl --silent --connect-timeout 4 --max-time 8 --output "$out" --write-out '%{http_code}' \
    --cacert "${dir}/ca.crt" --cert "${dir}/operator.crt" --key "${dir}/operator.key" \
    --resolve "chalk-sfu:${control_port}:$(address_of "$role")" --request "$method" "${extra[@]}" \
    "https://chalk-sfu:${control_port}${path}")" || status=000
  body="$(cat "$out")"
  rm -f "$out"
}

ready() { sfu "$1" GET /readyz; }
ready_value() { ready "$1"; jq -r "$2" <<<"$body"; }
wait_until() { # seconds, then a command
  local seconds="$1"
  shift
  for _ in $(seq "$seconds"); do
    "$@" && return 0
    sleep 1
  done
  return 1
}

reserve_body() { # operation episode generation participants cameras ttl
  jq -nc --arg op "$1" --arg tenant "$tenant" --arg ep "$2" --argjson gen "$3" --argjson p "$4" --argjson c "$5" --argjson ttl "$6" \
    '{operationId: $op, tenantId: $tenant, episodeId: $ep, generation: $gen, shape: {participants: $p, camerasPerParticipant: $c}, ttlSeconds: $ttl}'
}
scope_json() { # episode participant generation
  jq -nc --arg tenant "$tenant" --arg ep "$1" --arg p "$2" --argjson gen "$3" '{tenantId: $tenant, episodeId: $ep, participantId: $p, generation: $gen}'
}
join_body() { jq -nc --arg op "$1" --argjson scope "$(scope_json "$2" "$3" "$4")" '{operationId: $op, scope: $scope}'; }
end_episode() { sfu "$1" POST /v1/episodes/end "$(jq -nc --arg tenant "$tenant" --arg ep "$2" '{tenantId: $tenant, episodeId: $ep}')"; }
is_down() { ready "$1"; [[ "$status" == 000 ]]; }
is_up() { ready "$1"; [[ "$status" == 200 ]]; }
holds() { [[ "$(ready_value "$1" '[.allocations, .reservedPackets] | @tsv')" == "$2" ]]; }
leases() { [[ "$(ready_value "$1" .sourceLeases)" == "$2" ]]; }
# ready_is holds when /readyz of the node satisfies the jq expression, whatever its HTTP status.
ready_is() { ready "$1"; jq -e "$2" <<<"$body"; }

# redeploy runs the production deploy for one bench node, with its packet budget.
redeploy() { SFU_PACKET_BUDGET="$(budget_of "$1")" "${node_dir}/deploy" bench "$(address_of "$1")" "${@:2}"; }

# snapshot prints one line per node: the SFU's own counters from /readyz and the host's from /proc.
snapshot() {
  local role cpu
  for spec in "${nodes[@]}"; do
    read -r role _ _ _ <<<"$spec"
    ready "$role"
    if [[ "$status" == 000 ]]; then
      echo "  snapshot ${role}: unreachable"
      continue
    fi
    cpu="$(node_ssh "$role" 'head -n1 /proc/stat; sleep 1; head -n1 /proc/stat; awk "/^Udp:/{n++} n==2{print \$2, \$5}" /proc/net/snmp' 2>/dev/null |
      awk 'NR==1{for(i=2;i<=9;i++)a[i]=$i} NR==2{for(i=2;i<=9;i++){d[i]=$i-a[i];t+=d[i]}; idle=d[5]+d[6]; printf "cpu=%.0f%% steal=%.0f%% ", (t-idle)*100/t, d[9]*100/t} NR==3{printf "udp_in=%s udp_out=%s", $1, $2}')" || cpu="host=unavailable"
    echo "  snapshot ${role}: $(jq -r '"sessions=\(.sessions) allocations=\(.allocations) reserved=\(.reservedPackets)/\(.packetBudget) pps=\(.host.packetsPerSecond) rss_mib=\((.host.rssBytes // 0) / 1048576 | floor) goroutines=\(.host.goroutines) queue_p95_ms=\(.host.queueDelayP95Ms) guard_steal=\(.host.stealPercent // "n/a")"' <<<"$body") ${cpu} repair/layers=otlp-only"
  done
}

case_failed=0 case_no="" case_title="" case_evidence=""
begin_case() {
  case_no="$1" case_title="$2" case_failed=0 case_evidence=""
  echo
  echo "=== case ${case_no}: ${case_title}"
}
check() { # description, then a command that succeeds when the claim holds
  local description="$1"
  shift
  if "$@" >/dev/null 2>&1; then echo "  ok   ${description}"; else echo "  FAIL ${description}"; case_failed=1; fi
}
evidence() { case_evidence+="${case_evidence:+; }$*"; echo "  note $*"; }
end_case() {
  snapshot
  results+=("${case_no}|${case_title}|$([[ "$case_failed" == 0 ]] && echo PASS || echo FAIL)|${case_evidence}")
}

kill_primary_and_return() {
  local episode="kill-${run}" fresh="fresh-${run}" standby_incarnation old_incarnation old_connection
  begin_case 1 "kill the primary; the standby serves a new Episode"
  standby_incarnation="$(ready_value standby .nodeIncarnation)"
  sfu primary POST /v1/sessions "$(join_body "op-${run}-1" "$episode" p1 1)"
  check "primary accepts a join of Episode ${episode} (HTTP ${status})" [ "$status" = 200 ]
  old_connection="$(jq -r .connectionId <<<"$body")" old_incarnation="$(jq -r .nodeIncarnation <<<"$body")"
  snapshot
  # SIGKILL to the SFU process itself, then stop the unit before systemd restarts it after 2 s.
  check "SIGKILL reaches the SFU process and the unit stops" node_ssh primary "pkill -9 -x chalk-sfu && systemctl --user -M chalk-sfu@ stop chalk-sfu"
  check "primary /readyz is unreachable" wait_until 30 is_down primary
  evidence "primary /readyz status ${status} after SIGKILL"
  sfu standby POST /v1/episodes/reserve "$(reserve_body "res-${run}-1" "$fresh" 1 3 2 60)"
  check "standby reserves a new Episode (HTTP ${status})" [ "$status" = 200 ]
  check "the reserve names the standby's incarnation" [ "$(jq -r .nodeIncarnation <<<"$body")" = "$standby_incarnation" ]
  sfu standby POST /v1/sessions "$(join_body "op-${run}-2" "$fresh" p1 1)"
  check "standby accepts the join (HTTP ${status})" [ "$status" = 200 ]
  evidence "standby served ${fresh} under incarnation $(jq -r .nodeIncarnation <<<"$body" | cut -c1-8)"
  check "standby holds the new Episode and not the old one" [ "$(ready_value standby '.sessions')" = 1 ]
  sfu standby POST "/v1/sessions/${old_connection}/inspect" "$(jq -nc --argjson scope "$(scope_json "$episode" p1 1)" '{scope: $scope}')"
  check "the old session reads as gone on the standby (HTTP ${status})" [ "$status" = 404 ]
  end_episode standby "$fresh"
  end_case

  begin_case 3 "the old primary returns with a new incarnation and no stale Episode"
  check "the primary unit starts again" unit primary start
  check "primary /readyz answers again" wait_until 60 is_up primary
  ready primary
  check "new NodeIncarnation (was $(cut -c1-8 <<<"$old_incarnation"), now $(jq -r .nodeIncarnation <<<"$body" | cut -c1-8))" \
    [ "$(jq -r .nodeIncarnation <<<"$body")" != "$old_incarnation" ]
  check "no session, allocation or reserved packet is left" [ "$(jq -r '[.sessions, .allocations, .reservedPackets] | @tsv' <<<"$body")" = $'0\t0\t0' ]
  sfu primary POST "/v1/sessions/${old_connection}/inspect" "$(jq -nc --argjson scope "$(scope_json "$episode" p1 1)" '{scope: $scope}')"
  check "the pre-kill session reads as gone (HTTP ${status})" [ "$status" = 404 ]
  end_case
}

partition_and_heal() {
  local episode="part-${run}" incarnation runner
  begin_case 2 "partition the control port from this machine, then heal it"
  runner="$(operator_cidr)"
  runner="${runner%/32}"
  incarnation="$(ready_value primary .nodeIncarnation)"
  sfu primary POST /v1/episodes/reserve "$(reserve_body "res-${run}-2" "$episode" 1 2 1 120)"
  check "a 120 s hold exists on the primary (HTTP ${status})" [ "$status" = 200 ]
  # iptables, not ufw: ufw skips a deny that has the same match as the allow rule it would precede.
  check "the DROP rule is installed on the primary" node_ssh primary "iptables -I INPUT 1 -s ${runner} -p tcp --dport ${control_port} -j DROP"
  check "primary /readyz is unreachable from this machine" wait_until 20 is_down primary
  evidence "control port blocked, /readyz status ${status}"
  check "SSH to the primary still works" node_ssh primary true
  check "the standby still answers" is_up standby
  check "the SFU process keeps running on the primary" node_ssh primary systemctl --user -M chalk-sfu@ is-active --quiet chalk-sfu
  check "the DROP rule is removed" node_ssh primary "iptables -D INPUT -s ${runner} -p tcp --dport ${control_port} -j DROP"
  check "primary /readyz answers after the heal" wait_until 20 is_up primary
  check "same incarnation after the heal" ready_is primary ".nodeIncarnation == \"${incarnation}\""
  check "the hold survived the partition" ready_is primary ".allocations == 1"
  end_episode primary "$episode"
  end_case
}

expiry() {
  local role=primary base added reserved lease
  begin_case 4 "reserve hold and source lease expiry release capacity in /readyz"
  base="$(ready_value $role '[.allocations, .reservedPackets] | @tsv')"
  sfu $role POST /v1/episodes/reserve "$(reserve_body "res-${run}-3" "exp-${run}" 1 2 1 3)"
  check "the reserve answers (HTTP ${status})" [ "$status" = 200 ]
  reserved="$(jq -r .reservedPackets <<<"$body")"
  added="$(ready_value $role '[.allocations, .reservedPackets] | @tsv')"
  check "/readyz counts the hold: ${base//$'\t'/ } -> ${added//$'\t'/ } (reserved ${reserved})" [ "$added" != "$base" ]
  check "the hold expires after its 3 s TTL and /readyz returns to ${base//$'\t'/ }" wait_until 15 holds $role "$base"
  evidence "hold: allocations and reserved ${base//$'\t'/ } -> ${added//$'\t'/ } -> ${base//$'\t'/ } after 3 s"
  sfu $role POST /v1/episodes/sources "$(jq -nc --arg tenant "$tenant" --arg ep "lease-${run}" '{tenantId: $tenant, episodeId: $ep, controls: [{participantId: "p1", source: "camera", action: "grant", revision: 1}]}')"
  check "a source grant answers (HTTP ${status})" [ "$status" = 200 ]
  lease="$(jq -r '.results[0].leaseMillis' <<<"$body")"
  check "/readyz counts the open lease (lease ${lease} ms)" leases $role 1
  check "the lease expires and sourceLeases returns to 0" wait_until 40 leases $role 0
  evidence "a lease holds no packet budget: reserved stays $(ready_value $role .reservedPackets)"
  end_case
}

standby_saturation() {
  local role=standby budget reserved fit accepted=0 index first_expiry refusal_status refusal_code refusal_message
  begin_case 5 "standby saturation: reserves past the budget are refused, none counted twice"
  budget="$(budget_of $role)"
  sfu $role POST /v1/episodes/reserve "$(reserve_body "res-${run}-s1" "sat-${run}-1" 1 3 2 120)"
  check "the first three-person, two-camera Episode is reserved (HTTP ${status})" [ "$status" = 200 ]
  reserved="$(jq -r .reservedPackets <<<"$body")" first_expiry="$(jq -r .expiresAt <<<"$body")"
  fit=$((budget / reserved))
  accepted=1
  for index in $(seq 2 $((fit + 1))); do
    sfu $role POST /v1/episodes/reserve "$(reserve_body "res-${run}-s${index}" "sat-${run}-${index}" 1 3 2 120)"
    [[ "$status" != 200 ]] || accepted=$((accepted + 1))
  done
  refusal_status="$status" refusal_code="$(jq -r .error.code <<<"$body")" refusal_message="$(jq -r .error.message <<<"$body")"
  evidence "budget ${budget}, ${reserved} packets/s per Episode, ${accepted} accepted of $((fit + 1)) asked (last HTTP ${refusal_status} ${refusal_code})"
  check "exactly ${fit} Episodes fit and the next one is refused with capacity_exceeded (HTTP ${refusal_status})" \
    test "$accepted" -eq "$fit" -a "$refusal_status" = 429 -a "$refusal_code" = capacity_exceeded
  check "the refusal names the node budget: ${refusal_message}" grep -q 'packet budget is reserved' <<<"$refusal_message"
  check "/readyz reserves exactly $((fit * reserved)) packets/s, none for the refused Episode" [ "$(ready_value $role .reservedPackets)" = $((fit * reserved)) ]
  sfu $role POST /v1/episodes/reserve "$(reserve_body "res-${run}-s1" "sat-${run}-1" 1 3 2 120)"
  check "a replay of the first reserve returns the first answer" test "$status" = 200 -a "$(jq -r .expiresAt <<<"$body")" = "$first_expiry"
  sfu $role POST /v1/episodes/reserve "$(reserve_body "res-${run}-s1b" "sat-${run}-1" 2 3 2 120)"
  check "a newer reserve of the same Episode replaces its hold (HTTP ${status})" [ "$status" = 200 ]
  sfu $role POST /v1/sessions "$(join_body "op-${run}-s1" "sat-${run}-1" p1 2)"
  check "a join into a held Episode replaces its hold (HTTP ${status})" [ "$status" = 200 ]
  check "no reservation is counted twice: reserved is still $((fit * reserved))" [ "$(ready_value $role .reservedPackets)" = $((fit * reserved)) ]
  for index in $(seq "$((fit + 1))"); do end_episode $role "sat-${run}-${index}"; done
  check "ending the Episodes returns the node to zero" wait_until 10 holds $role $'0\t0'
  end_case
}

# keep_live starts a background renewer that joins the Episode's Participant again every 20 s, so the
# node holds an allocation until stop_live, whatever time the deploy spends preparing. A draining node
# keeps taking joins of an Episode it hosts. With "probe" it also asks for a new Episode each round
# and logs the answer. It stops by itself after the optional number of seconds.
live_log="" live_pid=""
keep_live() { # episode generation [probe] [seconds]
  local episode="$1" generation="$2" probe="${3:-}" end=$((SECONDS + ${4:-86400}))
  live_log="$(mktemp)"
  (
    while ((SECONDS < end)); do
      sleep 20
      ((SECONDS < end)) || break
      generation=$((generation + 1))
      sfu primary POST /v1/sessions "$(join_body "op-${run}-${episode}-${generation}" "$episode" p1 "$generation")"
      echo "join ${status}" >>"$live_log"
      [[ -z "$probe" ]] && continue
      sfu primary POST /v1/episodes/reserve "$(reserve_body "res-${run}-${episode}-${generation}" "new-${episode}-${generation}" 1 2 1 5)"
      echo "new ${status} $(jq -r '.error.code // "ok"' <<<"$body")" >>"$live_log"
    done
  ) &
  live_pid=$!
}
stop_live() {
  [[ -z "$live_pid" ]] || { kill "$live_pid" 2>/dev/null; wait "$live_pid" 2>/dev/null; }
  live_pid=""
  return 0
}
live_count() { grep -c "$1" "$live_log" || true; }

drain_and_restart() {
  local episode="drain-${run}" incarnation output rc code deploy_pid
  begin_case 6 "a drain meets a short deadline; a forced replacement and a drain to zero both complete"
  incarnation="$(ready_value primary .nodeIncarnation)"
  sfu primary POST /v1/sessions "$(join_body "op-${run}-d0" "$episode" p1 1)"
  check "the primary hosts Episode ${episode} (HTTP ${status})" test "$status" = 200
  sfu primary POST /v1/drain
  check "the drain request answers 200 (HTTP ${status})" test "$status" = 200
  ready primary
  check "/readyz is 503 and draining with the allocation still held (HTTP ${status}, allocations $(jq -r .allocations <<<"$body"))" \
    test "$status" = 503 -a "$(jq -r '.draining and .allocations >= 1' <<<"$body")" = true
  sfu primary POST /v1/episodes/reserve "$(reserve_body "res-${run}-d2" "drain-new-${run}" 1 2 1 30)"
  code="$(jq -r .error.code <<<"$body")"
  check "a new Episode is refused as draining (HTTP ${status} ${code})" test "$status" = 503 -a "$code" = draining
  keep_live "$episode" 1
  output="$(SFU_DRAIN_TIMEOUT=10 redeploy primary 2>&1)" && rc=0 || rc=$?
  stop_live
  grep -E 'remain after|did not become ready|draining:' <<<"$output" | sed 's/^/    deploy: /' || true
  check "deploy with a 10 s deadline refuses to cut the call and exits non-zero (exit ${rc})" test "$rc" != 0
  check "the node was reopened, not restarted" ready_is primary ".draining == false and .nodeIncarnation == \"${incarnation}\""
  check "the held allocation was untouched" ready_is primary ".allocations >= 1"
  evidence "deadline 10 s: replacement refused, call kept"
  output="$(redeploy primary --force 2>&1)" && rc=0 || rc=$?
  grep -E 'restarting without|ready:' <<<"$output" | sed 's/^/    deploy: /' || true
  check "the forced replacement completes (exit ${rc})" test "$rc" = 0
  check "new incarnation, no allocation, not draining" ready_is primary ".nodeIncarnation != \"${incarnation}\" and .allocations == 0 and .draining == false"
  evidence "forced replacement is disruptive: it cut the live Episode"

  # The renewer keeps the allocation until the deploy is seen waiting on it, then lets it go.
  incarnation="$(ready_value primary .nodeIncarnation)"
  episode="zero-${run}"
  sfu primary POST /v1/sessions "$(join_body "op-${run}-z0" "$episode" p1 1)"
  check "a live Episode keeps an allocation (HTTP ${status})" test "$status" = 200
  keep_live "$episode" 1
  output="$(mktemp)"
  SFU_DRAIN_TIMEOUT=300 redeploy primary >"$output" 2>&1 &
  deploy_pid=$!
  for _ in $(seq 600); do
    grep -q 'draining: allocations [1-9]' "$output" && break
    kill -0 "$deploy_pid" 2>/dev/null || break
    sleep 1
  done
  stop_live
  wait "$deploy_pid" && rc=0 || rc=$?
  grep -E 'draining:|ready:' "$output" | sed 's/^/    deploy: /' || true
  check "the drain to zero restarts the node (exit ${rc})" test "$rc" = 0
  check "the drain waited for the allocation" grep -q 'draining: allocations [1-9]' "$output"
  check "new incarnation and zero allocations" ready_is primary ".nodeIncarnation != \"${incarnation}\" and .allocations == 0"
  rm -f "$output"
  end_case
}

# long_drain_case keeps a live Episode on the primary through the drain, the way a call would.
long_drain_case() {
  local episode="long-${run}" incarnation output rc refused asked joins accepted_joins
  begin_case 6L "drain for ${long_drain_seconds} s: the live Episode runs, new Episodes are refused, restart at zero"
  incarnation="$(ready_value primary .nodeIncarnation)"
  sfu primary POST /v1/sessions "$(join_body "op-${run}-L0" "$episode" p1 1)"
  check "the primary hosts Episode ${episode} (HTTP ${status})" test "$status" = 200
  sfu primary POST /v1/drain
  check "the drain request answers 200 (HTTP ${status})" test "$status" = 200
  keep_live "$episode" 1 probe "$long_drain_seconds"
  output="$(SFU_DRAIN_TIMEOUT=$((long_drain_seconds + 300)) redeploy primary 2>&1)" && rc=0 || rc=$?
  stop_live
  grep -E 'draining:|ready:' <<<"$output" | sed 's/^/    deploy: /' || true
  refused="$(live_count '^new 503 draining')" asked="$(live_count '^new')"
  joins="$(live_count '^join')" accepted_joins="$(live_count '^join 200')"
  check "the restart completed after the Episode ended (exit ${rc})" test "$rc" = 0
  check "every join of the live Episode was accepted (${accepted_joins} of ${joins})" test "$joins" -ge 1 -a "$accepted_joins" = "$joins"
  check "new Episodes were refused while draining (${refused} of ${asked})" test "$refused" -ge 1 -a "$refused" = "$asked"
  check "new incarnation and zero allocations" ready_is primary ".nodeIncarnation != \"${incarnation}\" and .allocations == 0"
  evidence "drain held ${long_drain_seconds} s of live Episode, ${refused} refusals"
  rm -f "$live_log"
  end_case
}

fleet_droplets() { tagged | fleet_of; }

print_results() {
  ((${#results[@]} > 0)) || return 0
  echo
  echo "==> results"
  printf '%s\n' "case|title|result|evidence" "${results[@]}" | column -t -s '|'
}

# finish prints the results, deletes this run's Droplets by ID, then the firewall and certificates,
# and lists what is left. It runs on any exit, so a run that stops early still reports and cleans up.
finish() {
  local code=$? ids pending=0 remaining foreign hours cost failed=0
  trap - EXIT INT TERM
  set +e
  print_results
  if ((${#results[@]} > 0)); then
    failed="$(printf '%s\n' "${results[@]}" | grep -c '|FAIL|')"
    echo "${failed} case(s) failed"
    ((failed == 0)) || code=1
  fi
  echo
  echo "==> deleting the Droplets this run created"
  ids="$(jq -s '[.[][0].id]' "${dir}"/primary.json "${dir}"/standby.json 2>/dev/null || echo '[]')"
  cost="$(fleet_droplets | jq -r --argjson ids "$ids" '[.[] | select(.id as $id | $ids | index($id)) | (now - (.created_at | fromdateiso8601)) / 3600 * .size.price_hourly] | add // 0 | . * 10000 | round / 10000')"
  hours="$(fleet_droplets | jq -r '[.[] | (now - (.created_at | fromdateiso8601)) / 3600] | max // 0 | . * 100 | round / 100')"
  tagged | jq --argjson ids "$ids" '[.[] | select(.id as $id | $ids | index($id))]' | delete_droplets || pending=1
  if [[ "$pending" == 0 ]]; then
    delete_firewall || { echo "FAILED: the firewall ${firewall} is still there; run: bench down" >&2; pending=1; }
  fi
  echo "==> doctl compute droplet list --tag-name ${tag}"
  doctl compute droplet list --tag-name "$tag" --format ID,Name,Region,Memory,VCPUs,Status
  remaining="$(fleet_droplets | jq length)"
  foreign="$(tagged | jq --arg prefix "$name_prefix" '[.[] | select(.name | startswith($prefix) | not)] | length')"
  echo "run cost: about \$${cost} (fleet alive ${hours} h at list hourly prices; bandwidth and the billing minimum are not included)"
  echo "${foreign} Droplet(s) of other runs wear the tag; this run left them alone"
  if [[ "$remaining" != 0 ]]; then
    echo "FAILED: ${remaining} ${name_prefix}-* Droplet(s) remain" >&2
    code=1
  elif [[ "$pending" == 1 ]]; then
    code=1
  else
    rm -rf "$dir"
    echo "no ${name_prefix}-* Droplet remains"
  fi
  exit "$code"
}

main() {
  local long_drain=false
  case "${1:-}" in
    "") ;;
    --long-drain) long_drain=true ;;
    *) echo "usage: faults [--long-drain]" >&2; exit 2 ;;
  esac
  echo "==> Droplets tagged ${tag} before the run"
  doctl compute droplet list --tag-name "$tag" --format ID,Name,Region,Memory,VCPUs,Status

  up
  trap finish EXIT
  trap 'exit 130' INT TERM
  # From here a failed setup step must not skip the cases after it: a check records the failure.
  set +e

  echo
  echo "==> baseline"
  snapshot

  kill_primary_and_return
  partition_and_heal
  expiry
  standby_saturation
  drain_and_restart
  [[ "$long_drain" == false ]] || long_drain_case
}

[[ "${BASH_SOURCE[0]}" != "$0" ]] || main "$@"

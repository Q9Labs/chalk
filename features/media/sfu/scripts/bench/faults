#!/usr/bin/env bash
# Runs the SFU node-level fault cases of M11 work package 5 on a fresh bench pair and deletes the pair.
#
#   faults [--long-drain]
#
# It creates the primary and the standby with `bench up`, runs the cases below against the real SFU
# processes over mutual TLS, prints a snapshot of both nodes after each case, and ends by deleting the
# pair and listing the Droplets that wear the tag. A case that fails does not stop the run. The exit
# status is 1 if a case failed or a chalk-sfu-bench-fleet-* Droplet remains. Droplets of another run
# that also wear the tag are listed and never touched. Deletion is by the Droplet IDs this run created,
# and an EXIT trap deletes them on failure or interrupt.
#
#   1 kill the primary process: its /readyz is unreachable and the standby serves a new Episode
#   2 partition the control port from this machine, then heal it
#   3 the old primary returns with a new NodeIncarnation and holds no stale Episode
#   4 a reserve hold and a source lease expire and /readyz shows the release
#   5 the standby refuses a reserve beyond its budget and counts no reservation twice
#   6 a drain meets a short deadline and is refused a silent cut, a forced replacement completes,
#     and a drain to zero allocations restarts the node
#   7 a snapshot of in/out datagrams, CPU and steal, queues and RSS, printed after every case
#
# --long-drain adds the one-hour drain: it keeps a live Episode on the primary for
# BENCH_LONG_DRAIN_SECONDS (default 3600) while the node drains, counts the refusals of new Episodes, then
# lets the Episode go and restarts the node at zero allocations. A default run does not include it.
#
# Not covered: media packets. The cases open sessions and reserves, which need no WebRTC peer, so the
# nodes carry no RTP and the snapshot's media rates, repair and layers read zero or n/a (the SFU exports
# repair and layer counters over OTLP only). Run it from a clean checkout: `deploy` builds the commit.
set -euo pipefail

# shellcheck source=bench disable=SC2154
source "$(dirname "${BASH_SOURCE[0]}")/bench"
# shellcheck source=faults-support
source "$(dirname "${BASH_SOURCE[0]}")/faults-support"
# shellcheck source=faults-cases
source "$(dirname "${BASH_SOURCE[0]}")/faults-cases"

fleet_droplets() { tagged | fleet_of; }

print_results() {
  ((${#results[@]} > 0)) || return 0
  echo
  echo "==> results"
  printf '%s\n' "case|title|result|evidence" "${results[@]}" | column -t -s '|'
}

# finish prints the results, deletes this run's Droplets by ID, then the firewall and certificates,
# and lists what is left. It runs on any exit, so a run that stops early still reports and cleans up.
finish() {
  local code=$? ids pending=0 remaining foreign hours cost failed=0
  trap - EXIT INT TERM
  set +e
  print_results
  if ((${#results[@]} > 0)); then
    failed="$(printf '%s\n' "${results[@]}" | grep -c '|FAIL|')"
    echo "${failed} case(s) failed"
    ((failed == 0)) || code=1
  fi
  echo
  echo "==> deleting the Droplets this run created"
  ids="$(jq -s '[.[][0].id]' "${dir}"/primary.json "${dir}"/standby.json 2>/dev/null || echo '[]')"
  cost="$(fleet_droplets | jq -r --argjson ids "$ids" '[.[] | select(.id as $id | $ids | index($id)) | (now - (.created_at | fromdateiso8601)) / 3600 * .size.price_hourly] | add // 0 | . * 10000 | round / 10000')"
  hours="$(fleet_droplets | jq -r '[.[] | (now - (.created_at | fromdateiso8601)) / 3600] | max // 0 | . * 100 | round / 100')"
  tagged | jq --argjson ids "$ids" '[.[] | select(.id as $id | $ids | index($id))]' | delete_droplets || pending=1
  if [[ "$pending" == 0 ]]; then
    delete_firewall || { echo "FAILED: the firewall ${firewall} is still there; run: bench down" >&2; pending=1; }
  fi
  echo "==> doctl compute droplet list --tag-name ${tag}"
  doctl compute droplet list --tag-name "$tag" --format ID,Name,Region,Memory,VCPUs,Status
  remaining="$(fleet_droplets | jq length)"
  foreign="$(tagged | jq --arg prefix "$name_prefix" '[.[] | select(.name | startswith($prefix) | not)] | length')"
  echo "run cost: about \$${cost} (fleet alive ${hours} h at list hourly prices; bandwidth and the billing minimum are not included)"
  echo "${foreign} Droplet(s) of other runs wear the tag; this run left them alone"
  if [[ "$remaining" != 0 ]]; then
    echo "FAILED: ${remaining} ${name_prefix}-* Droplet(s) remain" >&2
    code=1
  elif [[ "$pending" == 1 ]]; then
    code=1
  else
    rm -rf "$dir"
    echo "no ${name_prefix}-* Droplet remains"
  fi
  exit "$code"
}

main() {
  local long_drain=false
  case "${1:-}" in
    "") ;;
    --long-drain) long_drain=true ;;
    *) echo "usage: faults [--long-drain]" >&2; exit 2 ;;
  esac
  echo "==> Droplets tagged ${tag} before the run"
  doctl compute droplet list --tag-name "$tag" --format ID,Name,Region,Memory,VCPUs,Status

  up
  trap finish EXIT
  trap 'exit 130' INT TERM
  # From here a failed setup step must not skip the cases after it: a check records the failure.
  set +e

  echo
  echo "==> baseline"
  snapshot

  kill_primary_and_return
  partition_and_heal
  expiry
  standby_saturation
  drain_and_restart
  [[ "$long_drain" == false ]] || long_drain_case
}

[[ "${BASH_SOURCE[0]}" != "$0" ]] || main "$@"

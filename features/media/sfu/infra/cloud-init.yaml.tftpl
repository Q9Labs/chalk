#cloud-config
# Prepares an own-SFU node: rootless Podman for the chalk-sfu user, an 8 MiB
# UDP receive and send buffer and a host firewall that matches the cloud firewall. It
# carries no secrets; `deploy` installs the image, certificates and settings.
package_update: true
packages:
  - podman
  - ufw
write_files:
  - path: /etc/sysctl.d/90-chalk-sfu.conf
    content: |
      # A burst of video from many publishers overflows the default ~208 KiB.
      net.core.rmem_max = 8388608
      net.core.rmem_default = 8388608
      # The pacers send in bursts; a full send buffer drops outgoing media.
      net.core.wmem_max = 8388608
      net.core.wmem_default = 8388608
  - path: /etc/ssh/sshd_config.d/90-chalk-sfu.conf
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
runcmd:
  - sysctl --system
  - systemctl reload ssh
  - useradd --create-home --shell /usr/sbin/nologin chalk-sfu
  - loginctl enable-linger chalk-sfu
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow ${media_port}/udp
%{ for address in control_addresses ~}
  - ufw allow proto tcp from ${address} to any port 8443
%{ endfor ~}
%{ for address in ssh_addresses ~}
  - ufw allow proto tcp from ${address} to any port 22
%{ endfor ~}
  - ufw --force enable
  - touch /var/lib/chalk-sfu-bootstrapped

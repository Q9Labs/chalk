# syntax=docker/dockerfile:1.7
# The capture worker that runs beside the SFU. Build with named contexts, because the API module
# lives outside features/media/sfu:
#   docker buildx build --file Dockerfile.capture \
#     --build-context api=apps/api features/media/sfu/deploy

ARG GO_IMAGE=golang:1.26.10-bookworm@sha256:ee3901c61e423732605a51f1b8157c849ec01194ea0a274213b5202b2c11e7bf

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETARCH
ARG TARGETOS
WORKDIR /src/apps/api
COPY --from=api go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY --from=api . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOARCH=$TARGETARCH GOOS=$TARGETOS \
    go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/recorder-capture ./cmd/recorder-capture

FROM scratch
ARG SOURCE_REVISION
LABEL org.opencontainers.image.description="Chalk recording capture worker beside an SFU node" \
      org.opencontainers.image.revision=$SOURCE_REVISION \
      org.opencontainers.image.source="https://github.com/q9labs/chalk" \
      org.opencontainers.image.title="chalk-recorder-capture"

# Root CAs, so the worker verifies the R2 endpoint it uploads bundles to.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/recorder-capture /usr/local/bin/recorder-capture

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/recorder-capture", "--run"]

# Rendered by deploy. Settings only; certificates and the metrics token arrive as Podman secrets.
SFU_CONTROL_ADDR=:8443
SFU_UDP_ADDR=:50000
SFU_ANNOUNCE_IPS=__ANNOUNCE_IP__
SFU_TLS_CERT_FILE=/run/chalk-sfu/server.crt
SFU_TLS_KEY_FILE=/run/chalk-sfu/server.key
SFU_CLIENT_CA_FILE=/run/chalk-sfu/client-ca.crt
SFU_CLIENT_IDENTITY=__CLIENT_IDENTITY__
SFU_UDP_RECEIVE_BUFFER=8388608
SFU_UDP_SEND_BUFFER=8388608
SFU_PACKET_BUDGET=__PACKET_BUDGET__
# The design's memory budget: 384 MiB on the 1 GiB node, 768 MiB on 2 GiB.
GOMEMLIMIT=__GOMEMLIMIT__
# A shared vCPU showed 10-21% steal with two live classes while the pacer queue
# p95 stayed at 2 ms, so 3% closed admission long before media suffered.
# Scheduler latency stays the direct guard; steal only catches a host that is far worse.
SFU_GUARD_MAX_STEAL_PERCENT=__STEAL_LIMIT__
# Metrics go over OTLP/HTTP, the API's pipeline. An empty endpoint turns export off. The
# exporter reads the token and dataset from OTEL_EXPORTER_OTLP_METRICS_HEADERS, a Podman secret.
SFU_ENVIRONMENT=__ENVIRONMENT__
SFU_VERSION=__REVISION__
SFU_OTLP_ENDPOINT=__OTLP_ENDPOINT__
SFU_OTLP_INTERVAL=10s

[Unit]
Description=Chalk SFU media node
After=network-online.target
Wants=network-online.target

[Container]
Image=__IMAGE__
Pull=never
ContainerName=chalk-sfu
# Host networking: media is one UDP socket, and a user-mode network stack would
# cost a copy per packet and hide the 8 MiB receive buffer.
Network=host
EnvironmentFile=%h/.config/chalk-sfu/sfu.env
Secret=chalk-sfu-server-cert,type=mount,target=/run/chalk-sfu/server.crt,uid=65532,gid=65532,mode=0400
Secret=chalk-sfu-server-key,type=mount,target=/run/chalk-sfu/server.key,uid=65532,gid=65532,mode=0400
Secret=chalk-sfu-client-ca,type=mount,target=/run/chalk-sfu/client-ca.crt,uid=65532,gid=65532,mode=0400
__OTLP_HEADERS_SECRET__
User=65532
Group=65532
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
PidsLimit=256
PodmanArgs=--memory=__MEMORY_LIMIT__
LogDriver=journald
PodmanArgs=--log-opt=tag=chalk-sfu
PodmanArgs=--stop-signal=SIGTERM
PodmanArgs=--stop-timeout=20

[Service]
Restart=on-failure
RestartSec=2s
StartLimitIntervalSec=60
StartLimitBurst=5
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=default.target

{
  "area": "board",
  "slice": 6,
  "title": "Whiteboard",
  "prefixes": ["board"],
  "fields": [
    {
      "name": "board_step",
      "type": "enum",
      "sensitivity": null,
      "doc": "Whiteboard boundary and outcome.",
      "values": ["store_saved", "store_failed", "sent", "committed", "duplicate", "refused", "denied", "allowed", "blocked", "update", "gap", "snapshot", "independent", "manual", "automatic"]
    },
    {
      "name": "board_scene_id",
      "type": "string",
      "sensitivity": null,
      "doc": "Opaque ID of the durable board scene."
    },
    {
      "name": "board_revision",
      "type": "string",
      "sensitivity": null,
      "doc": "Exact decimal revision within a board scene."
    },
    {
      "name": "board_previous_revision",
      "type": "string",
      "sensitivity": null,
      "doc": "Exact revision of the same-scene baseline before receiving an update."
    },
    {
      "name": "board_correlation_id",
      "type": "string",
      "sensitivity": null,
      "doc": "Whiteboard wire operation or snapshot request UUID."
    },
    {
      "name": "board_element_count",
      "type": "int",
      "sensitivity": null,
      "doc": "Number of elements in an assembled board snapshot."
    },
    {
      "name": "board_follow_target",
      "type": "string",
      "sensitivity": null,
      "doc": "Participant ID whose board view is followed."
    },
    {
      "name": "board_failure",
      "type": "enum",
      "sensitivity": null,
      "doc": "Bounded reason for a failed whiteboard edit.",
      "values": ["local_store", "permission_denied", "storage_unavailable", "unavailable", "invalid_payload", "stale_scene", "cursor_reset_required", "rate_limited", "overloaded", "other"]
    }
  ],
  "events": [

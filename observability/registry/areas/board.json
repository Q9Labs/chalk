  "symptoms": [
    {
      "code": "board.edit_not_committed",
      "item": "episode",
      "per": "seat",
      "doc": "The SDK definitively failed a local edit before sending or after a terminal refusal.",
      "user_words": ["my drawing didn't show up for them"],
      "witnesses": [
        {
          "fact": "board.client_edit",
          "from": ["client"],
          "required": true,
          "query": "axiom chalk-logs | where episode_id == '{episode}' and participant_id == '{participant}' and type == 'board_edit'",
          "doc": "The author SDK's observations of a local edit."
        },
        {
          "fact": "board.sync_edit",
          "from": ["sync"],
          "required": true,
          "query": "axiom chalk-logs | where episode_id == '{episode}' and participant_id == '{participant}' and name == 'board.sync_edit'",
          "doc": "Sync's edit result, after the repository returned."
        }
      ],
      "fault_scenario": "sdks/typescript/client/tests/board-observability.fault.ts"
    },
    {
      "code": "board.out_of_sync",
      "item": "episode",
      "per": "seat",
      "doc": "The recipient SDK skipped at least one same-scene revision.",
      "user_words": ["the board is out of sync"],
      "witnesses": [
        {
          "fact": "board.client_delivery",
          "from": ["client"],
          "required": true,
          "query": "axiom chalk-logs | where episode_id == '{episode}' and participant_id == '{participant}' and type == 'board_delivery'",
          "doc": "An entire update received and emitted to subscribers."
        },
        {
          "fact": "board.sync_delivery",
          "from": ["sync"],
          "required": true,
          "query": "axiom chalk-logs | where episode_id == '{episode}' and participant_id == '{participant}' and name == 'board.sync_delivery'",
          "doc": "An entire update handed to the recipient socket for sending."
        }
      ],
      "fault_scenario": "sdks/typescript/client/tests/board-observability.fault.ts"
    },
    {
      "code": "board.draw_denied",
      "item": "episode",
      "per": "seat",
      "doc": "The resolved whiteboard access does not let this Participant draw.",
      "user_words": ["I can't draw"],
      "witnesses": [
        {
          "fact": "board.client_draw",
          "from": ["client"],
          "required": true,
          "query": "axiom chalk-logs | where episode_id == '{episode}' and participant_id == '{participant}' and type == 'board_draw'",
          "doc": "Resolved draw access or a draw specifically refused for permission."
        }
      ],
      "fault_scenario": "sdks/typescript/client/tests/board-observability.fault.ts"
    },
    {
      "code": "board.snapshot_mismatch",
      "item": "episode",
      "per": "seat",
      "doc": "A snapshot's assembled metadata disagrees with the corresponding durable read.",
      "user_words": ["the drawing wasn't there when I joined"],
      "witnesses": [
        {
          "fact": "board.client_snapshot",
          "from": ["client"],
          "required": true,
          "query": "axiom chalk-logs | where episode_id == '{episode}' and participant_id == '{participant}' and type == 'board_snapshot'",
          "doc": "A full snapshot assembled by the recipient SDK."
        },
        {
          "fact": "board.sync_snapshot",
          "from": ["sync"],
          "required": true,
          "query": "axiom chalk-logs | where episode_id == '{episode}' and participant_id == '{participant}' and name == 'board.sync_snapshot'",
          "doc": "A snapshot prepared from the durable scene for the recipient."
        }
      ],
      "fault_scenario": "sdks/typescript/client/tests/board-observability.fault.ts"
    },
    {
      "code": "board.view_jumped",
      "item": "episode",
      "per": "seat",
      "doc": "A follower's whiteboard view jumped away from what the person they follow is looking at.",
      "user_words": ["the board keeps jumping"],
      "witnesses": [
        {
          "fact": "board.camera",
          "from": ["client"],
          "required": true,
          "query": "r2 flight-recorder/{episode}/{participant} board_camera {from}..{to}",
          "doc": "Every camera move, so a burst of automatic moves shows."
        }
      ],
      "fault_scenario": null
    }
  ],
  "reasons": [
    {
      "code": "board.draw_denied",
      "outcome": "expected",

{
  "area": "join",
  "slice": 2,
  "title": "Join and media connection, including listen-only",
  "prefixes": ["join", "media"],
  "fields": [
    {
      "name": "join_signal",
      "type": "enum",
      "values": [
        "started",
        "sync_started",
        "sync_live",
        "sync_entered",
        "sync_timeout",
        "sync_failed",
        "mic_off",
        "mic_captured",
        "mic_denied",
        "mic_absent",
        "mic_unavailable",
        "camera_off",
        "camera_captured",
        "camera_denied",
        "camera_absent",
        "camera_unavailable",
        "publish_started",
        "publish_accepted",
        "publish_skipped",
        "publish_failed",
        "subscribe_started",
        "subscribe_accepted",
        "subscribe_failed",
        "subscribe_timeout",
        "ice_checking",
        "ice_connected",
        "ice_disconnected",
        "ice_failed",
        "dtls_connecting",
        "dtls_connected",
        "dtls_failed",
        "direct_selected",
        "relay_selected",
        "relay_fallback",
        "transport_timeout",
        "rtp_timeout",
        "send_rtp",
        "receive_rtp",
        "ready",
        "listen_only",
        "startup_ice_failed",
        "startup_dtls_failed"
      ],
      "sensitivity": null,
      "doc": "One bounded observation about the admitted SDK Join and its first media path."
    }
  ],
  "events": [
    {
      "name": "join.initial_signal",
      "kind": "fact",
      "dataset": "lifecycle",
      "side": "client",
      "modules": ["sdk"],
      "doc": "An admitted SDK Join reached an initial Sync, capture, signaling or RTP milestone.",
      "fields": {
        "join_signal": {
          "required": true
        }
      },
      "emit_sites": [
        {
          "path": "sdks/typescript/client/src/media/initial-join.ts",
          "literal": "join.initial_signal"
        }
      ],
      "legacy": {
        "match": {
          "event": "sdk.telemetry",
          "type": "initial_join"
        }
      }
    }
  ],
  "reasons": [
    {
      "code": "join.sync_timeout",
      "outcome": "error",
      "doc": "Initial Join failed: sync timeout."
    },
    {
      "code": "join.sync_failed",
      "outcome": "error",
      "doc": "Initial Join failed: sync failed."
    },
    {
      "code": "media.publish_failed",
      "outcome": "error",
      "doc": "Initial Join failed: publish failed."
    },
    {
      "code": "media.subscribe_timeout",
      "outcome": "error",
      "doc": "Initial Join failed: subscribe timeout."
    },
    {
      "code": "media.ice_failed",
      "outcome": "error",
      "doc": "Initial Join failed: ice failed."
    },
    {
      "code": "media.dtls_failed",
      "outcome": "error",
      "doc": "Initial Join failed: dtls failed."
    },
    {
      "code": "media.transport_timeout",
      "outcome": "error",
      "doc": "Initial Join failed: transport timeout."
    },
    {
      "code": "media.rtp_timeout",
      "outcome": "error",
      "doc": "Initial Join failed: rtp timeout."
    }
  ],
  "machines": [
    {
      "name": "client.connection",
      "doc": "The SDK connection state (CONNECTION_STATES in sdks/typescript/client/src/connection/types.ts). Its one writer is transition() in connection/lifecycle.ts.",
      "states": ["idle", "joining", "live", "reconnecting", "leaving", "left", "failed"],
      "initial": "idle",
      "edges": [
        ["idle", "joining"],
        ["left", "joining"],
        ["failed", "joining"],
        ["joining", "live"],
        ["joining", "failed"],
        ["joining", "leaving"],
        ["live", "reconnecting"],
        ["reconnecting", "live"],
        ["live", "leaving"],
        ["reconnecting", "leaving"],
        ["failed", "leaving"],
        ["leaving", "left"],
        ["live", "failed"],
        ["reconnecting", "failed"]
      ],
      "triggers": ["join", "joined", "join_failed", "leave", "left", "transport_lost", "recovered", "recovery_exhausted", "removed", "episode_ended"]
    }
  ],
  "facts": [
    {
      "name": "join.leave",
      "kind": "event",
      "per": "seat",
      "events": [],
      "doc": "A seat's leave request and its outcome. A failed leave is a failure every finding must account for."
    },
    {
      "name": "join.initial",
      "kind": "event",
      "per": "seat",
      "events": [
        {
          "event": "join.initial_signal",
          "source": "client",
          "claim": "join_signal",
          "failure_claims": ["sync_timeout", "sync_failed", "publish_failed", "subscribe_timeout", "startup_ice_failed", "startup_dtls_failed", "transport_timeout", "rtp_timeout"],
          "fields": ["join_signal", "op_id"]
        }
      ],
      "doc": "The joined seat’s first media attempt, with explicit outcomes and bounded evidence of progress."
    }
  ],
  "symptoms": [
    {
      "code": "join.no_media",
      "item": "episode",
      "per": "seat",
      "doc": "A Participant’s initial Sync or media startup failed before any RTP flowed.",
      "user_words": ["I joined but nothing works", "stuck on connecting"],
      "witnesses": [
        {
          "fact": "join.initial",
          "from": ["client"],
          "required": true,
          "query": "axiom chalk-logs | where episode_id == '{episode}' and participant_id == '{participant}' and event == 'sdk.telemetry' and type == 'initial_join'",
          "doc": "The client witnesses completed startup, or why an admitted Join failed before media flowed."
        }
      ],
      "fault_scenario": "sdks/typescript/client/src/media/initial-join.fault.test.ts"
    }
  ]
}

{
  "name": "chalk",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "sdks/typescript/*",
    "tools/contract-fixture-proof",
    "tools/sdk-web-consumer-e2e",
    "apps/transcription-dispatcher",
    "apps/recording-renderer",
    "apps/mobile",
    "apps/web",
    "infrastructure/uptime-worker"
  ],
  "type": "module",
  "scripts": {
    "build": "GOMAXPROCS=1 turbo build",
    "dev": "node scripts/dev/cli.mjs start",
    "dev:status": "node scripts/dev/cli.mjs status",
    "dev:logs": "node scripts/dev/cli.mjs logs",
    "dev:stop": "node scripts/dev/cli.mjs stop",
    "dev:doctor": "node scripts/dev/cli.mjs doctor",
    "dev:down": "node scripts/dev/cli.mjs down",
    "dev:reset": "node scripts/dev/cli.mjs reset",
    "dev:smoke": "node scripts/dev/media-smoke-runner.mjs .private/chalk-dev/manifest.json",
    "mobile:simulators": "node scripts/open-mobile-dev-simulators.mjs",
    "mobile:install:local": "bash scripts/mobile-install-local-apk.sh",
    "mobile:logs": "bash scripts/dev/android-logs.sh",
    "transcription:infra:check": "bash scripts/transcription-dispatcher/validate-contract.sh",
    "recorder:gate": "bash scripts/recorder/gate.sh",
    "recorder:validate": "node scripts/recorder/validate-config.mjs",
    "dev:mobile": "node scripts/dev/adb-reverse.mjs && pnpm --dir apps/mobile run start",
    "dev:mobile:android": "node scripts/dev/adb-reverse.mjs && pnpm --dir apps/mobile run android",
    "dev:mobile:ios": "pnpm --dir apps/mobile run ios",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:web:pages": "pnpm --dir apps/web run dev:pages",
    "release:managed:ci": "node scripts/deploy/deploy-managed-release.mjs",
    "release:web": "node scripts/deploy/deploy-web-release.mjs",
    "gate": "GOMAXPROCS=${GOMAXPROCS:-1} VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-1} ERL_FLAGS=\"${ERL_FLAGS:-+S 1:1}\" bash scripts/gates/commit.sh",
    "gate:fast": "bash scripts/gates/commit.sh --fast",
    "gate:full": "GOMAXPROCS=${GOMAXPROCS:-1} VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-1} ERL_FLAGS=\"${ERL_FLAGS:-+S 1:1}\" bash scripts/gates/commit.sh --full",
    "gate:boundaries": "node --import=tsx node_modules/@q9labsai/gates/dist/cli.js run --full --lane depcruise",
    "gate:explain": "q9gate why",
    "generate:sdk": "node scripts/codegen/sdk.mjs generate",
    "check:sdk-generated": "node scripts/codegen/sdk.mjs check",
    "contract:generate": "pnpm run generate:sdk",
    "regen": "node --experimental-strip-types scripts/codegen/camera-background-urls.mjs --write && node scripts/codegen/invite-words.mjs --write && node scripts/codegen/recording-render-contract.mjs --write && node scripts/codegen/mobile-release-facts.mjs --write && pnpm run contract:generate && node scripts/codegen/migration-latest-version.mjs --write && bash apps/api/scripts/db-generate.sh run && pnpm run generate:tracker && node apps/web/scripts/docs-search-index.mjs --write",
    "check:generated": "node scripts/codegen/check-generated.mjs",
    "contract:check": "pnpm run check:sdk-generated && pnpm run check:webhook-contract",
    "check:webhook-contract": "node scripts/contracts/check-webhook-v1.mjs",
    "hooks:install": "lefthook install && git config merge.generated.driver true",
    "review:commit": "bash scripts/gates/post-commit-review.sh",
    "gate:hygiene": "node scripts/gates/hygiene.mjs",
    "static:fallow": "fallow audit",
    "static:fallow:health": "fallow health --score --hotspots --targets --min-score ${FALLOW_MIN_SCORE:-90}",
    "static:ast-grep": "node scripts/gates/ast-grep.mjs",
    "security:secrets": "bash scripts/gates/gitleaks.sh",
    "security:osv": "bash scripts/gates/osv-scanner.sh",
    "deps:syncpack": "syncpack lint",
    "package:publint": "pnpm --filter './packages/*' --filter './sdks/typescript/*' exec publint",
    "package:attw": "pnpm --filter './packages/*' --filter './sdks/typescript/*' exec attw --pack --config-path \"$INIT_CWD/.attw.json\"",
    "package:release": "node scripts/npm-release.mjs",
    "test": "node scripts/test/run.mjs node --test scripts/test/no-network.test.mjs && GOMAXPROCS=1 VITEST_MAX_WORKERS=1 turbo test",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "clean": "turbo clean && rm -rf node_modules",
    "generate:tracker": "node scripts/generate-tracker.mjs",
    "check:tracker": "node scripts/generate-tracker.mjs --check",
    "prod:proof": "node scripts/prod-proof/index.mjs",
    "prod:canary": "node scripts/prod-proof/sfu-canary.mjs",
    "prod:fleet": "node scripts/prod-proof/fleet.mjs",
    "prod:sfu-e2e": "node scripts/prod-proof/sfu-e2e.mjs",
    "prod:latency": "node scripts/prod-proof/latency.mjs",
    "prod:recovery": "node scripts/prod-proof/recovery.mjs",
    "prod:sfu-classes": "node scripts/prod-proof/sfu-classes.mjs",
    "prod:proof:compare-leave": "node scripts/prod-proof/leave-session.mjs",
    "tenant:purge": "cd apps/api && go run ./cmd/tenant-purge",
    "web:proof": "node scripts/web-proof/run.mjs",
    "test:e2e": "e2e run",
    "test:mutations": "bash scripts/gates/with-postgres.sh -- node scripts/test/mutations.mjs"
  },
  "dependencies": {
    "react": "19.2.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@ast-grep/cli": "0.51.0",
    "@e2e-dev/web": "0.15.0",
    "@q9labsai/config-depcruise": "^0.3.0",
    "@q9labsai/gates": "^0.4.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "dependency-cruiser": "18.2.0",
    "e2e": "0.21.0",
    "fallow": "3.34.1",
    "js-yaml": "^4.3.2",
    "lefthook": "^2.1.9",
    "openapi-typescript": "7.13.0",
    "oxfmt": "^0.36.0",
    "oxlint": "1.89.0",
    "playwright": "^1.62.1",
    "publint": "^0.3.21",
    "syncpack": "^15.3.1",
    "tsc-rs": "0.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.1-rc",
    "vitest": "^4.1.12",
    "wrangler": "^4.107.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1"
}

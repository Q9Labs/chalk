{
  "name": "chalk",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "sdks/typescript/*",
    "tools/*",
    "apps/transcription-dispatcher",
    "apps/mobile",
    "apps/web",
    "infrastructure/*-broker",
    "infrastructure/uptime-worker"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "node scripts/dev/cli.mjs start",
    "dev:status": "node scripts/dev/cli.mjs status",
    "dev:logs": "node scripts/dev/cli.mjs logs",
    "dev:stop": "node scripts/dev/cli.mjs stop",
    "dev:reset": "node scripts/dev/cli.mjs reset",
    "dev:smoke": "node scripts/dev/media-smoke.mjs .private/chalk-dev/manifest.json",
    "mobile:connect": "bash .agents/skills/chalk-mobile-wireless-debug/scripts/connect-wireless-adb.sh",
    "mobile:launch": "bash .agents/skills/chalk-mobile-wireless-debug/scripts/launch-chalk-mobile-dev.sh",
    "mobile:simulators": "node scripts/open-mobile-dev-simulators.mjs",
    "mobile:install:local": "bash scripts/mobile-install-local-apk.sh",
    "mobile:logs": "bash -lc 'serial=${ADB_SERIAL:-$(adb devices | awk '\"'\"'NR > 1 && $2 == \"device\" {print $1; exit}'\"'\"')}; if [ -z \"$serial\" ]; then echo \"No connected adb device found. Set ADB_SERIAL or run pnpm run mobile:connect.\" >&2; exit 1; fi; adb -s \"$serial\" logcat | rg \"ReactNativeJS|chalk|Expo\"'",
    "observability:start": "bash infrastructure/observability/scripts/local.sh start",
    "observability:stop": "bash infrastructure/observability/scripts/local.sh stop",
    "observability:reset": "bash infrastructure/observability/scripts/local.sh reset",
    "observability:status": "bash infrastructure/observability/scripts/local.sh status",
    "observability:logs": "bash infrastructure/observability/scripts/local.sh logs",
    "observability:smoke": "bash infrastructure/observability/scripts/local.sh smoke",
    "observability:e2e": "bash infrastructure/observability/scripts/local.sh e2e",
    "transcription:build": "pnpm --dir apps/transcription-dispatcher run build",
    "transcription:test": "pnpm --dir apps/transcription-dispatcher run test",
    "transcription:infra:check": "bash scripts/transcription-dispatcher/validate-contract.sh",
    "observability:webhook-canary": "bash infrastructure/observability/scripts/local.sh webhook-canary",
    "architecture:build": "node scripts/architecture-worker/build.mjs",
    "architecture:test": "pnpm run architecture:build && pnpm exec vitest run infrastructure/architecture-worker/src/index.test.ts",
    "architecture:deploy": "node scripts/architecture-worker/deploy-and-verify.mjs",
    "recorder:gate": "bash scripts/recorder/gate.sh",
    "recorder:validate": "node scripts/recorder/validate-config.mjs",
    "recorder:test": "pnpm exec vitest run scripts/recorder/validate-config.test.mjs",
    "dev:mobile": "bash -lc 'if command -v adb >/dev/null 2>&1; then adb reverse tcp:8080 tcp:8080 >/dev/null 2>&1 || true; adb reverse tcp:8081 tcp:8081 >/dev/null 2>&1 || true; fi; pnpm --dir apps/mobile run start'",
    "dev:mobile:android": "bash -lc 'if command -v adb >/dev/null 2>&1; then adb reverse tcp:8080 tcp:8080 >/dev/null 2>&1 || true; adb reverse tcp:8081 tcp:8081 >/dev/null 2>&1 || true; fi; pnpm --dir apps/mobile run android'",
    "dev:mobile:ios": "pnpm --dir apps/mobile run ios",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:web:pages": "pnpm --dir apps/web run dev:pages",
    "release:web": "node scripts/deploy/deploy-web-release.mjs",
    "release:web:ci": "node scripts/deploy/deploy-web-release.mjs",
    "gate": "bash scripts/gates/commit.sh",
    "gate:explain": "sed -n '1,240p' scripts/gates/README.md",
    "language:ratchet": "node tools/language-ratchet/src/cli.mjs",
    "language:ratchet:update": "node tools/language-ratchet/src/cli.mjs --update",
    "trace:inspect": "node tools/episode-diagnostics/src/cli.mjs",
    "episode-diagnostics:browser-proof": "node tools/episode-diagnostics/src/browser-proof.mjs",
    "generate:openapi": "bash apps/api/scripts/generate-openapi.sh && pnpm run generate:api-design",
    "generate:api-design": "node scripts/api-design/generate-canonical-openapi.mjs",
    "test:membership-role-migration": "bash apps/api/scripts/membership-role-migration-test.sh",
    "generate:sdk": "bash scripts/codegen/generate-sdk.sh",
    "check:sdk-generated": "bash scripts/codegen/check-sdk-generated.sh",
    "contract:proof": "pnpm --filter @chalk/contract-fixture-proof proof",
    "contract:generate": "pnpm --filter @chalk/contract-fixture-proof generate && pnpm run generate:sdk && pnpm run generate:api-design",
    "contract:check": "pnpm --filter @chalk/contract-fixture-proof check-generated && pnpm run check:sdk-generated && pnpm run check:webhook-contract && pnpm run check:api-design",
    "check:api-design": "node scripts/api-design/check-canonical-openapi.mjs",
    "check:webhook-contract": "node scripts/contracts/check-webhook-v1.mjs",
    "hooks:install": "lefthook install",
    "review:commit": "bash scripts/gates/post-commit-review.sh",
    "gate:hygiene": "node scripts/gates/hygiene.mjs",
    "static:fallow": "fallow audit",
    "static:fallow:health": "fallow health --score --hotspots --targets --min-score ${FALLOW_MIN_SCORE:-90}",
    "static:semgrep": "bash scripts/gates/semgrep.sh",
    "security:secrets": "bash scripts/gates/gitleaks.sh",
    "security:osv": "bash scripts/gates/osv-scanner.sh",
    "security:image-size": "node --test scripts/security/image-size-patch.test.mjs",
    "deps:syncpack": "syncpack lint",
    "test:presence": "node scripts/gates/test-presence.mjs",
    "test:coverage": "turbo test -- --coverage",
    "package:publint": "pnpm --filter './packages/*' --filter './sdks/typescript/*' exec publint",
    "package:attw": "pnpm --filter './packages/*' --filter './sdks/typescript/*' exec attw --pack --ignore-rules cjs-resolves-to-esm internal-resolution-error --exclude-entrypoints './styles.css' './src/styles.css' './dist/styles/*' './styles/*'",
    "package:release": "node scripts/npm-release.mjs",
    "test": "turbo test",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.102",
    "react": "19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "fallow": "^2.96.0",
    "lefthook": "^2.1.9",
    "openapi-typescript": "7.13.0",
    "oxfmt": "^0.36.0",
    "publint": "^0.3.21",
    "syncpack": "^15.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.1-rc",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.2"
}

{
  "name": "chalk",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "sdks/typescript/*",
    "tools/*",
    "apps/transcription-dispatcher",
    "apps/recording-renderer",
    "apps/mobile",
    "apps/web",
    "infrastructure/uptime-worker"
  ],
  "type": "module",
  "scripts": {
    "build": "GOMAXPROCS=1 turbo build",
    "dev": "node scripts/dev/cli.mjs start",
    "integration:smoke": "node scripts/integration-smoke/run.mjs",
    "dev:status": "node scripts/dev/cli.mjs status",
    "dev:logs": "node scripts/dev/cli.mjs logs",
    "dev:stop": "node scripts/dev/cli.mjs stop",
    "dev:reset": "node scripts/dev/cli.mjs reset",
    "dev:smoke": "node scripts/dev/media-smoke.mjs .private/chalk-dev/manifest.json",
    "mobile:simulators": "node scripts/open-mobile-dev-simulators.mjs",
    "mobile:install:local": "bash scripts/mobile-install-local-apk.sh",
    "mobile:logs": "bash -lc 'serial=${ADB_SERIAL:-$(adb devices | awk '\"'\"'NR > 1 && $2 == \"device\" {print $1; exit}'\"'\"')}; if [ -z \"$serial\" ]; then echo \"No connected adb device found. Set ADB_SERIAL to a connected device.\" >&2; exit 1; fi; adb -s \"$serial\" logcat | rg \"ReactNativeJS|chalk|Expo\"'",
    "transcription:build": "pnpm --dir apps/transcription-dispatcher run build",
    "transcription:test": "pnpm --dir apps/transcription-dispatcher run test",
    "transcription:infra:check": "bash scripts/transcription-dispatcher/validate-contract.sh",
    "recorder:gate": "bash scripts/recorder/gate.sh",
    "recorder:validate": "node scripts/recorder/validate-config.mjs",
    "release:recorder": "python3 scripts/recorder/release.py",
    "dev:mobile": "bash -lc 'if command -v adb >/dev/null 2>&1; then adb reverse tcp:8080 tcp:8080 >/dev/null 2>&1 || true; adb reverse tcp:8081 tcp:8081 >/dev/null 2>&1 || true; fi; pnpm --dir apps/mobile run start'",
    "dev:mobile:android": "bash -lc 'if command -v adb >/dev/null 2>&1; then adb reverse tcp:8080 tcp:8080 >/dev/null 2>&1 || true; adb reverse tcp:8081 tcp:8081 >/dev/null 2>&1 || true; fi; pnpm --dir apps/mobile run android'",
    "dev:mobile:ios": "pnpm --dir apps/mobile run ios",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:web:pages": "pnpm --dir apps/web run dev:pages",
    "release:managed:ci": "node scripts/deploy/deploy-managed-release.mjs",
    "release:web": "node scripts/deploy/deploy-web-release.mjs",
    "release:web:ci": "node scripts/deploy/deploy-web-release.mjs",
    "gate": "GOMAXPROCS=1 VITEST_MAX_WORKERS=1 ERL_FLAGS='+S 1:1' bash scripts/gates/commit.sh",
    "gate:fast": "bash scripts/gates/commit.sh --fast",
    "gate:full": "GOMAXPROCS=1 VITEST_MAX_WORKERS=1 ERL_FLAGS='+S 1:1' bash scripts/gates/commit.sh --full",
    "gate:boundaries": "node --test scripts/gates/package-boundaries.test.mjs && node --import=tsx node_modules/@q9labsai/gates/dist/cli.js run --full --lane depcruise",
    "gate:explain": "q9gate why",
    "generate:openapi": "bash apps/api/scripts/generate-openapi.sh",
    "generate:sdk": "bash scripts/codegen/generate-sdk.sh",
    "check:sdk-generated": "bash scripts/codegen/check-sdk-generated.sh",
    "contract:generate": "pnpm run generate:sdk",
    "regen": "pnpm run contract:generate && node scripts/codegen/migration-latest-version.mjs --write && bash apps/api/scripts/db-generate.sh run && pnpm run generate:tracker",
    "check:generated": "node scripts/codegen/check-generated.mjs",
    "contract:check": "pnpm run check:sdk-generated && pnpm run check:webhook-contract",
    "check:webhook-contract": "node scripts/contracts/check-webhook-v1.mjs",
    "hooks:install": "lefthook install && git config merge.generated.driver true",
    "review:commit": "bash scripts/gates/post-commit-review.sh",
    "gate:hygiene": "node scripts/gates/hygiene.mjs",
    "static:fallow": "fallow audit",
    "static:fallow:health": "fallow health --score --hotspots --targets --min-score ${FALLOW_MIN_SCORE:-90}",
    "static:semgrep": "bash scripts/gates/semgrep.sh",
    "security:secrets": "bash scripts/gates/gitleaks.sh",
    "security:osv": "bash scripts/gates/osv-scanner.sh",
    "security:image-size": "node --test scripts/security/image-size-patch.test.mjs",
    "deps:syncpack": "syncpack lint",
    "test:coverage": "GOMAXPROCS=1 VITEST_MAX_WORKERS=1 turbo test -- --coverage",
    "package:publint": "pnpm --filter './packages/*' --filter './sdks/typescript/*' exec publint",
    "package:attw": "pnpm --filter './packages/*' --filter './sdks/typescript/*' exec attw --pack --ignore-rules cjs-resolves-to-esm internal-resolution-error --exclude-entrypoints './styles.css' './src/styles.css' './dist/styles/*' './styles/*'",
    "package:release": "node scripts/npm-release.mjs",
    "test": "node --test scripts/prod-proof/*.test.mjs && GOMAXPROCS=1 VITEST_MAX_WORKERS=1 turbo test",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "clean": "turbo clean && rm -rf node_modules",
    "generate:tracker": "node scripts/generate-tracker.mjs",
    "check:tracker": "node scripts/generate-tracker.mjs --check",
    "test:tracker": "node --test scripts/tracker.node-test.mjs",
    "prod:proof": "node scripts/prod-proof/index.mjs",
    "tenant:purge": "cd apps/api && go run ./cmd/tenant-purge"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.102",
    "react": "19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@q9labsai/config-depcruise": "^0.3.0",
    "@q9labsai/gates": "^0.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "dependency-cruiser": "18.2.0",
    "fallow": "^2.96.0",
    "js-yaml": "^4.3.2",
    "lefthook": "^2.1.9",
    "openapi-typescript": "7.13.0",
    "oxfmt": "^0.36.0",
    "publint": "^0.3.21",
    "syncpack": "^15.3.1",
    "tsc-rs": "0.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.1-rc",
    "vitest": "^4.1.11",
    "wrangler": "^4.107.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1"
}

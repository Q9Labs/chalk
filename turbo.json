{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "concurrency": "15",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.md", "!**/*.test.*", "!**/*.spec.*"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["DATABASE_URL", "API_URL", "CHALK_APP_VARIANT", "EAS_BUILD_PROFILE", "EXPO_PUBLIC_*"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.md", "!**/*.test.*", "!**/*.spec.*"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["API_URL", "DATABASE_URL", "CHALK_COMMIT_SHA", "CHALK_ENVIRONMENT", "CHALK_EPISODE_DIAGNOSTICS", "CHALK_EPISODE_DIAGNOSTICS_GATEWAY", "CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN", "CHALK_API_URL", "CHALK_DEV_API_ORIGIN", "CHALK_DEV_WEB_PORT", "GITHUB_SHA", "VITE_*"],
      "passThroughEnv": ["CHALK_EPISODE_DIAGNOSTICS_OPERATOR_TOKEN"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/node_modules/**", "!**/dist/**", "!**/coverage/**", "!**/.turbo/**", "!**/.astro/**", "!**/.next/**", "!**/.wrangler/**", "!**/.output/**", "!example/**", "!ios/**", "!android/**"],
      "outputs": ["coverage/**"],
      "env": ["CI", "NODE_ENV"]
    },
    "check-types": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.*", "!**/*.spec.*", "!**/node_modules/**", "!**/dist/**", "!**/coverage/**", "!**/.turbo/**", "!**/.astro/**", "!**/.next/**", "!**/.wrangler/**", "!**/.output/**", "!example/**", "!ios/**", "!android/**"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}

[Unit]
Description=Chalk read-only production alert state snapshot
After=network-online.target chalk-runtime-restore.service
Wants=network-online.target

[Service]
Type=oneshot
User=chalk
EnvironmentFile=/run/chalk/env/api.env
EnvironmentFile=-/etc/chalk-alerts/collector.env
ExecStart=/opt/chalk-alerts/collector
TimeoutStartSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The runtime-health row reads the tunnel Quadlet under the runtime User's home to know whether a connector exists.
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

{{- $headline := "The alert system has stopped reporting" -}}{{- $summary := .Description -}}{{- $next := "An engineer must restore the alert collector now; until then job and webhook failures may go unnoticed." -}}{{- $engineers := "For engineers: freshness; `systemctl status chalk-alert-state.timer chalk-alert-state.service`." -}}{{- $rule := "freshness" -}}
{{- range $i, $key := .GroupKeys -}}
{{- if eq $key "headline" -}}{{- $headline = index $.GroupValues $i -}}{{- end -}}
{{- if eq $key "summary" -}}{{- $summary = index $.GroupValues $i -}}{{- end -}}
{{- if eq $key "next" -}}{{- $next = index $.GroupValues $i -}}{{- end -}}
{{- if eq $key "engineers" -}}{{- $engineers = index $.GroupValues $i -}}{{- end -}}
{{- if eq $key "rule" -}}{{- $rule = index $.GroupValues $i -}}{{- end -}}
{{- end -}}
{{- $count := "" -}}{{- if or (eq $rule "recording") (eq $rule "export") (eq $rule "transcript") (eq $rule "webhook") -}}{{- $count = printf " Affected items: %v." .Value -}}{{- end -}}
{{- $content := printf "%s\n%s%s\n%s\n%s" $headline $summary $count $next $engineers -}}
{{- if eq .Action "Closed" -}}{{- $content = printf "This alert has gone quiet\nEarlier alert: %s. %s\nNothing new has crossed the alert level, but that does not prove the earlier failure was fixed. An engineer must still check the earlier message.\n%s" $headline $summary $engineers -}}{{- end -}}
{"content": {{printf "%q" $content}}, "allowed_mentions": {"parse": []}}

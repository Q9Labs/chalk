#!/usr/bin/env bash
# Keeps what the release's node deploy needs in one GitHub environment secret, CHALK_SFU_DEPLOY_BUNDLE.
#
#   ci-secret publish production            packs the operator directory and sets the secret (run on a machine with 1Password and gh)
#   ci-secret unpack production <directory>  writes the secret's files to <directory>/production (run by the release)
#
# The bundle holds exactly the files `deploy` reads from $CHALK_SFU_PRIVATE_DIR/<env>: the service CA
# certificate, the node's server certificate and key, the operator certificate and key, known_hosts
# (host keys of every node), `nodes` (the addresses the release upgrades, primary first), the OTLP
# header files, and `ssh_key`, the operator's SSH key. `publish` issues a new 90-day operator
# certificate from the CA in 1Password for the bundle and leaves the directory's own one alone.
# Run it again before the operator or server certificate expires; the release refuses to start a
# node deploy that close to expiry (scripts/releases/sfu_nodes.py).
set -euo pipefail

usage="usage: ci-secret publish production | ci-secret unpack production <directory>"
command="${1:?$usage}"
environment="${2:?$usage}"
[[ "$environment" == production ]] || { echo "$usage" >&2; exit 2; }
secret=CHALK_SFU_DEPLOY_BUNDLE
required=(ca.crt server.crt server.key operator.crt operator.key known_hosts nodes ssh_key)
optional=(otlp-headers otlp-log-headers)

case "$command" in
  publish)
    source "$(dirname "$0")/lib.sh"
    dir="${CHALK_SFU_PRIVATE_DIR}/${environment}"
    sfu_check_otlp_tokens "$dir" "${optional[@]}"
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    mkdir -p "${work}/issue/${environment}" "${work}/bundle"
    chmod 700 "${work}/bundle"
    cp "${dir}/ca.crt" "${work}/issue/${environment}/ca.crt"
    CHALK_SFU_PRIVATE_DIR="${work}/issue" "${node_dir}/certs" "$environment" operator 90 >/dev/null
    for file in "${required[@]}" "${optional[@]}"; do
      case "$file" in
        operator.crt | operator.key) cp "${work}/issue/${environment}/${file}" "${work}/bundle/${file}" ;;
        ssh_key) cp "$SFU_SSH_KEY" "${work}/bundle/ssh_key" ;;
        *) if [[ -f "${dir}/${file}" ]]; then cp "${dir}/${file}" "${work}/bundle/${file}"; elif [[ " ${required[*]} " == *" ${file} "* ]]; then echo "missing ${dir}/${file}" >&2; exit 1; fi ;;
      esac
    done
    tar -czf - -C "${work}/bundle" . | base64 | tr -d '\n' |
      gh secret set "$secret" --env "$environment" --repo "${CHALK_REPO:-Q9Labs/chalk}"
    echo "set ${secret} in the ${environment} environment"
    ;;
  unpack)
    destination="${3:?$usage}/${environment}"
    : "${CHALK_SFU_DEPLOY_BUNDLE:?${secret} is empty; run infrastructure/sfu/ci-secret publish ${environment}}"
    umask 077
    mkdir -p "$destination"
    printf '%s' "$CHALK_SFU_DEPLOY_BUNDLE" | base64 --decode | tar -xzf - -C "$destination"
    for file in "${required[@]}"; do
      [[ -s "${destination}/${file}" ]] || { echo "the ${secret} bundle lacks ${file}; run infrastructure/sfu/ci-secret publish ${environment}" >&2; exit 1; }
    done
    ;;
  *) echo "$usage" >&2; exit 2 ;;
esac

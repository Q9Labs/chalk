#cloud-config
# Prepares a Chalk SFU node: rootless Podman for the chalk-sfu user, an 8 MiB
# UDP receive and send buffer and a host firewall that matches the cloud firewall. It
# carries no secrets; `deploy` installs the image, certificates and settings.
package_update: true
packages:
  - podman
  - ufw
write_files:
  - path: /etc/sysctl.d/90-chalk-sfu.conf
    content: |
      # A burst of video from many publishers overflows the default ~208 KiB.
      net.core.rmem_max = ${udp_buffer}
      net.core.rmem_default = ${udp_buffer}
      # The pacers send in bursts; a full send buffer drops outgoing media.
      net.core.wmem_max = ${udp_buffer}
      net.core.wmem_default = ${udp_buffer}
      # ICE-TCP listens on 443 from the rootless container. Linux has no per-port or
      # per-user form of this setting: every port from 443 up becomes unprivileged on the
      # host. Ports 1024 and up already were, so the incremental exposure is 443-1023;
      # the firewall still decides remote reachability. Ports below 443 stay privileged.
      net.ipv4.ip_unprivileged_port_start = 443
  - path: /etc/ssh/sshd_config.d/90-chalk-sfu.conf
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
runcmd:
  - sysctl --system
  - systemctl reload ssh
  - useradd --create-home --shell /usr/sbin/nologin chalk-sfu
  - loginctl enable-linger chalk-sfu
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow ${media_port}/udp
  - ufw allow ${media_port}/tcp
  - ufw allow ${media_tcp_port}/tcp
%{ for address in control_addresses ~}
  - ufw allow proto tcp from ${address} to any port ${control_port}
%{ endfor ~}
%{ for address in ssh_addresses ~}
  - ufw allow proto tcp from ${address} to any port 22
%{ endfor ~}
  - ufw --force enable
  - touch /var/lib/chalk-sfu-bootstrapped

# Rendered by deploy. Settings only; the worker certificate arrives as Podman secrets.
CHALK_RECORDER_ENVIRONMENT=__ENVIRONMENT__
CHALK_RECORDER_CONTROL_PLANE_URL=__CONTROL_PLANE_URL__
CHALK_RECORDER_SERVER_NAME=__SERVER_NAME__
CHALK_RECORDER_WORKER_CERT=/run/chalk-capture/worker.crt
CHALK_RECORDER_WORKER_KEY=/run/chalk-capture/worker.key
CHALK_RECORDER_SERVER_CA=/run/chalk-capture/server-ca.crt
# A worker that sits beside the SFU polls for work often, so a start does not wait for the
# fleet's two-second tick.
CHALK_RECORDER_CLAIM_POLL=250ms
CHALK_RECORDER_CAPTURE_SLOTS=__SLOTS__
CHALK_RECORDER_KEYFRAME_INTERVAL=10s
GOMEMLIMIT=__GOMEMLIMIT__

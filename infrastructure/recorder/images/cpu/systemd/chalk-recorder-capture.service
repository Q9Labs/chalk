[Unit]
Description=Chalk recorder capture worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/chalk-recorder/worker.env

[Service]
Type=simple
User=chalk-recorder
Group=chalk-recorder
Environment=HOME=/var/lib/chalk-recorder
EnvironmentFile=/etc/chalk-recorder/worker.env
RuntimeDirectory=chalk-recorder
RuntimeDirectoryMode=0700
ExecStart=/opt/chalk-recorder/current/bin/recorder-capture --run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=25s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/chalk-recorder /var/lib/chalk-recorder
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

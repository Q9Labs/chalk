#!/usr/bin/env bash
# Puts the inline policies that let the nightly deploy role publish document-renderer ZIPs to the Nightly artifacts
# bucket and document-renderer container images to the renderer ECR repository, or with --check compares each live
# policy with its file and exits 1 on drift.
#
#   AWS_PROFILE=<admin profile> AWS_REGION=<region> apply-document-renderer-publish [--check]
#
# The role's other inline policies are not managed here. The nightly media build needs these because it publishes the
# renderer ZIP and image that Promote later reuses (docs/managed-release.md, "Environment setup").
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
role=chalk-nightly-github-deploy
policies=(
  "chalk-nightly-document-renderer-publish:document-renderer-publish.policy.json"
  "chalk-nightly-document-renderer-image-publish:document-renderer-image.policy.json"
)
mode=apply
case "${1:-}" in
  "") ;;
  --check) mode=check ;;
  *) echo "usage: apply-document-renderer-publish [--check]" >&2; exit 2 ;;
esac

account="$(aws sts get-caller-identity --query Account --output text)"
region="${AWS_REGION:-${AWS_DEFAULT_REGION:-$(aws configure get region)}}"
status=0
for entry in "${policies[@]}"; do
  policy_name="${entry%%:*}"
  file="${entry#*:}"
  desired="$(sed -e "s/__ACCOUNT__/$account/g" -e "s/__REGION__/$region/g" "$here/$file" | jq -S .)"
  if [ "$mode" = apply ]; then
    aws iam put-role-policy --role-name "$role" --policy-name "$policy_name" --policy-document "$desired"
    echo "applied $policy_name to $role"
    continue
  fi
  live="$(aws iam get-role-policy --role-name "$role" --policy-name "$policy_name" --query PolicyDocument --output json | jq -S .)"
  if [ "$live" != "$desired" ]; then
    echo "drift: $policy_name on $role differs from $file" >&2
    diff <(printf '%s\n' "$desired") <(printf '%s\n' "$live") >&2 || true
    status=1
    continue
  fi
  echo "ok: $policy_name on $role matches"
done
exit "$status"

[Unit]
Description=Chalk capture fleet controller
After=network-online.target chalk-api.service chalk-recorder-issuer.service
Requires=chalk-api.service chalk-recorder-issuer.service

[Container]
Image=__RECORDER_CONTROL_IMAGE_REFERENCE__
Pull=never
ContainerName=chalk-recorder-capture
Network=host
EnvironmentFile=/run/chalk/env/recorder-capture.env
Secret=chalk-recorder-capture-client-cert,type=mount,target=/run/chalk/controller.crt,uid=65532,gid=65532,mode=0400
Secret=chalk-recorder-capture-client-key,type=mount,target=/run/chalk/controller.key,uid=65532,gid=65532,mode=0400
Secret=chalk-sync-provider-server-ca,type=mount,target=/run/chalk/control-api-ca.crt,uid=65532,gid=65532,mode=0400
Volume=chalk-recorder-capture.volume:/var/lib/chalk-recorder:U
User=65532
Group=65532
ReadOnly=true
ReadOnlyTmpfs=true
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=16m
DropCapability=all
NoNewPrivileges=true
PidsLimit=64
PodmanArgs=--memory=128m --cpus=0.25
LogDriver=journald
PodmanArgs=--log-opt=tag=chalk-recorder-capture
PodmanArgs=--stop-timeout=25

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90
TimeoutStopSec=30

[Install]
WantedBy=chalk-runtime.target

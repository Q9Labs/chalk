[Unit]
Description=Chalk direct Sync TLS proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CHALK_DIRECT_SYNC_HOST=__DIRECT_SYNC_HOST__
Environment=XDG_DATA_HOME=/var/lib/chalk-direct-sync
Environment=XDG_CONFIG_HOME=/var/lib/chalk-direct-sync
ExecStart=/opt/chalk-direct-sync/caddy run --config /etc/chalk-direct-sync/Caddyfile --adapter caddyfile
DynamicUser=yes
StateDirectory=chalk-direct-sync
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=96M
TasksMax=256
LimitNOFILE=65536
Restart=on-failure
RestartSec=3s
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=multi-user.target

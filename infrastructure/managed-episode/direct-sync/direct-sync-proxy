#!/usr/bin/env bash
# Installs, removes and checks the direct Sync TLS proxy on one managed host.
#
#   CHALK_DIRECT_SYNC_HOST=<hostname> direct-sync-proxy install
#   direct-sync-proxy status      fails when the proxy is down or its certificate expires within 14 days
#   direct-sync-proxy remove      stops and removes the proxy; --purge also deletes the certificate store
#
# The proxy unit also loads and removes the port 443 caps (chalk_direct_proxy nftables table).
# The script changes only this proxy. It never touches the Chalk runtime units, Sync or the Tunnel.
set -euo pipefail

caddy_version=2.11.9
caddy_sha512_amd64=0e85544340290a16ce4bfb76fe7d65e9de1bf3a6e67f5ccfff30b30d27ea4c73e078077b7bf3e58ae60b6b12e44327705287059c775bca5782e8ee85ea7edd75
caddy_sha512_arm64=9e5e76d7888542924de2c25353ae87c5f77e2a22c5b1198633cae13688922282e05383d142599205c88d8d80eee5e967d291214d7abce4835329a191b20dd6e0
min_certificate_days=14

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
install_dir=/opt/chalk-direct-sync
config_dir=/etc/chalk-direct-sync
state_dir=/var/lib/chalk-direct-sync
unit=chalk-direct-sync-proxy.service
unit_path="/etc/systemd/system/${unit}"

fail() {
  printf 'direct-sync-proxy: %s\n' "$*" >&2
  exit 1
}

require_root() {
  [[ "$(id -u)" == 0 ]] || fail 'run as root'
}

# Downloads the pinned Caddy release for this machine and writes the verified binary to $1.
# Each failure removes the private work folder before it stops.
fetch_caddy() {
  local dest="$1" arch expected work archive
  case "$(uname -m)" in
    x86_64) arch=amd64 expected="$caddy_sha512_amd64" ;;
    aarch64) arch=arm64 expected="$caddy_sha512_arm64" ;;
    *) fail "unsupported architecture $(uname -m)" ;;
  esac
  work="$(mktemp -d)"
  archive="caddy_${caddy_version}_linux_${arch}.tar.gz"
  curl --fail --silent --show-error --location --output "${work}/${archive}" \
    "https://github.com/caddyserver/caddy/releases/download/v${caddy_version}/${archive}" \
    || { rm -rf "$work"; fail "could not download ${archive}"; }
  [[ "$(sha512sum "${work}/${archive}" | cut -d' ' -f1)" == "$expected" ]] \
    || { rm -rf "$work"; fail "checksum mismatch for ${archive}"; }
  { tar -xzf "${work}/${archive}" -C "$work" caddy && install -m 0755 "${work}/caddy" "$dest"; } \
    || { rm -rf "$work"; fail "could not unpack ${archive}"; }
  rm -rf "$work"
}

# Replaces $2 with the staged file $1 in one rename, so a reader never sees a half-written file.
# The caller sits in a conditional chain where errexit is off: a failed copy must stop here, before the rename.
replace_file() {
  local staged="$1" target="$2" mode="$3"
  if ! install -m "$mode" "$staged" "${target}.new"; then
    rm -f "${target}.new"
    return 1
  fi
  mv -f "${target}.new" "$target"
}

# Puts back what the install saved in $1, and removes what a first install added.
restore_install() {
  local backup="$1" target
  [[ -e "${backup}/${unit}" ]] || systemctl disable --now "$unit" 2>/dev/null || true
  for target in "${install_dir}/caddy" "${config_dir}/Caddyfile" "${config_dir}/chalk-direct-sync-proxy.nft" "$unit_path"; do
    if [[ -e "${backup}/$(basename "$target")" ]]; then
      cp -p "${backup}/$(basename "$target")" "$target"
    else
      rm -f "$target"
    fi
  done
  systemctl daemon-reload
}

install_proxy() {
  require_root
  local host="${CHALK_DIRECT_SYNC_HOST:-}"
  command -v nft >/dev/null || fail 'nft is required for the port 443 caps'
  [[ "$host" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] \
    || fail 'set CHALK_DIRECT_SYNC_HOST to a lowercase hostname'

  # Build and check every input in a staging folder first: nothing installed changes until all pass.
  local work stage backup
  work="$(mktemp -d)"
  # Expand $work now: it is local and out of scope when the EXIT trap runs.
  # shellcheck disable=SC2064
  trap "rm -rf '${work}'" EXIT
  stage="${work}/stage"
  backup="${work}/backup"
  mkdir "$stage" "$backup"
  fetch_caddy "${stage}/caddy"
  cp "${here}/Caddyfile" "${here}/chalk-direct-sync-proxy.nft" "$stage"
  sed "s|__DIRECT_SYNC_HOST__|${host}|" "${here}/chalk-direct-sync-proxy.service.in" >"${stage}/${unit}"
  nft --check --file "${stage}/chalk-direct-sync-proxy.nft" || fail 'the nftables caps do not validate; nothing was installed'
  CHALK_DIRECT_SYNC_HOST="$host" "${stage}/caddy" validate --config "${stage}/Caddyfile" --adapter caddyfile >/dev/null \
    || fail 'the Caddyfile does not validate; nothing was installed'

  # Keep the previous install, so a failure while switching over puts it back.
  local target
  for target in "${install_dir}/caddy" "${config_dir}/Caddyfile" "${config_dir}/chalk-direct-sync-proxy.nft" "$unit_path"; do
    if [[ -e "$target" ]]; then cp -p "$target" "${backup}/$(basename "$target")"; fi
  done
  install -d -m 0755 "$install_dir" "$config_dir"
  if ! {
    replace_file "${stage}/caddy" "${install_dir}/caddy" 0755 &&
      replace_file "${stage}/Caddyfile" "${config_dir}/Caddyfile" 0644 &&
      replace_file "${stage}/chalk-direct-sync-proxy.nft" "${config_dir}/chalk-direct-sync-proxy.nft" 0644 &&
      replace_file "${stage}/${unit}" "$unit_path" 0644 &&
      systemctl daemon-reload &&
      systemctl enable "$unit" >/dev/null &&
      systemctl restart "$unit"
  }; then
    restore_install "$backup"
    if [[ -e "${backup}/${unit}" ]]; then systemctl restart "$unit" || true; fi
    fail 'the install failed; the previous install was put back'
  fi
  printf 'installed %s for %s; run "direct-sync-proxy status" once DNS and port 443 reach this host\n' "$unit" "$host"
}

remove_proxy() {
  require_root
  systemctl disable --now "$unit" 2>/dev/null || true
  rm -f "$unit_path"
  rm -rf "$install_dir" "$config_dir"
  if [[ "${1:-}" == --purge ]]; then
    rm -rf "$state_dir" /var/lib/private/chalk-direct-sync
  fi
  systemctl daemon-reload
  printf 'removed %s\n' "$unit"
}

served_certificate() {
  echo | openssl s_client -connect 127.0.0.1:443 -servername "$1" 2>/dev/null | openssl x509 -noout "${@:2}" 2>/dev/null
}

status_proxy() {
  systemctl is-active --quiet "$unit" || fail "${unit} is not active (journalctl -u ${unit})"
  nft list table inet chalk_direct_proxy >/dev/null 2>&1 || fail 'the port 443 caps (nftables table chalk_direct_proxy) are not loaded'
  local host not_after
  host="$(sed -n 's/^Environment=CHALK_DIRECT_SYNC_HOST=//p' "$unit_path")"
  not_after="$(served_certificate "$host" -enddate | cut -d= -f2)"
  [[ -n "$not_after" ]] || fail "no certificate served yet: issuance is pending or failing (journalctl -u ${unit} | grep -i acme)"
  served_certificate "$host" -checkend $((min_certificate_days * 86400)) >/dev/null \
    || fail "certificate expires within ${min_certificate_days} days (notAfter ${not_after}); renewal is failing"
  printf 'ok: %s active, certificate valid until %s\n' "$unit" "$not_after"
}

# The test sources this file to replace fetch_caddy and the folders; running it does the work.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0
case "${1:-}" in
  install) install_proxy ;;
  remove) remove_proxy "${2:-}" ;;
  status) status_proxy ;;
  *) fail 'usage: direct-sync-proxy install | status | remove [--purge]' ;;
esac

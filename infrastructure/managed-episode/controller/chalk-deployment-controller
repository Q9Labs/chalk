#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly CONTROLLER_VERSION=2
readonly CONTROLLER_NAME=chalk-deployment-controller
readonly MAIN_BASHPID="${BASHPID}"
CONTROLLER_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly CONTROLLER_DIR
DEFAULT_MANAGED_ROOT="$(cd "${CONTROLLER_DIR}/.." && pwd)"
readonly DEFAULT_MANAGED_ROOT
readonly REQUEST_SCHEMA_KEYS='["adopt_existing_release","aws_region","controller_version","environment","excluded_secrets","parameter_prefix","release_id","request_id","requested_at","schema_version","source_revision"]'
readonly INPUT_IDS='["managed-migrator-database-url","api-env","sync-env","planetscale-sync-proof","provider-bridge-api-server-cert","provider-bridge-api-server-key","provider-bridge-sync-client-ca","provider-bridge-sync-client-cert","provider-bridge-sync-client-key","provider-bridge-api-server-ca","cloudflare-tunnel-token"]'
readonly MIGRATOR_INPUT_ID='managed-migrator-database-url'
readonly MIGRATOR_SECRET_NAME='chalk-managed-migrator-database-url'

state_root="${CHALK_CONTROLLER_STATE_ROOT:-/var/lib/chalk/deployment-controller}"
run_root="${CHALK_CONTROLLER_RUN_ROOT:-/run/chalk}"
runtime_user="${CHALK_RUNTIME_USER:-chalk}"
systemd_root="${CHALK_CONTROLLER_SYSTEMD_ROOT:-/etc/systemd/system}"
systemctl_bin="${CHALK_SYSTEMCTL_BIN:-systemctl}"
podman_bin="${CHALK_PODMAN_BIN:-podman}"
aws_bin="${CHALK_AWS_BIN:-aws}"
health_script="${CHALK_HEALTH_SCRIPT:-}"
health_attempts="${CHALK_HEALTH_ATTEMPTS:-12}"
health_interval_seconds="${CHALK_HEALTH_INTERVAL_SECONDS:-5}"
lock_file="${CHALK_CONTROLLER_LOCK_FILE:-${state_root}/deployment.lock}"
active_pointer="${CHALK_ACTIVE_RELEASE_POINTER:-${state_root}/active-release.json}"
ledger_file="${CHALK_DEPLOYMENT_LEDGER:-${state_root}/deployment-ledger.jsonl}"
runtime_home="${CHALK_RUNTIME_HOME:-/home/${runtime_user}}"
runtime_quadlet_dir="${CHALK_RUNTIME_QUADLET_DIR:-${runtime_home}/.config/containers/systemd}"
runtime_systemd_dir="${CHALK_RUNTIME_SYSTEMD_DIR:-${runtime_home}/.config/systemd/user}"
direct_user_commands="${CHALK_CONTROLLER_DIRECT_USER_COMMANDS:-false}"
controller_install_dir="${CHALK_CONTROLLER_INSTALL_DIR:-/usr/local/libexec}"
allow_non_root_tests="${CHALK_CONTROLLER_ALLOW_NON_ROOT_TESTS:-false}"

request_path=""
manifest_path=""
source_root=""
request_release_id=""
request_source_revision=""
request_environment=""
request_region=""
request_prefix=""
request_id=""
requested_at=""
excluded_json='[]'
adopt_existing_release=false
stage_root=""
versions_json='[]'
missing_json='[]'
input_records_json='[]'
fallback_lock_directory=""

usage() {
  cat >&2 <<'USAGE'
usage:
  chalk-deployment-controller --version
  chalk-deployment-controller deploy --request PATH --manifest PATH --source-root PATH
  chalk-deployment-controller restore
USAGE
}

fail() {
  if [[ "${BASHPID}" == "${MAIN_BASHPID}" && -n "${fallback_lock_directory}" ]]; then
    rmdir "${fallback_lock_directory}" 2>/dev/null || true
    fallback_lock_directory=""
  fi
  printf 'FAIL %s\n' "$1" >&2
  exit 1
}

cleanup_stage() {
  if [[ "${BASHPID}" == "${MAIN_BASHPID}" && -n "${fallback_lock_directory}" ]]; then
    rmdir "${fallback_lock_directory}" 2>/dev/null || true
    fallback_lock_directory=""
  fi
  [[ -n "${stage_root}" && -d "${stage_root}" && ! -L "${stage_root}" ]] || return 0
  case "${stage_root}" in
    "${run_root}"/.deployment.??????) ;;
    *)
      printf 'WARN refusing to clean unsafe deployment stage\n' >&2
      return 0
      ;;
  esac
  find "${stage_root}" -depth -delete 2>/dev/null || printf 'WARN deployment stage cleanup failed\n' >&2
}

remove_staged_tree() {
  local path="$1"
  [[ -n "${stage_root}" && "${path}" == "${stage_root}/"* && "${path}" != "${stage_root}" ]] || fail "refusing to remove a path outside the deployment stage"
  [[ ! -L "${path}" ]] || fail "deployment stage contains a symlink"
  [[ -e "${path}" ]] || return 0
  find "${path}" -depth -delete || fail "deployment stage cleanup failed"
}

emit_result() {
  local status="$1"
  local health="$2"
  local rolled_back="$3"
  local error_message="${4:-}"
  if [[ -n "${fallback_lock_directory}" ]]; then
    rmdir "${fallback_lock_directory}" 2>/dev/null || true
    fallback_lock_directory=""
  fi
  jq -cn \
    --arg status "$status" --arg release_id "$request_release_id" --arg health "$health" \
    --arg request_id "$request_id" --arg error "$error_message" --argjson rolled_back "$rolled_back" \
    '{schema_version:1,status:$status,release_id:$release_id,health:$health,rolled_back:$rolled_back,request_id:$request_id} + (if $error == "" then {} else {error:$error} end)' \
    | sed 's/^/RESULT /'
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"
}

require_host_commands() {
  require_command awk
  require_command "$aws_bin"
  require_command "$podman_bin"
  require_command "$systemctl_bin"
  require_command bash
  require_command cmp
  require_command curl
  require_command find
  require_command grep
  require_command install
  require_command sed
  require_command tail
  if [[ "$direct_user_commands" != true ]]; then
    require_command runuser
  fi
  if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
    fail "required SHA-256 command is unavailable"
  fi
}

is_absolute_path() {
  [[ "$1" == /* && "$1" != *$'\n'* && "$1" != *$'\r'* && "$1" != *$'\t'* ]]
}

reject_symlink_components() {
  local path="$1"
  is_absolute_path "$path" || fail "path must be absolute"
  local current="/"
  local component
  local -a components=()
  IFS='/' read -r -a components <<<"${path#/}"
  for component in "${components[@]}"; do
    [[ -n "$component" && "$component" != "." && "$component" != ".." ]] || fail "path contains an unsafe component"
    current="${current%/}/${component}"
    if [[ -L "$current" ]]; then
      case "$current" in
        /tmp|/var) ;;
        *) fail "path contains a symlink" ;;
      esac
    fi
  done
}

require_regular_file() {
  local path="$1"
  reject_symlink_components "$path"
  [[ -f "$path" && ! -L "$path" ]] || fail "path is not a regular file: ${path}"
}

require_directory() {
  local path="$1"
  reject_symlink_components "$path"
  [[ -d "$path" && ! -L "$path" ]] || fail "path is not a directory: ${path}"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
    return
  fi
  shasum -a 256 "$1" | awk '{print $1}'
}

directory_checksums() {
  local root="$1"
  require_directory "$root"
  [[ -z "$(find "$root" -type l -print -quit)" ]] || fail "runtime directory contains a symlink"
  local checksums='{}'
  local file relative digest
  while IFS= read -r file; do
    relative="${file#"${root}/"}"
    [[ "$relative" != "$file" && "$relative" != *$'\n'* && "$relative" != *$'\r'* && "$relative" != *$'\t'* && "$relative" != *'..'* ]] || fail "runtime checksum path is unsafe"
    digest="$(sha256_file "$file")"
    checksums="$(jq -c --arg path "$relative" --arg digest "$digest" '. + {($path):$digest}' <<<"$checksums")"
  done < <(find "$root" -type f -print | LC_ALL=C sort)
  jq -ce 'type == "object" and length > 0 and all(.[]; test("^[0-9a-f]{64}$"))' <<<"$checksums" >/dev/null || fail "runtime checksum set is empty or invalid"
  printf '%s\n' "$checksums"
}

atomic_write() {
  local destination="$1"
  local contents_file="$2"
  local parent
  parent="$(dirname "$destination")"
  mkdir -p "$parent"
  chmod 700 "$parent"
  local temporary
  temporary="$(mktemp "${parent}/.atomic.XXXXXX")"
  chmod 600 "$temporary"
  cp "$contents_file" "$temporary"
  mv -f "$temporary" "$destination"
}

atomic_install() {
  local mode="$1"
  local source="$2"
  local destination="$3"
  require_regular_file "$source"
  local parent
  parent="$(dirname "$destination")"
  reject_symlink_components "$parent"
  mkdir -p "$parent"
  local temporary
  temporary="$(mktemp "${parent}/.$(basename "$destination").XXXXXX")"
  if ! install -m "$mode" "$source" "$temporary"; then
    find "$temporary" -delete 2>/dev/null || printf 'WARN runtime file staging cleanup failed\n' >&2
    fail "runtime file staging failed"
  fi
  if ! mv -f "$temporary" "$destination"; then
    find "$temporary" -delete 2>/dev/null || printf 'WARN runtime file activation cleanup failed\n' >&2
    fail "runtime file activation failed"
  fi
}

json_is_excluded() {
  local id="$1"
  jq -e --arg id "$id" '.[] | select(. == $id)' <<<"${excluded_json}" >/dev/null 2>&1
}

load_exclusions() {
  local request_file="$1"
  excluded_json="$(jq -cer '.excluded_secrets' "$request_file")" || fail "excluded_secrets is malformed"
  jq -e --argjson allowed "$INPUT_IDS" '
    type == "array" and
    (map(type == "string") | all) and
    (map(. as $id | $allowed | index($id) != null) | all) and
    (index("planetscale-sync-proof") == null) and
    (index("managed-migrator-database-url") == null) and
    (.[0:] == (sort | unique))
  ' <<<"${excluded_json}" >/dev/null || fail "excluded_secrets must be sorted, unique canonical IDs"
}

validate_request() {
  require_regular_file "$request_path"
  jq -e --argjson expected_keys "$REQUEST_SCHEMA_KEYS" '
    type == "object" and (keys | sort) == $expected_keys and
    .schema_version == 2 and .controller_version == 2 and
    (.adopt_existing_release | type == "boolean") and
    (.release_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:@+=-]{0,127}$")) and
    (.source_revision | type == "string" and test("^[0-9a-f]{40}$")) and
    (.environment | type == "string" and (. == "staging" or . == "production")) and
    (.aws_region | type == "string" and test("^[a-z]{2}(?:-gov)?-[a-z]+-[1-9][0-9]*$")) and
    (.parameter_prefix | type == "string" and length <= 900 and test("^/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$")) and
    (.request_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:@+=-]{0,127}$")) and
    (.requested_at | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"))
  ' "$request_path" >/dev/null || fail "deployment request is invalid"
  load_exclusions "$request_path"
  adopt_existing_release="$(jq -r '.adopt_existing_release' "$request_path")"
  request_release_id="$(jq -er '.release_id' "$request_path")"
  request_source_revision="$(jq -er '.source_revision' "$request_path")"
  request_environment="$(jq -er '.environment' "$request_path")"
  request_region="$(jq -er '.aws_region' "$request_path")"
  request_prefix="$(jq -er '.parameter_prefix' "$request_path")"
  [[ "$request_prefix" != *'//' && "$request_prefix" != *'..'* ]] || fail "parameter_prefix contains an unsafe path component"
  [[ "$request_environment" == staging || "$request_environment" == production ]] || fail "deployment environment must be staging or production"
  [[ "$request_prefix" == "/chalk/${request_environment}" || "$request_prefix" == "/chalk/${request_environment}/"* ]] || fail "parameter_prefix must be scoped to the deployment environment"
  request_id="$(jq -er '.request_id' "$request_path")"
  requested_at="$(jq -er '.requested_at' "$request_path")"
}

validate_inventory() {
  local inventory="$1"
  require_regular_file "$inventory"
  jq -e --argjson expected "$INPUT_IDS" '
    type == "object" and (keys | sort) == ["$id","$schema","inputs","schema_version"] and .schema_version == 1 and
    (.inputs | type == "array" and length == 11 and
      (map(.id) == $expected) and
      all(.[];
        type == "object" and
        (keys | sort) == ["destination", "id", "kind", "suffix"] and
        (.id | type == "string") and (.suffix | type == "string" and test("^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$")) and
        (.destination | type == "string" and test("^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$")) and
        (.kind == "env" or .kind == "proof" or .kind == "secret-file" or .kind == "migration")
      )
    )
  ' "$inventory" >/dev/null || fail "runtime input inventory is invalid"
}

validate_manifest() {
  local managed_root="$1"
  require_regular_file "$manifest_path"
  jq -e --argjson allowed "$INPUT_IDS" '
    type == "object" and
    (.schema_version == 1 or .schema_version == 2) and
    (if .schema_version == 1 then
      (keys | sort) == ["architectures","database_compatibility","generated_at","images","protocol_compatibility","release_id","runtime_artifacts","schema_version","source_revision","source_tree_state"]
    else
      (keys | sort) == ["affected_components","architectures","component_releases","database_compatibility","generated_at","images","protocol_compatibility","release_id","runtime_artifacts","schema_version","source_revision","source_tree_state"]
    end) and
    (.release_id | type == "string" and length > 0) and
    (.source_revision | type == "string" and test("^[0-9a-f]{40}$")) and
    (.source_tree_state == "clean") and
    (.architectures == ["linux/arm64"] or .architectures == ["linux/amd64","linux/arm64"]) and
    (.database_compatibility.engine == "postgresql" and .database_compatibility.major == 18 and (.database_compatibility.minimum_migration | type == "number" and . >= 20260713130000) and .database_compatibility.maximum_migration == null) and
    (.protocol_compatibility == {sync:1}) and
    (if .schema_version == 2 then
      ((.affected_components == ["api"] or .affected_components == ["sync"] or .affected_components == ["api","sync"]) and
       (.component_releases | type == "object" and (keys | sort) == ["api","sync"] and all(.[]; type == "object" and (keys | sort) == ["release_id","source_revision"] and (.release_id | type == "string" and length > 0) and (.source_revision | type == "string" and test("^[0-9a-f]{40}$")))) and
       (. as $manifest | all(.affected_components[]; . as $component | $manifest.component_releases[$component] == {release_id:$manifest.release_id,source_revision:$manifest.source_revision})))
    else true end) and
    (.runtime_artifacts | type == "object" and length > 0 and all(.[]; type == "string" and test("^[0-9a-f]{64}$"))) and
    (.images | type == "object" and (keys | sort) == ["api","cloudflared","redis","sync"] and all(.[]; type == "string" and test("^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$")))
  ' "$manifest_path" >/dev/null || fail "release manifest is invalid"
  [[ "$(jq -er '.release_id' "$manifest_path")" == "$request_release_id" ]] || fail "request release_id does not match manifest"
  [[ "$(jq -er '.source_revision' "$manifest_path")" == "$request_source_revision" ]] || fail "request source_revision does not match manifest"

  while IFS=$'\t' read -r relative expected_digest; do
    [[ "$relative" != /* && "$relative" != *$'\n'* && "$relative" != *$'\r'* && "$relative" != *$'\t'* ]] || fail "manifest contains an unsafe runtime artifact path"
    [[ "$relative" != *".."* ]] || fail "manifest contains an unsafe runtime artifact path"
    local artifact="${managed_root}/${relative}"
    require_regular_file "$artifact"
    [[ "$(sha256_file "$artifact")" == "$expected_digest" ]] || fail "runtime artifact digest mismatch"
  done < <(jq -r '.runtime_artifacts | to_entries[] | [.key, .value] | @tsv' "$manifest_path")
}

prepare_stage() {
  reject_symlink_components "$run_root"
  mkdir -p "$run_root"
  chmod 755 "$run_root"
  stage_root="$(mktemp -d "${run_root}/.deployment.XXXXXX")"
  chmod 700 "$stage_root"
  trap cleanup_stage EXIT
}

input_type_is_supported() {
  local kind="$1"
  local parameter_type="$2"
  case "$kind" in
    env | migration | secret-file) [[ "$parameter_type" == SecureString ]] ;;
    proof) [[ "$parameter_type" == String || "$parameter_type" == SecureString ]] ;;
    *) return 1 ;;
  esac
}

reset_staged_inputs() {
  local relative
  for relative in env evidence secret-inputs migration; do
    remove_staged_tree "${stage_root}/${relative}"
  done
}

inventory_value() {
  local field="$1"
  local id="$2"
  jq -er --arg id "$id" ".inputs[] | select(.id == \$id) | .${field}" "$source_root/infrastructure/managed-episode/contracts/runtime-inputs.json"
}

record_input() {
  local id="$1"
  local suffix="$2"
  local destination="$3"
  local kind="$4"
  local name="$5"
  local version="$6"
  local missing="$7"
  input_records_json="$(jq -c \
    --arg id "$id" --arg suffix "$suffix" --arg destination "$destination" --arg kind "$kind" \
    --arg name "$name" --arg version "$version" --argjson missing "$missing" \
    '. + [{id:$id,suffix:$suffix,destination:$destination,kind:$kind,name:$name,version:(if $version == "" then null else ($version | tonumber) end),missing:$missing}]' \
    <<<"${input_records_json}")"
}

write_input_file() {
  local destination="$1"
  local response_file="$2"
  local parameter_name="$3"
  local target="${stage_root}/${destination}"
  reject_symlink_components "$(dirname "$target")"
  mkdir -p "$(dirname "$target")"
  chmod 700 "$(dirname "$target")"
  [[ ! -e "$target" || ! -L "$target" ]] || fail "runtime input destination is a symlink"
  umask 077
  jq -j --arg name "$parameter_name" '.Parameters[] | select(.Name == $name) | .Value' "$response_file" >"$target" || fail "SSM runtime input value could not be written"
  [[ -s "$target" ]] || fail "SSM runtime input value write was empty"
  chmod 600 "$target"
}

fetch_deployment_inputs() {
  local inventory="$source_root/infrastructure/managed-episode/contracts/runtime-inputs.json"
  validate_inventory "$inventory"
  reset_staged_inputs
  local -a ids suffixes destinations kinds names
  mapfile -t ids < <(jq -r '.inputs[].id' "$inventory")
  mapfile -t suffixes < <(jq -r '.inputs[].suffix' "$inventory")
  mapfile -t destinations < <(jq -r '.inputs[].destination' "$inventory")
  mapfile -t kinds < <(jq -r '.inputs[].kind' "$inventory")
  local index
  for index in "${!ids[@]}"; do
    names[index]="${request_prefix}/${suffixes[index]}"
    [[ "${names[index]}" != *'//' && "${names[index]}" != *'..'* ]] || fail "runtime input parameter name is unsafe"
  done

  local response_file="${stage_root}/ssm-response.json"
  local aws_error="${stage_root}/ssm-error.log"
  local batch_response="${stage_root}/ssm-batch-response.json"
  local merged_response="${stage_root}/ssm-merged-response.json"
  local batch_start
  local -a batch_names
  printf '{"Parameters":[],"InvalidParameters":[]}\n' >"$response_file"
  : >"$aws_error"
  for ((batch_start = 0; batch_start < ${#names[@]}; batch_start += 10)); do
    batch_names=("${names[@]:batch_start:10}")
    if ! "$aws_bin" ssm get-parameters --names "${batch_names[@]}" --with-decryption --region "$request_region" --output json >"$batch_response" 2>>"$aws_error"; then
      fail "SSM runtime input fetch failed"
    fi
    jq -s '{Parameters:[.[].Parameters[]],InvalidParameters:[.[].InvalidParameters[]?]}' "$response_file" "$batch_response" >"$merged_response" 2>/dev/null || fail "SSM runtime input response could not be merged"
    mv "$merged_response" "$response_file"
  done
  local expected_names_json
  expected_names_json="$(printf '%s\n' "${names[@]}" | jq -R . | jq -s .)"
  jq -e --argjson expected "$expected_names_json" '
    (.Parameters | type == "array" and all(.[]; type == "object" and (.Name | type == "string") and (.Type | type == "string") and (.Value? | type == "string" or . == null) and (.Version? | type == "number"))) and
    (.InvalidParameters? | if . == null then true else type == "array" and all(.[]; type == "string") end) and
    (([.Parameters[].Name] - $expected) | length) == 0 and
    (((.InvalidParameters // []) - $expected) | length) == 0 and
    ([.Parameters[].Name] | sort | unique | length) == ([.Parameters[].Name] | length)
  ' "$response_file" >/dev/null 2>&1 || fail "SSM response is malformed or contains an unallowlisted input"
  versions_json='[]'
  missing_json='[]'
  input_records_json='[]'
  local id suffix destination kind name count value_length version type
  for index in "${!ids[@]}"; do
    id="${ids[index]}"
    suffix="${suffixes[index]}"
    destination="${destinations[index]}"
    kind="${kinds[index]}"
    name="${names[index]}"
    count="$(jq --arg name "$name" '[.Parameters[] | select(.Name == $name)] | length' "$response_file")"
    if [[ "$count" == 0 ]]; then
      if json_is_excluded "$id"; then
        missing_json="$(jq -c --arg id "$id" '. + [$id]' <<<"${missing_json}")"
        record_input "$id" "$suffix" "$destination" "$kind" "$name" "" true
        continue
      fi
      fail "required SSM runtime input is missing: ${id}"
    fi
    [[ "$count" == 1 ]] || fail "SSM response contains duplicate runtime input: ${id}"
    type="$(jq -er --arg name "$name" '.Parameters[] | select(.Name == $name) | .Type' "$response_file")" || fail "SSM runtime input type is malformed: ${id}"
    input_type_is_supported "$kind" "$type" || fail "SSM runtime input type is unsupported for its contract kind: ${id}"
    value_length="$(jq -er --arg name "$name" '.Parameters[] | select(.Name == $name) | .Value | strings | length' "$response_file")" || fail "SSM runtime input value is malformed: ${id}"
    version="$(jq -er --arg name "$name" '.Parameters[] | select(.Name == $name) | .Version | numbers' "$response_file")" || fail "SSM runtime input version is malformed: ${id}"
    [[ "$version" =~ ^[1-9][0-9]*$ ]] || fail "SSM runtime input version is malformed: ${id}"
    versions_json="$(jq -c --arg id "$id" --arg name "$name" --argjson version "$version" '. + [{id:$id,name:$name,version:$version}]' <<<"${versions_json}")"
    if [[ "$value_length" == 0 ]]; then
      json_is_excluded "$id" || fail "required SSM runtime input is empty: ${id}"
      missing_json="$(jq -c --arg id "$id" '. + [$id]' <<<"${missing_json}")"
      record_input "$id" "$suffix" "$destination" "$kind" "$name" "$version" true
      continue
    fi
    write_input_file "$destination" "$response_file" "$name"
    record_input "$id" "$suffix" "$destination" "$kind" "$name" "$version" false
  done
}

run_user_command() {
  if [[ "$direct_user_commands" == true ]]; then
    "$@"
    return
  fi
  local runtime_uid
  runtime_uid="$(id -u "$runtime_user" 2>/dev/null || true)"
  [[ "$runtime_uid" =~ ^[0-9]+$ ]] || fail "runtime user does not exist"
  XDG_RUNTIME_DIR="/run/user/${runtime_uid}" runuser -u "$runtime_user" -- "$@"
}

run_user_systemctl() {
  run_user_command "$systemctl_bin" --user "$@"
}

run_user_podman() {
  run_user_command "$podman_bin" "$@"
}

install_runtime_files() {
  local runtime_source="$1"
  require_directory "$runtime_source"
  mkdir -p "$runtime_quadlet_dir" "$runtime_systemd_dir"
  chmod 700 "$runtime_quadlet_dir" "$runtime_systemd_dir"
  remove_absent_runtime_files "${runtime_source}/quadlet" "$runtime_quadlet_dir" \
    chalk-api-migrate.container \
    chalk-api.container \
    chalk-cloudflared.container \
    chalk-redis.container \
    chalk-runtime.network \
    chalk-sync.container
  remove_absent_runtime_files "${runtime_source}/systemd" "$runtime_systemd_dir" \
    chalk-runtime.target \
    chalk-runtime-watchdog.service \
    chalk-runtime-watchdog.timer
  local file
  for file in "$runtime_source"/quadlet/*; do
    [[ -f "$file" && ! -L "$file" ]] || fail "rendered runtime contains an unsafe Quadlet"
    atomic_install 0644 "$file" "${runtime_quadlet_dir}/$(basename "$file")"
  done
  for file in "$runtime_source"/systemd/*; do
    [[ -f "$file" && ! -L "$file" ]] || fail "rendered runtime contains an unsafe systemd unit"
    case "$(basename "$file")" in
      chalk-runtime-restore.service) continue ;;
    esac
    atomic_install 0644 "$file" "${runtime_systemd_dir}/$(basename "$file")"
  done
  if [[ "$direct_user_commands" != true ]]; then
    chown -R "${runtime_user}:$(id -gn "$runtime_user")" "$runtime_quadlet_dir" "$runtime_systemd_dir"
  fi
  run_user_systemctl daemon-reload
}

remove_absent_runtime_files() {
  local source_directory="$1"
  local destination_directory="$2"
  shift 2
  local name target
  for name in "$@"; do
    [[ -e "${source_directory}/${name}" ]] && continue
    target="${destination_directory}/${name}"
    [[ ! -e "$target" && ! -L "$target" ]] && continue
    require_regular_file "$target"
    rm -- "$target" || fail "obsolete managed runtime file could not be removed: ${name}"
  done
}

install_restore_unit() {
  local source_unit="$1"
  require_regular_file "$source_unit"
  mkdir -p "$systemd_root"
  atomic_install 0644 "$source_unit" "${systemd_root}/chalk-runtime-restore.service"
  "$systemctl_bin" daemon-reload >/dev/null 2>"${stage_root}/systemd-error.log" || fail "root systemd daemon reload failed"
  "$systemctl_bin" enable chalk-runtime-restore.service >/dev/null 2>"${stage_root}/systemd-enable-error.log" || fail "root restore unit enable failed"
}

install_controller_runtime() {
  local managed_root="$1"
  require_regular_file "${managed_root}/controller/chalk-deployment-controller"
  require_regular_file "${managed_root}/scripts/chalk-runtime-health"
  mkdir -p "$controller_install_dir"
  chmod 755 "$controller_install_dir"
  atomic_install 0755 "${managed_root}/scripts/chalk-runtime-health" "${controller_install_dir}/chalk-runtime-health"
  atomic_install 0755 "${managed_root}/controller/chalk-deployment-controller" "${controller_install_dir}/chalk-deployment-controller"
}

snapshot_installed_runtime() {
  local snapshot_root="${stage_root}/installed-runtime"
  [[ ! -e "$snapshot_root" && ! -L "$snapshot_root" ]] || fail "installed runtime snapshot path is unsafe"
  mkdir -p "$snapshot_root"
  chmod 700 "$snapshot_root"
  snapshot_installed_file "${controller_install_dir}/chalk-runtime-health" "${snapshot_root}/chalk-runtime-health"
  snapshot_installed_file "${controller_install_dir}/chalk-deployment-controller" "${snapshot_root}/chalk-deployment-controller"
  snapshot_installed_file "${systemd_root}/chalk-runtime-restore.service" "${snapshot_root}/chalk-runtime-restore.service"
  if "$systemctl_bin" is-enabled chalk-runtime-restore.service >/dev/null 2>&1; then
    : >"${snapshot_root}/restore-unit-enabled"
  fi
  : >"${snapshot_root}/complete"
}

snapshot_installed_file() {
  local source="$1"
  local backup="$2"
  if [[ -e "$source" || -L "$source" ]]; then
    require_regular_file "$source"
    cp "$source" "$backup"
    chmod 600 "$backup"
  fi
}

restore_installed_runtime() {
  local snapshot_root="${stage_root}/installed-runtime"
  require_regular_file "${snapshot_root}/complete"
  if [[ ! -f "${snapshot_root}/restore-unit-enabled" && ( -e "${systemd_root}/chalk-runtime-restore.service" || -f "${snapshot_root}/chalk-runtime-restore.service" ) ]]; then
    "$systemctl_bin" disable chalk-runtime-restore.service >/dev/null 2>"${stage_root}/systemd-disable-error.log" || fail "root restore unit disable failed during rollback"
  fi
  restore_installed_file 0755 "${snapshot_root}/chalk-runtime-health" "${controller_install_dir}/chalk-runtime-health"
  restore_installed_file 0755 "${snapshot_root}/chalk-deployment-controller" "${controller_install_dir}/chalk-deployment-controller"
  restore_installed_file 0644 "${snapshot_root}/chalk-runtime-restore.service" "${systemd_root}/chalk-runtime-restore.service"
  "$systemctl_bin" daemon-reload >/dev/null 2>"${stage_root}/systemd-rollback-error.log" || fail "root systemd daemon reload failed during rollback"
  if [[ -f "${snapshot_root}/restore-unit-enabled" ]]; then
    "$systemctl_bin" enable chalk-runtime-restore.service >/dev/null 2>"${stage_root}/systemd-rollback-enable-error.log" || fail "root restore unit enable failed during rollback"
  fi
}

restore_installed_file() {
  local mode="$1"
  local backup="$2"
  local destination="$3"
  if [[ -f "$backup" && ! -L "$backup" ]]; then
    atomic_install "$mode" "$backup" "$destination"
    return
  fi
  [[ ! -e "$backup" && ! -L "$backup" ]] || fail "installed runtime backup is unsafe"
  if [[ -e "$destination" || -L "$destination" ]]; then
    require_regular_file "$destination"
    find "$destination" -delete || fail "candidate installed runtime file could not be removed"
  fi
}

replace_runtime_directory() {
  local name="$1"
  local source="$2"
  [[ "$name" == env || "$name" == release ]] || fail "runtime directory name is invalid"
  require_directory "$source"

  local candidate backup destination
  candidate="$(mktemp -d "${stage_root}/publish-${name}.XXXXXX")"
  backup="$(mktemp -d "${stage_root}/previous-${name}.XXXXXX")"
  rmdir "$backup"
  destination="${run_root}/${name}"
  cp -R "${source}/." "$candidate/"

  if [[ "$name" == env ]]; then
    chmod 700 "$candidate"
    find "$candidate" -type d -exec chmod 700 {} +
    find "$candidate" -type f -exec chmod 600 {} +
    if [[ "$direct_user_commands" != true ]]; then
      chown -R "${runtime_user}:$(id -gn "$runtime_user")" "$candidate"
    fi
  else
    chmod 755 "$candidate"
    find "$candidate" -type d -exec chmod 755 {} +
    find "$candidate" -type f -exec chmod 644 {} +
  fi

  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -d "$destination" && ! -L "$destination" ]] || fail "runtime destination is unsafe"
    mv "$destination" "$backup" || fail "existing runtime directory could not be staged"
  fi
  if ! mv "$candidate" "$destination"; then
    if [[ -d "$backup" && ! -e "$destination" ]]; then
      mv "$backup" "$destination" || fail "runtime directory activation failed and the prior directory could not be restored"
    fi
    fail "runtime directory activation failed"
  fi
}

activate_runtime_inputs() {
  local env_source="${stage_root}/env"
  mkdir -p "$env_source"
  chmod 700 "$env_source"

  local identity_source="${stage_root}/release-identity"
  remove_staged_tree "$identity_source"
  mkdir -p "$identity_source"
  cp "$manifest_path" "${identity_source}/release-manifest.json"
  printf '%s  release-manifest.json\n' "$(sha256_file "$manifest_path")" >"${identity_source}/release-manifest.sha256"

  replace_runtime_directory env "$env_source"
  replace_runtime_directory release "$identity_source"
}

reconcile_secrets() {
  local id destination secret_name source
  while IFS=$'\t' read -r id destination; do
    case "$id" in
      managed-migrator-database-url) secret_name="$MIGRATOR_SECRET_NAME" ;;
      provider-bridge-api-server-cert) secret_name=chalk-api-provider-server-cert ;;
      provider-bridge-api-server-key) secret_name=chalk-api-provider-server-key ;;
      provider-bridge-sync-client-ca) secret_name=chalk-api-provider-client-ca ;;
      provider-bridge-sync-client-cert) secret_name=chalk-sync-provider-client-cert ;;
      provider-bridge-sync-client-key) secret_name=chalk-sync-provider-client-key ;;
      provider-bridge-api-server-ca) secret_name=chalk-sync-provider-server-ca ;;
      cloudflare-tunnel-token) secret_name=chalk-cloudflare-tunnel-token ;;
      *) continue ;;
    esac
    source="${stage_root}/${destination}"
    if [[ ! -f "$source" ]]; then
      if run_user_podman secret inspect "$secret_name" >/dev/null 2>"${stage_root}/secret-inspect-error.log"; then
        run_user_podman secret rm "$secret_name" >/dev/null 2>"${stage_root}/secret-rm-error.log" || fail "excluded Podman secret removal failed"
      fi
      continue
    fi
    local -a replace_option=()
    if run_user_podman secret inspect "$secret_name" >/dev/null 2>"${stage_root}/secret-inspect-error.log"; then
      replace_option=(--replace)
    fi
    if ! cat "$source" | run_user_podman secret create "${replace_option[@]}" "$secret_name" - >/dev/null 2>"${stage_root}/secret-create-error.log"; then
      local secret_error
      secret_error="$(tr '\n' ' ' <"${stage_root}/secret-create-error.log" | cut -c 1-512)"
      fail "Podman secret registration failed for ${secret_name}: ${secret_error:-unknown Podman error}"
    fi
    run_user_podman secret inspect "$secret_name" >/dev/null 2>"${stage_root}/secret-verify-error.log" || fail "Podman secret registration could not be verified"
  done < <(jq -r '.[] | [.id, .destination] | @tsv' <<<"${input_records_json}")
  if ! has_migrator_input; then
    remove_migrator_secret
  fi
}

has_migrator_input() {
  jq -e --arg id "$MIGRATOR_INPUT_ID" 'any(.[]; .id == $id and .missing == false)' <<<"${input_records_json}" >/dev/null 2>&1
}

remove_migrator_secret() {
  if run_user_podman secret inspect "$MIGRATOR_SECRET_NAME" >/dev/null 2>"${stage_root}/migration-secret-inspect-error.log"; then
    run_user_podman secret rm "$MIGRATOR_SECRET_NAME" >/dev/null 2>"${stage_root}/migration-secret-rm-error.log" || fail "migration credential cleanup failed"
  fi
}

pull_images() {
  local host_architecture
  case "$(uname -m)" in
    aarch64 | arm64) host_architecture=arm64 ;;
    x86_64 | amd64) host_architecture=amd64 ;;
    *) fail "host architecture is unsupported" ;;
  esac
  jq -e --arg architecture "linux/${host_architecture}" '.architectures | index($architecture) != null' "$manifest_path" >/dev/null || fail "release manifest does not support the host architecture"
  authenticate_ecr_registries

  local image image_architecture
  while IFS= read -r image; do
    [[ "$image" =~ ^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$ ]] || fail "manifest image is not digest-addressed"
    run_user_podman pull "$image" >/dev/null 2>"${stage_root}/podman-pull-error.log" || fail "digest-addressed image pull failed"
    image_architecture="$(run_user_podman image inspect --format '{{.Architecture}}' "$image" 2>"${stage_root}/podman-inspect-error.log")" || fail "pulled image architecture inspection failed"
    [[ "$image_architecture" == "$host_architecture" ]] || fail "pulled image architecture does not match the host"
  done < <(jq -r '.images | .api, .sync, .redis, .cloudflared' "$manifest_path")
}

authenticate_ecr_registries() {
  local authenticated_registries=$'\n'
  local image registry
  while IFS= read -r image; do
    registry="${image%%/*}"
    if [[ ! "$registry" =~ ^[0-9]{12}\.dkr\.ecr\.[a-z0-9-]+\.amazonaws\.com(\.cn)?$ ]]; then
      continue
    fi
    [[ "$registry" =~ ^[0-9]{12}\.dkr\.ecr\.${request_region}\.amazonaws\.com(\.cn)?$ ]] || fail "ECR image registry does not match the deployment region"
    if [[ "$authenticated_registries" == *$'\n'"${registry}"$'\n'* ]]; then
      continue
    fi
    if ! "$aws_bin" ecr get-login-password --region "$request_region" 2>"${stage_root}/ecr-login-error.log" \
      | run_user_podman login --username AWS --password-stdin "$registry" >/dev/null 2>"${stage_root}/podman-login-error.log"; then
      fail "rootless ECR authentication failed"
    fi
    authenticated_registries+="${registry}"$'\n'
  done < <(jq -r '.images | .api, .sync, .redis, .cloudflared' "$manifest_path")
}

stop_runtime() {
  local unit
  local failed=false
  for unit in chalk-api-migrate.service chalk-cloudflared.service chalk-sync.service chalk-api.service chalk-redis.service; do
    if ! run_user_systemctl stop "$unit" >/dev/null 2>"${stage_root}/stop-${unit}.log"; then
      failed=true
    fi
  done
  if ! run_user_systemctl stop chalk-runtime.target >/dev/null 2>"${stage_root}/stop-runtime-target.log"; then
    failed=true
  fi
  [[ "$failed" == false ]]
}

start_runtime() {
  run_user_systemctl start chalk-runtime.target >/dev/null 2>"${stage_root}/start-runtime.log"
}

run_migrations() {
  local runtime_source="$1"
  local migration_unit="${runtime_source}/quadlet/chalk-api-migrate.container"
  if [[ ! -f "$migration_unit" || -L "$migration_unit" ]]; then
    has_migrator_input && fail "release migration Quadlet is missing"
    return 0
  fi
  has_migrator_input || fail "release migration credential is missing"

  local migration_target
  migration_target="$(jq -er '.database_compatibility.minimum_migration | numbers' "$manifest_path")" || fail "release migration target is invalid"
  [[ "$migration_target" =~ ^[0-9]{14}$ ]] || fail "release migration target is invalid"
  grep -Fqx "Exec=/usr/local/bin/chalk-migrate --database-url-file /run/chalk/migrate/database-url --target ${migration_target}" "$migration_unit" || fail "release migration unit target does not match the manifest"
  grep -Fq "Secret=${MIGRATOR_SECRET_NAME}," "$migration_unit" || fail "release migration unit does not mount the dedicated credential"

  run_user_systemctl stop chalk-api-migrate.service >/dev/null 2>"${stage_root}/migration-stop.log" || true
  run_user_systemctl reset-failed chalk-api-migrate.service >/dev/null 2>"${stage_root}/migration-reset-failed.log" || true
  run_user_podman rm --force chalk-api-migrate >/dev/null 2>"${stage_root}/migration-container-rm.log" || true
  if ! run_user_systemctl start chalk-api-migrate.service >/dev/null 2>"${stage_root}/migration-start.log"; then
    remove_migrator_secret
    remove_staged_tree "${stage_root}/migration"
    fail "database migration phase failed"
  fi
  remove_migrator_secret
  remove_staged_tree "${stage_root}/migration"
}

health_runtime() {
  local script="${health_script}"
  if [[ -z "$script" ]]; then
    script="${source_root:+${source_root}/infrastructure/managed-episode/scripts/chalk-runtime-health}"
    [[ -n "$script" && -f "$script" ]] || script="${controller_install_dir}/chalk-runtime-health"
    [[ -f "$script" ]] || script="${DEFAULT_MANAGED_ROOT}/scripts/chalk-runtime-health"
  fi
  require_regular_file "$script"
  [[ "$health_attempts" =~ ^[1-9][0-9]*$ && "$health_attempts" -le 60 ]] || fail "health attempt count is invalid"
  [[ "$health_interval_seconds" =~ ^[1-9][0-9]*$ && "$health_interval_seconds" -le 30 ]] || fail "health retry interval is invalid"
  local attempt
  for ((attempt = 1; attempt <= health_attempts; attempt += 1)); do
    if run_user_command bash -s -- <"$script" >>"${stage_root}/health.log" 2>&1; then
      return 0
    fi
    if ((attempt < health_attempts)); then
      sleep "$health_interval_seconds"
    fi
  done
  tail -n 20 "${stage_root}/health.log" >&2 || printf 'WARN health detail could not be read\n' >&2
  return 1
}

fence_runtime() {
  local status=0
  if ! stop_runtime; then
    status=1
  fi
  if ! remove_migrator_secret; then
    status=1
  fi
  if [[ -n "$stage_root" && -d "${stage_root}/migration" ]]; then
    remove_staged_tree "${stage_root}/migration"
  fi
  return "$status"
}

validate_live_release_manifest() {
  local live_manifest="$1"
  local live_checksum="${run_root}/release/release-manifest.sha256"
  require_regular_file "$live_manifest"
  require_regular_file "$live_checksum"
  local expected_checksum
  expected_checksum="$(awk '$2 == "release-manifest.json" {print $1; exit}' "$live_checksum")"
  [[ "$expected_checksum" =~ ^[0-9a-f]{64}$ ]] || fail "live release checksum is invalid"
  [[ "$(sha256_file "$live_manifest")" == "$expected_checksum" ]] || fail "live release manifest checksum does not match"

  local host_architecture
  case "$(uname -m)" in
    aarch64 | arm64) host_architecture=arm64 ;;
    x86_64 | amd64) host_architecture=amd64 ;;
    *) fail "host architecture is unsupported" ;;
  esac
  jq -e --arg architecture "linux/${host_architecture}" '
    type == "object" and
    (.schema_version == 1 or .schema_version == 2) and
    (.release_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:@+=-]{0,127}$")) and
    (.source_revision | type == "string" and test("^[0-9a-f]{40}$")) and
    .source_tree_state == "clean" and
    (.architectures | type == "array" and index($architecture) != null) and
    (.database_compatibility.engine == "postgresql" and .database_compatibility.major == 18 and (.database_compatibility.minimum_migration | type == "number" and . >= 20260713130000) and .database_compatibility.maximum_migration == null) and
    .protocol_compatibility == {sync:1} and
    (.runtime_artifacts | type == "object" and length > 0 and all(.[]; type == "string" and test("^[0-9a-f]{64}$"))) and
    (.images | type == "object" and (keys | sort) == ["api","cloudflared","redis","sync"] and all(.[]; type == "string" and test("^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$")))
  ' "$live_manifest" >/dev/null || fail "live release manifest is invalid"
  [[ "$(jq -er '.release_id' "$live_manifest")" != "$request_release_id" ]] || fail "live release cannot adopt the candidate identity"
}

verify_live_runtime_inputs() {
  jq -e 'length == 0' <<<"${excluded_json}" >/dev/null || fail "legacy adoption does not allow excluded runtime inputs"
  local relative
  for relative in env/api.env env/sync.env evidence/planetscale-sync-proof.json; do
    require_regular_file "${stage_root}/${relative}"
    require_regular_file "${run_root}/${relative}"
    cmp -s "${stage_root}/${relative}" "${run_root}/${relative}" || fail "live runtime input does not match the versioned SSM value: ${relative}"
  done

  local secret_name
  for secret_name in \
    chalk-api-provider-server-cert \
    chalk-api-provider-server-key \
    chalk-api-provider-client-ca \
    chalk-sync-provider-client-cert \
    chalk-sync-provider-client-key \
    chalk-sync-provider-server-ca \
    chalk-cloudflare-tunnel-token; do
    run_user_podman secret inspect "$secret_name" >/dev/null 2>"${stage_root}/adopt-secret-inspect-error.log" || fail "live runtime Podman secret is missing: ${secret_name}"
  done
}

snapshot_live_runtime() {
  local live_manifest="$1"
  local destination="$2"
  [[ ! -e "$destination" && ! -L "$destination" ]] || fail "live runtime snapshot path is unsafe"
  mkdir -p "${destination}/quadlet" "${destination}/systemd"
  chmod 700 "$destination" "${destination}/quadlet" "${destination}/systemd"

  local file
  for file in chalk-api.container chalk-sync.container chalk-redis.container chalk-cloudflared.container chalk-runtime.network; do
    require_regular_file "${runtime_quadlet_dir}/${file}"
    cp "${runtime_quadlet_dir}/${file}" "${destination}/quadlet/${file}"
    chmod 600 "${destination}/quadlet/${file}"
  done
  if [[ -f "${runtime_quadlet_dir}/chalk-api-migrate.container" ]]; then
    require_regular_file "${runtime_quadlet_dir}/chalk-api-migrate.container"
    cp "${runtime_quadlet_dir}/chalk-api-migrate.container" "${destination}/quadlet/chalk-api-migrate.container"
    chmod 600 "${destination}/quadlet/chalk-api-migrate.container"
  fi
  for file in chalk-runtime.target chalk-runtime-watchdog.service chalk-runtime-watchdog.timer; do
    require_regular_file "${runtime_systemd_dir}/${file}"
    cp "${runtime_systemd_dir}/${file}" "${destination}/systemd/${file}"
    chmod 600 "${destination}/systemd/${file}"
  done

  local component image unit
  while IFS=$'\t' read -r component unit; do
    image="$(jq -er --arg component "$component" '.images[$component]' "$live_manifest")"
    grep -Fqx "Image=${image}" "${destination}/quadlet/${unit}" || fail "live Quadlet image does not match release identity: ${component}"
  done <<'LIVE_IMAGES'
api	chalk-api.container
sync	chalk-sync.container
redis	chalk-redis.container
cloudflared	chalk-cloudflared.container
LIVE_IMAGES
}

adopt_live_release() {
  local live_manifest="${run_root}/release/release-manifest.json"
  validate_live_release_manifest "$live_manifest"
  verify_live_runtime_inputs
  health_runtime || fail "live runtime health failed before adoption"

  local adopted_runtime="${stage_root}/adopted-runtime"
  snapshot_live_runtime "$live_manifest" "$adopted_runtime"
  local candidate_inputs_json="$input_records_json"
  if [[ ! -f "${adopted_runtime}/quadlet/chalk-api-migrate.container" ]]; then
    input_records_json="$(jq -c --arg id "$MIGRATOR_INPUT_ID" '[.[] | select(.id != $id)]' <<<"${input_records_json}")"
  fi
  local candidate_manifest="$manifest_path"
  local candidate_release_id="$request_release_id"
  local candidate_source_revision="$request_source_revision"
  request_release_id="$(jq -er '.release_id' "$live_manifest")"
  request_source_revision="$(jq -er '.source_revision' "$live_manifest")"
  manifest_path="$live_manifest"
  local adopted_release_root="${state_root}/releases/${request_release_id}"
  [[ ! -e "$adopted_release_root" && ! -L "$adopted_release_root" ]] || fail "adopted release already exists in durable state"
  persist_release "$adopted_release_root" "$adopted_runtime" "$active_pointer" adopted
  manifest_path="$candidate_manifest"
  request_release_id="$candidate_release_id"
  request_source_revision="$candidate_source_revision"
  input_records_json="$candidate_inputs_json"
}

persist_release() {
  local release_root="$1"
  local rendered_root="$2"
  local pointer_file="$3"
  local outcome="${4:-healthy}"
  local manifest_sha
  manifest_sha="$(sha256_file "$manifest_path")"
  mkdir -p "$release_root"
  chmod 700 "$release_root"
  cp "$manifest_path" "${release_root}/release-manifest.json"
  chmod 600 "${release_root}/release-manifest.json"
  cp -R "$rendered_root" "${release_root}/runtime"
  chmod -R go-rwx "${release_root}/runtime"
  local runtime_checksums
  runtime_checksums="$(directory_checksums "${release_root}/runtime")"
  local pointer_tmp="${stage_root}/active-pointer.json"
  jq -n \
    --arg release_id "$request_release_id" \
    --arg source_revision "$request_source_revision" \
    --arg environment "$request_environment" \
    --arg aws_region "$request_region" \
    --arg parameter_prefix "$request_prefix" \
    --arg request_id "$request_id" \
    --arg requested_at "$requested_at" \
    --arg manifest_sha256 "$manifest_sha" \
    --arg release_root "$release_root" --argjson controller_version "$CONTROLLER_VERSION" \
    --argjson excluded_secrets "$excluded_json" \
    --argjson inputs "$input_records_json" \
    --argjson runtime_sha256 "$runtime_checksums" \
    '{schema_version:1,controller_version:$controller_version,release_id:$release_id,source_revision:$source_revision,environment:$environment,aws_region:$aws_region,parameter_prefix:$parameter_prefix,request_id:$request_id,requested_at:$requested_at,excluded_secrets:$excluded_secrets,manifest_sha256:$manifest_sha256,runtime_sha256:$runtime_sha256,release_root:$release_root,inputs:$inputs}' >"$pointer_tmp"
  if [[ -e "$ledger_file" || -L "$ledger_file" ]]; then
    require_regular_file "$ledger_file"
  else
    reject_symlink_components "$ledger_file"
  fi
  jq -cn \
    --arg outcome "$outcome" --arg release_id "$request_release_id" --arg source_revision "$request_source_revision" \
    --arg request_id "$request_id" --arg requested_at "$requested_at" --arg manifest_sha256 "$manifest_sha" \
    --argjson controller_version "$CONTROLLER_VERSION" --argjson excluded_secrets "$excluded_json" --argjson inputs "$input_records_json" \
    '{schema_version:1,controller_version:$controller_version,outcome:$outcome,release_id:$release_id,source_revision:$source_revision,request_id:$request_id,requested_at:$requested_at,manifest_sha256:$manifest_sha256,excluded_secrets:$excluded_secrets,inputs:$inputs}' >>"$ledger_file"
  chmod 600 "$ledger_file"
  atomic_write "$pointer_file" "$pointer_tmp"
}

remove_unpublished_release() {
  local release_root="$1"
  [[ "$release_root" == "${state_root}/releases/${request_release_id}" ]] || return 1
  [[ ! -e "$release_root" && ! -L "$release_root" ]] && return 0
  [[ -d "$release_root" && ! -L "$release_root" ]] || return 1
  if [[ -f "$active_pointer" && ! -L "$active_pointer" ]] && jq -e --arg release_root "$release_root" '.release_root == $release_root' "$active_pointer" >/dev/null 2>&1; then
    return 1
  fi
  find "$release_root" -depth -delete
}

load_active_pointer() {
  require_regular_file "$active_pointer"
  jq -e --argjson allowed "$INPUT_IDS" '
    type == "object" and
    (keys | sort) == ["aws_region","controller_version","environment","excluded_secrets","inputs","manifest_sha256","parameter_prefix","release_id","release_root","request_id","requested_at","runtime_sha256","schema_version","source_revision"] and
    .schema_version == 1 and .controller_version == 2 and
    (.release_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:@+=-]{0,127}$")) and
    (.source_revision | type == "string" and test("^[0-9a-f]{40}$")) and
    (.aws_region | type == "string" and test("^[a-z]{2}(?:-gov)?-[a-z]+-[1-9][0-9]*$")) and
    (.request_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:@+=-]{0,127}$")) and
    (.requested_at | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$")) and
    (.release_root | type == "string" and startswith("/")) and
    (.manifest_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
    (.runtime_sha256 | type == "object" and length > 0 and all(.[]; type == "string" and test("^[0-9a-f]{64}$"))) and
    (.environment == "staging" or .environment == "production") and
    (.environment as $environment | (.parameter_prefix == ("/chalk/" + $environment) or (.parameter_prefix | startswith("/chalk/" + $environment + "/")))) and
    (.excluded_secrets | type == "array" and (map(. as $id | $allowed | index($id) != null) | all) and (.[0:] == (sort | unique))) and
    (
      .excluded_secrets as $excluded |
      .parameter_prefix as $prefix |
      (.inputs | type == "array" and ((length == 11 and (map(.id) == $allowed)) or (length == 10 and (map(.id) == ($allowed - ["managed-migrator-database-url"])))) and all(.[];
        type == "object" and
        (keys | sort) == ["destination","id","kind","missing","name","suffix","version"] and
        (.name == ($prefix + "/" + .suffix)) and
        (.destination | type == "string" and test("^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$")) and
        (.suffix | type == "string" and test("^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$")) and
        (.kind == "env" or .kind == "proof" or .kind == "secret-file" or .kind == "migration") and
        (.missing | type == "boolean") and
        (if .missing then ((.version == null) or (.version | type == "number" and floor == . and . >= 1)) else (.version | type == "number" and floor == . and . >= 1) end) and
        (.id as $id | ((.missing | not) or ($excluded | index($id) != null)))
      ))
    )
  ' "$active_pointer" >/dev/null || fail "active release pointer is invalid"
  local pointer_release_root
  pointer_release_root="$(jq -er '.release_root' "$active_pointer")"
  [[ "$pointer_release_root" == "${state_root}/releases/"* && "$pointer_release_root" != *'..'* ]] || fail "active release pointer escapes state root"
  [[ "$pointer_release_root" == "${state_root}/releases/$(jq -er '.release_id' "$active_pointer")" ]] || fail "active release pointer release root is inconsistent"
  local durable_manifest
  durable_manifest="${pointer_release_root}/release-manifest.json"
  require_regular_file "$durable_manifest"
  [[ "$(sha256_file "$durable_manifest")" == "$(jq -er '.manifest_sha256' "$active_pointer")" ]] || fail "active release manifest hash does not match pointer"
  local durable_runtime="${pointer_release_root}/runtime"
  require_directory "$durable_runtime"
  [[ "$(directory_checksums "$durable_runtime" | jq -cS .)" == "$(jq -cS '.runtime_sha256' "$active_pointer")" ]] || fail "active rendered runtime hashes do not match pointer"
  jq -e --arg release_id "$(jq -er '.release_id' "$active_pointer")" --arg source_revision "$(jq -er '.source_revision' "$active_pointer")" '.release_id == $release_id and .source_revision == $source_revision' "$durable_manifest" >/dev/null || fail "active release manifest identity does not match pointer"
}

restore_inputs_from_pointer() {
  local pointer_file="$1"
  local pointer_region
  pointer_region="$(jq -er '.aws_region' "$pointer_file")"
  excluded_json="$(jq -cer '.excluded_secrets' "$pointer_file")"
  reset_staged_inputs
  local id name version missing destination kind suffix
  local response_file="${stage_root}/restore-response.json"
  while IFS=$'\t' read -r id name version missing destination kind suffix; do
    if [[ "$missing" == true ]]; then
      local recorded_version="$version"
      [[ "$recorded_version" != 0 ]] || recorded_version=""
      record_input "$id" "$suffix" "$destination" "$kind" "$name" "$recorded_version" true
      continue
    fi
    [[ "$name" =~ ^/[^:]*$ ]] || fail "active input parameter name is unsafe"
    [[ "$version" =~ ^[1-9][0-9]*$ ]] || fail "active input parameter version is invalid"
    if ! "$aws_bin" ssm get-parameters --names "${name}:${version}" --with-decryption --region "$pointer_region" --output json >"$response_file" 2>"${stage_root}/restore-ssm-error.log"; then
      fail "SSM exact-version restore failed: ${id}"
    fi
    jq -e '(.Parameters | type == "array" and length == 1) and ((.InvalidParameters // []) == [])' "$response_file" >/dev/null 2>&1 || fail "SSM exact-version restore response is malformed"
    local returned_version returned_name returned_value_length returned_type
    returned_name="$(jq -er '.Parameters[0].Name | strings' "$response_file")" || fail "SSM restore parameter name is malformed"
    returned_version="$(jq -er '.Parameters[0].Version | numbers' "$response_file")" || fail "SSM restore parameter version is malformed"
    [[ "$returned_name" == "$name" && "$returned_version" == "$version" ]] || fail "SSM restore did not return the requested parameter version"
    returned_type="$(jq -er '.Parameters[0].Type | strings' "$response_file")" || fail "SSM restore parameter type is malformed"
    input_type_is_supported "$kind" "$returned_type" || fail "SSM restore parameter type is unsupported for its contract kind"
    returned_value_length="$(jq -er '.Parameters[0].Value | strings | length' "$response_file")" || fail "SSM restore parameter value is malformed"
    [[ "$returned_value_length" != 0 ]] || fail "required exact-version runtime input is empty: ${id}"
    write_input_file "$destination" "$response_file" "$name"
    record_input "$id" "$suffix" "$destination" "$kind" "$name" "$version" false
  done < <(jq -r '.inputs[] | [.id, .name, (.version // 0), .missing, .destination, .kind, .suffix] | @tsv' "$pointer_file")
}

run_candidate() {
  local runtime_source="$1"
  install_runtime_files "$runtime_source"
  stop_runtime || fail "runtime services could not be stopped for cutover"
  activate_runtime_inputs
  reconcile_secrets
  run_migrations "$runtime_source"
  start_runtime
  health_runtime
}

rollback_to_stable() {
  local stable_pointer="$1"
  local stable_release_root stable_runtime stable_manifest
  stable_release_root="$(jq -er '.release_root' "$stable_pointer")"
  stable_runtime="${stable_release_root}/runtime"
  stable_manifest="${stable_release_root}/release-manifest.json"
  require_directory "$stable_runtime"
  require_regular_file "$stable_manifest"
  versions_json='[]'
  missing_json='[]'
  input_records_json='[]'
  restore_inputs_from_pointer "$stable_pointer"
  manifest_path="$stable_manifest"
  run_candidate "$stable_runtime"
}

deploy() {
  if ((EUID != 0)) && [[ "$allow_non_root_tests" != true ]]; then
    fail "deployment controller must run as root"
  fi
  require_host_commands
  require_directory "$source_root"
  local managed_root="${source_root}/infrastructure/managed-episode"
  require_directory "$managed_root"
  validate_inventory "${managed_root}/contracts/runtime-inputs.json"
  validate_manifest "$managed_root"
  prepare_stage
  fetch_deployment_inputs
  local rendered_root="${stage_root}/runtime"
  mkdir -p "$rendered_root"
  local render_script="${managed_root}/scripts/render-runtime"
  require_regular_file "$render_script"
  "$render_script" "$manifest_path" "$rendered_root" >"${stage_root}/render.log" 2>&1 || fail "runtime rendering failed"
  local validate_script="${managed_root}/scripts/validate-runtime"
  require_regular_file "$validate_script"
  local missing_inputs_csv
  missing_inputs_csv="$(jq -r 'sort | join(",")' <<<"${missing_json}")"
  "$validate_script" \
    --env-root "${stage_root}/env" \
    --secret-root "${stage_root}/secret-inputs" \
    --manifest "$manifest_path" \
    --sync-proof "${stage_root}/evidence/planetscale-sync-proof.json" \
    --rendered-root "$rendered_root" \
    --excluded-secrets "$missing_inputs_csv" >"${stage_root}/validate.log" 2>&1 || fail "candidate runtime validation failed"
  pull_images
  local stable_exists=false
  local stable_was_adopted=false
  if [[ -f "$active_pointer" && ! -L "$active_pointer" ]]; then
    load_active_pointer
    stable_exists=true
  elif [[ -e "$active_pointer" ]]; then
    fail "active release pointer is unsafe"
  elif [[ "$adopt_existing_release" == true ]]; then
    local live_manifest="${run_root}/release/release-manifest.json"
    if [[ -f "$live_manifest" && ! -L "$live_manifest" ]]; then
      adopt_live_release
      load_active_pointer
      stable_exists=true
      stable_was_adopted=true
    elif [[ -e "$live_manifest" || -L "$live_manifest" ]]; then
      fail "live release manifest is unsafe"
    fi
  fi
  local release_root="${state_root}/releases/${request_release_id}"
  [[ ! -e "$release_root" ]] || fail "release already exists in durable state"
  local stable_pointer_copy="${stage_root}/stable-pointer.json"
  if [[ "$stable_exists" == true ]]; then
    cp "$active_pointer" "$stable_pointer_copy"
    chmod 600 "$stable_pointer_copy"
  fi
  local candidate_status
  local promotion_status=0
  local installed_runtime_status=0
  local installed_runtime_restored=true
  set +e
  (
    set -e
    run_candidate "$rendered_root"
  )
  candidate_status=$?
  set -e
  if ((candidate_status == 0)); then
    set +e
    (
      set -e
      snapshot_installed_runtime
      install_controller_runtime "$managed_root"
      install_restore_unit "${managed_root}/systemd/chalk-runtime-restore.service"
      persist_release "$release_root" "$rendered_root" "$active_pointer"
    )
    promotion_status=$?
    set -e
    if ((promotion_status == 0)); then
      emit_result deployed passed false
      return
    fi
  fi
  local candidate_failure="candidate activation or health failed"
  if ((candidate_status == 0)); then
    candidate_failure="candidate promotion failed"
  fi
  if ((candidate_status == 0 && promotion_status != 0)); then
    set +e
    (
      set -e
      restore_installed_runtime
    )
    installed_runtime_status=$?
    set -e
    if ((installed_runtime_status != 0)); then
      installed_runtime_restored=false
      candidate_failure="${candidate_failure}; installed controller rollback failed"
    fi
  fi
  if ! remove_unpublished_release "$release_root"; then
    candidate_failure="${candidate_failure}; unpublished release cleanup failed"
  fi
  if ! fence_runtime; then
    candidate_failure="${candidate_failure}; runtime fencing reported errors"
  fi
  if [[ "$stable_exists" != true ]]; then
    emit_result failed failed false "${candidate_failure}; no previous release exists"
    exit 1
  fi
  local rollback_status
  set +e
  (
    set -e
    rollback_to_stable "$stable_pointer_copy" || exit 1
    if [[ "$stable_was_adopted" == true ]]; then
      install_controller_runtime "$managed_root"
      install_restore_unit "${managed_root}/systemd/chalk-runtime-restore.service"
    fi
  )
  rollback_status=$?
  set -e
  if ((rollback_status == 0)) && [[ "$installed_runtime_restored" == true ]]; then
    emit_result rolled_back failed true "$candidate_failure; previous release restored"
    exit 1
  fi
  local rollback_failure="rollback health failed"
  if ((rollback_status == 0)); then
    rollback_failure="installed controller rollback failed"
  fi
  if ! fence_runtime; then
    rollback_failure="${rollback_failure}; runtime fencing reported errors"
  fi
  emit_result failed failed false "${candidate_failure}; ${rollback_failure}; candidate fenced"
  exit 1
}

restore() {
  if ((EUID != 0)) && [[ "$allow_non_root_tests" != true ]]; then
    fail "deployment controller must run as root"
  fi
  require_host_commands
  [[ -f "$active_pointer" && ! -L "$active_pointer" ]] || fail "durable active release pointer is missing"
  prepare_stage
  load_active_pointer
  local release_root
  release_root="$(jq -er '.release_root' "$active_pointer")"
  local runtime_source="${release_root}/runtime"
  local durable_manifest="${release_root}/release-manifest.json"
  require_directory "$runtime_source"
  require_regular_file "$durable_manifest"
  local expected_manifest_hash
  expected_manifest_hash="$(jq -er '.manifest_sha256' "$active_pointer")"
  [[ "$(sha256_file "$durable_manifest")" == "$expected_manifest_hash" ]] || fail "durable release manifest hash mismatch"
  versions_json='[]'
  missing_json='[]'
  input_records_json='[]'
  restore_inputs_from_pointer "$active_pointer"
  manifest_path="$durable_manifest"
  local restore_status
  set +e
  (
    set -e
    run_candidate "$runtime_source"
  )
  restore_status=$?
  set -e
  if ((restore_status != 0)); then
    fence_runtime || printf 'WARN runtime fencing reported errors\n' >&2
    fail "active release restore health failed; runtime fenced"
  fi
  request_release_id="$(jq -er '.release_id' "$active_pointer")"
  request_id="$(jq -er '.request_id' "$active_pointer")"
  emit_result restored passed false
}

with_lock() {
  reject_symlink_components "$lock_file"
  mkdir -p "$(dirname "$lock_file")"
  chmod 700 "$(dirname "$lock_file")"
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$lock_file"
    flock -n 9 || fail "another deployment is in progress"
    "$@"
    return
  fi
  local lock_directory="${lock_file}.d"
  [[ ! -e "$lock_directory" || ! -L "$lock_directory" ]] || fail "deployment lock path is unsafe"
  mkdir "$lock_directory" 2>/dev/null || fail "another deployment is in progress"
  fallback_lock_directory="$lock_directory"
  trap cleanup_stage EXIT
  local command_status=0
  if "$@"; then
    command_status=0
  else
    command_status=$?
  fi
  rmdir "$lock_directory" 2>/dev/null || true
  fallback_lock_directory=""
  return "$command_status"
}

validate_state_paths() {
  local path
  for path in "$lock_file" "$active_pointer" "$ledger_file"; do
    is_absolute_path "$path" || fail "durable state path must be absolute"
    [[ "$path" == "${state_root}/"* && "$path" != *'..'* ]] || fail "durable state path escapes state root"
  done
}

parse_deploy_args() {
  while (($# > 0)); do
    case "$1" in
      --request) [[ $# -ge 2 ]] || fail "--request requires a path"; request_path="$2"; shift 2 ;;
      --manifest) [[ $# -ge 2 ]] || fail "--manifest requires a path"; manifest_path="$2"; shift 2 ;;
      --source-root) [[ $# -ge 2 ]] || fail "--source-root requires a path"; source_root="$2"; shift 2 ;;
      *) fail "unknown deploy argument" ;;
    esac
  done
  [[ -n "$request_path" && -n "$manifest_path" && -n "$source_root" ]] || { usage; exit 2; }
  is_absolute_path "$request_path" || fail "request path must be absolute"
  is_absolute_path "$manifest_path" || fail "manifest path must be absolute"
  is_absolute_path "$source_root" || fail "source root path must be absolute"
}

main() {
  require_command jq
  case "${1:-}" in
    --version)
      [[ $# == 1 ]] || { usage; exit 2; }
      printf '%s %s\n' "$CONTROLLER_NAME" "$CONTROLLER_VERSION"
      ;;
    deploy)
      shift
      parse_deploy_args "$@"
      validate_request
      reject_symlink_components "$state_root"
      validate_state_paths
      with_lock deploy
      ;;
    restore)
      [[ $# == 1 ]] || { usage; exit 2; }
      reject_symlink_components "$state_root"
      validate_state_paths
      with_lock restore
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"

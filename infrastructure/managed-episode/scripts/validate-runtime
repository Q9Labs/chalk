#!/usr/bin/env bash
set -euo pipefail

managed_root="$(cd "$(dirname "$0")/.." && pwd)"
env_root=""
secret_root=""
manifest=""
sync_proof=""
rendered_root=""
allow_dirty=false
excluded_secrets=""

usage() {
  echo "usage: validate-runtime --env-root <dir> --secret-root <dir> --manifest <file> --sync-proof <file> [--rendered-root <dir>] [--excluded-secrets <sorted-comma-separated-ids>] [--allow-dirty]" >&2
}

while (($# > 0)); do
  case "$1" in
    --env-root) env_root="${2:-}"; shift 2 ;;
    --secret-root) secret_root="${2:-}"; shift 2 ;;
    --manifest) manifest="${2:-}"; shift 2 ;;
    --sync-proof) sync_proof="${2:-}"; shift 2 ;;
    --rendered-root) rendered_root="${2:-}"; shift 2 ;;
    --allow-dirty) allow_dirty=true; shift ;;
    --excluded-secrets) excluded_secrets="${2:-}"; shift 2 ;;
    *) usage; exit 2 ;;
  esac
done

command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
command -v openssl >/dev/null || { echo "openssl is required" >&2; exit 1; }
if [[ -z "${env_root}" || -z "${secret_root}" || -z "${manifest}" || -z "${sync_proof}" ]]; then
  usage
  exit 2
fi

if [[ -n "${excluded_secrets}" ]]; then
  excluded_secrets="$(jq -Rcer --argjson allowed '["api-env","sync-env","provider-bridge-api-server-cert","provider-bridge-api-server-key","provider-bridge-sync-client-ca","provider-bridge-sync-client-cert","provider-bridge-sync-client-key","provider-bridge-api-server-ca","cloudflare-tunnel-token"]' '
    split(",") |
    if length > 0 and all(.[]; length > 0) and (map(. as $id | $allowed | index($id) != null) | all) and (.[0:] == (sort | unique)) then . else error end
  ' <<<"${excluded_secrets}")" || { echo "excluded runtime input IDs are invalid" >&2; exit 2; }
else
  excluded_secrets='[]'
fi

is_excluded() {
  jq -e --arg id "$1" '.[] | select(. == $id)' <<<"${excluded_secrets}" >/dev/null 2>&1
}

fail() {
  echo "FAIL $1" >&2
  exit 1
}

secure_regular_file() {
  local file="$1"
  [[ -f "${file}" && ! -L "${file}" ]] || fail "required input is not a regular file: ${file}"
  [[ -s "${file}" ]] || fail "required input is empty: ${file}"
  local mode
  if stat -f '%Lp' "${file}" >/dev/null 2>&1; then
    mode="$(stat -f '%Lp' "${file}")"
  else
    mode="$(stat -c '%a' "${file}")"
  fi
  if ((8#${mode} & 077)); then
    fail "required input must not grant group or other permissions: ${file}"
  fi
}

certificate_matches_private_key() {
  local certificate="$1"
  local private_key="$2"
  [[ "$(openssl x509 -in "$certificate" -pubkey -noout 2>/dev/null)" == "$(openssl pkey -in "$private_key" -pubout 2>/dev/null)" ]] || fail "certificate and private key do not match: ${certificate}"
}

input_is_absent() {
  local file="$1"
  [[ ! -e "${file}" && ! -L "${file}" ]]
}

env_value() {
  local file="$1"
  local name="$2"
  awk -v name="${name}" '
    index($0, name "=") == 1 { count++; value=substr($0, length(name) + 2) }
    END { if (count == 1 && length(value) > 0) print value; else exit 1 }
  ' "${file}"
}

require_env() {
  local file="$1"
  local name="$2"
  env_value "${file}" "${name}" >/dev/null || fail "${name} must occur exactly once with a non-empty value in ${file}"
}

api_env="${env_root}/api.env"
sync_env="${env_root}/sync.env"

api_required=(
  CHALK_API_ADDR CHALK_API_CORS_ALLOWED_ORIGINS CHALK_API_ENV
  CHALK_API_TRUSTED_PROXY_CIDRS CHALK_API_SERVICE CHALK_API_VERSION
  CHALK_API_OTLP_ENDPOINT OTEL_EXPORTER_OTLP_TRACES_HEADERS
  OTEL_EXPORTER_OTLP_LOGS_HEADERS OTEL_EXPORTER_OTLP_METRICS_HEADERS
  CHALK_OPS_INGEST_TOKEN
  CHALK_DATABASE_URL CHALK_REDIS_URL CHALK_SYNC_TOKEN_ISSUER
  CHALK_SYNC_TOKEN_AUDIENCE CHALK_SYNC_TOKEN_KEY_ID CHALK_SYNC_TOKEN_PRIVATE_KEY
  CHALK_EPISODE_DIAGNOSTICS CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN
  CHALK_EPISODE_DIAGNOSTICS_HMAC_KEY
  CHALK_EPISODE_DIAGNOSTICS_OPERATOR_ISSUER
  CHALK_EPISODE_DIAGNOSTICS_OPERATOR_AUDIENCE
  CHALK_EPISODE_DIAGNOSTICS_OPERATOR_JWKS
  CHALK_EPISODE_DIAGNOSTICS_SERVICE_ISSUER
  CHALK_EPISODE_DIAGNOSTICS_SERVICE_KEY_ID
  CHALK_EPISODE_DIAGNOSTICS_SERVICE_PRIVATE_KEY
  CHALK_EPISODE_DIAGNOSTICS_SERVICE_VERIFICATION_KEYS
  CHALK_PROVIDER_BRIDGE_ADDRESS CHALK_PROVIDER_BRIDGE_SERVER_CERT_FILE
  CHALK_PROVIDER_BRIDGE_SERVER_KEY_FILE CHALK_PROVIDER_BRIDGE_CLIENT_CA_FILE
  CHALK_PROVIDER_BRIDGE_SPIFFE_TRUST_DOMAIN CHALK_CLOUDFLARE_ACCOUNT_ID
  CHALK_CLOUDFLARE_API_TOKEN CHALK_CLOUDFLARE_REALTIME_APP_ID
  CHALK_CLOUDFLARE_REALTIME_APP_SECRET CHALK_R2_ACCOUNT_ID
  CHALK_R2_ACCESS_KEY_ID CHALK_R2_SECRET_ACCESS_KEY CHALK_R2_BUCKET
  CHALK_INTEGRATIONS_ENABLED CHALK_RECORDING_ENABLED
  CHALK_TRANSCRIPTION_ENABLED CHALK_WHITEBOARD_FILES_ENABLED
  CHALK_WEBHOOK_ENCRYPTION_KEY
)
sync_required=(
  PORT CHALK_SYNC_BIND_IP CHALK_API_ENV CHALK_API_URL CHALK_DATABASE_URL
  CHALK_SYNC_DATABASE_POOL_SIZE CHALK_EPISODE_DIAGNOSTICS
  CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN
  CHALK_EPISODE_DIAGNOSTICS_SERVICE_ISSUER
  CHALK_EPISODE_DIAGNOSTICS_SERVICE_KEY_ID
  CHALK_EPISODE_DIAGNOSTICS_SERVICE_PRIVATE_KEY
  CHALK_SYNC_DIAGNOSTICS_ALLOWED_HOSTS CHALK_SYNC_INSTANCE_ID
  CHALK_SYNC_GENERATION CHALK_SYNC_RELEASE_ID CHALK_SYNC_SOURCE_COMMIT CHALK_SYNC_OTLP_ENDPOINT
  OTEL_EXPORTER_OTLP_TRACES_HEADERS OTEL_RESOURCE_ATTRIBUTES
  CHALK_SYNC_TOKEN_ISSUER CHALK_SYNC_TOKEN_AUDIENCE CHALK_SYNC_TOKEN_PUBLIC_KEYS
  CHALK_SYNC_MAX_WAL_LAG_BYTES CHALK_SYNC_PROVIDER_BRIDGE_URL
  CHALK_SYNC_PROVIDER_BRIDGE_CERTFILE CHALK_SYNC_PROVIDER_BRIDGE_KEYFILE
  CHALK_SYNC_PROVIDER_BRIDGE_CAFILE
)

api_available=true
sync_available=true
if is_excluded api-env && input_is_absent "${api_env}"; then
  api_available=false
else
  secure_regular_file "${api_env}"
  grep -Eq '__[A-Z0-9_]+__' "${api_env}" && fail "runtime API environment contains unresolved placeholders"
  for name in "${api_required[@]}"; do require_env "${api_env}" "${name}"; done
fi
if is_excluded sync-env && input_is_absent "${sync_env}"; then
  sync_available=false
else
  secure_regular_file "${sync_env}"
  grep -Eq '__[A-Z0-9_]+__' "${sync_env}" && fail "runtime Sync environment contains unresolved placeholders"
  for name in "${sync_required[@]}"; do require_env "${sync_env}" "${name}"; done
fi

if [[ "$api_available" == true && "$sync_available" == true ]]; then

ops_ingest_token="$(env_value "${api_env}" CHALK_OPS_INGEST_TOKEN)"
ops_ingest_token_bytes="$(LC_ALL=C printf '%s' "${ops_ingest_token}" | LC_ALL=C wc -c | tr -d '[:space:]')"
(( ops_ingest_token_bytes >= 32 )) || fail "CHALK_OPS_INGEST_TOKEN must contain at least 32 bytes"

case "$(env_value "${api_env}" CHALK_INTEGRATIONS_ENABLED)" in
  true) require_env "${api_env}" CHALK_COMPOSIO_API_KEY ;;
  false) ;;
  *) fail "CHALK_INTEGRATIONS_ENABLED must be true or false" ;;
esac
case "$(env_value "${api_env}" CHALK_RECORDING_ENABLED)" in
  false) ;;
  true) fail "CHALK_RECORDING_ENABLED must remain false for this release" ;;
  *) fail "CHALK_RECORDING_ENABLED must be true or false" ;;
esac
case "$(env_value "${api_env}" CHALK_TRANSCRIPTION_ENABLED)" in
  false) ;;
  true) fail "CHALK_TRANSCRIPTION_ENABLED must remain false for this release" ;;
  *) fail "CHALK_TRANSCRIPTION_ENABLED must be true or false" ;;
esac
case "$(env_value "${api_env}" CHALK_WHITEBOARD_FILES_ENABLED)" in
  true)
    for name in CHALK_R2_ACCOUNT_ID CHALK_R2_ACCESS_KEY_ID CHALK_R2_SECRET_ACCESS_KEY CHALK_R2_BUCKET; do
      require_env "${api_env}" "${name}"
    done
    ;;
  false) ;;
  *) fail "CHALK_WHITEBOARD_FILES_ENABLED must be true or false" ;;
esac

[[ "$(env_value "${api_env}" CHALK_API_ENV)" == production ]] || fail "CHALK_API_ENV must be production"
[[ "$(env_value "${sync_env}" CHALK_API_ENV)" == production ]] || fail "Sync CHALK_API_ENV must be production"
[[ "$(env_value "${api_env}" CHALK_API_SERVICE)" == chalk-api ]] || fail "CHALK_API_SERVICE must be chalk-api"
for endpoint_entry in "${api_env}|CHALK_API_OTLP_ENDPOINT" "${sync_env}|CHALK_SYNC_OTLP_ENDPOINT"; do
  IFS='|' read -r file name <<<"${endpoint_entry}"
  [[ "$(env_value "${file}" "${name}")" == https://api.axiom.co ]] || fail "${name} must use the pathless direct Axiom HTTPS endpoint"
done
api_trace_headers="$(env_value "${api_env}" OTEL_EXPORTER_OTLP_TRACES_HEADERS)"
api_log_headers="$(env_value "${api_env}" OTEL_EXPORTER_OTLP_LOGS_HEADERS)"
api_metrics_headers="$(env_value "${api_env}" OTEL_EXPORTER_OTLP_METRICS_HEADERS)"
if [[ "${api_trace_headers}" == "${api_log_headers}" || "${api_trace_headers}" == "${api_metrics_headers}" || "${api_log_headers}" == "${api_metrics_headers}" ]]; then
  fail "API traces, logs, and metrics must use distinct dedicated Axiom header secrets"
fi
[[ "$(env_value "${sync_env}" OTEL_EXPORTER_OTLP_TRACES_HEADERS)" == "${api_trace_headers}" ]] || fail "API and Sync traces must share the same Axiom trace header secret"
for file in "${api_env}" "${sync_env}"; do
  [[ "$(env_value "${file}" CHALK_EPISODE_DIAGNOSTICS)" == hosted ]] || fail "CHALK_EPISODE_DIAGNOSTICS must be hosted in ${file}"
  [[ "$(env_value "${file}" CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN)" == true ]] || fail "CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN must be true in ${file}"
done
[[ "$(env_value "${api_env}" CHALK_EPISODE_DIAGNOSTICS_OPERATOR_AUDIENCE)" == chalk-diagnostics-operator ]] || fail "CHALK_EPISODE_DIAGNOSTICS_OPERATOR_AUDIENCE must use the hosted operator audience"
operator_issuer="$(env_value "${api_env}" CHALK_EPISODE_DIAGNOSTICS_OPERATOR_ISSUER)"
[[ "${operator_issuer}" =~ ^https://[^/?#]+/?$ ]] || fail "CHALK_EPISODE_DIAGNOSTICS_OPERATOR_ISSUER must be an HTTPS origin"
operator_jwks="$(env_value "${api_env}" CHALK_EPISODE_DIAGNOSTICS_OPERATOR_JWKS)"
jq -e '.keys | type == "array" and length > 0' <<<"${operator_jwks}" >/dev/null 2>&1 || fail "CHALK_EPISODE_DIAGNOSTICS_OPERATOR_JWKS must contain at least one key"
diagnostics_hmac_key="$(env_value "${api_env}" CHALK_EPISODE_DIAGNOSTICS_HMAC_KEY)"
diagnostics_hmac_key_bytes="$(LC_ALL=C printf '%s' "${diagnostics_hmac_key}" | LC_ALL=C wc -c | tr -d '[:space:]')"
(( diagnostics_hmac_key_bytes >= 32 )) || fail "CHALK_EPISODE_DIAGNOSTICS_HMAC_KEY must contain at least 32 bytes"
for name in CHALK_EPISODE_DIAGNOSTICS_SERVICE_ISSUER CHALK_EPISODE_DIAGNOSTICS_SERVICE_KEY_ID CHALK_EPISODE_DIAGNOSTICS_SERVICE_PRIVATE_KEY; do
  [[ "$(env_value "${api_env}" "${name}")" == "$(env_value "${sync_env}" "${name}")" ]] || fail "${name} must match between API and Sync"
done
[[ "$(env_value "${api_env}" CHALK_EPISODE_DIAGNOSTICS_SERVICE_ISSUER)" == https://api.chalkmeet.com ]] || fail "CHALK_EPISODE_DIAGNOSTICS_SERVICE_ISSUER must use the production API origin"
diagnostics_service_key_id="$(env_value "${api_env}" CHALK_EPISODE_DIAGNOSTICS_SERVICE_KEY_ID)"
diagnostics_service_verification_keys="$(env_value "${api_env}" CHALK_EPISODE_DIAGNOSTICS_SERVICE_VERIFICATION_KEYS)"
jq -e --arg key "${diagnostics_service_key_id}" 'type == "object" and length > 0 and (.[$key] | type == "string" and length > 0)' <<<"${diagnostics_service_verification_keys}" >/dev/null 2>&1 || fail "CHALK_EPISODE_DIAGNOSTICS_SERVICE_VERIFICATION_KEYS must contain the current service key ID"
[[ "$(env_value "${sync_env}" CHALK_API_URL)" == https://api.chalkmeet.com ]] || fail "CHALK_API_URL must use the production API origin"
[[ "$(env_value "${sync_env}" CHALK_SYNC_DIAGNOSTICS_ALLOWED_HOSTS)" == api.chalkmeet.com ]] || fail "CHALK_SYNC_DIAGNOSTICS_ALLOWED_HOSTS must allow only the production API host"
sync_generation="$(env_value "${sync_env}" CHALK_SYNC_GENERATION)"
if [[ ! "${sync_generation}" =~ ^[1-9][0-9]*$ ]] || (( sync_generation > 2147483648 )); then
  fail "CHALK_SYNC_GENERATION must be an integer between 1 and 2147483648"
fi
sync_release_id="$(env_value "${sync_env}" CHALK_SYNC_RELEASE_ID)"
[[ "${sync_release_id}" =~ ^[A-Za-z0-9][A-Za-z0-9._:@+=-]{0,127}$ ]] || fail "CHALK_SYNC_RELEASE_ID must be a safe bounded identifier"
sync_source_commit="$(env_value "${sync_env}" CHALK_SYNC_SOURCE_COMMIT)"
[[ "${sync_source_commit}" =~ ^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$ ]] || fail "CHALK_SYNC_SOURCE_COMMIT must be a safe bounded identifier"
sync_instance_id="$(env_value "${sync_env}" CHALK_SYNC_INSTANCE_ID)"
[[ "${sync_instance_id}" =~ ^[A-Za-z0-9][A-Za-z0-9._:@+/=-]{0,127}$ ]] || fail "CHALK_SYNC_INSTANCE_ID must be a safe bounded identifier"
expected_sync_resource_attributes="service.name=chalk-sync,service.version=${sync_release_id},deployment.environment.name=production,service.instance.id=${sync_instance_id}"
[[ "$(env_value "${sync_env}" OTEL_RESOURCE_ATTRIBUTES)" == "${expected_sync_resource_attributes}" ]] || fail "OTEL_RESOURCE_ATTRIBUTES must bind Sync telemetry to its production service, release, and instance"
[[ "$(env_value "${api_env}" CHALK_API_ADDR)" == 0.0.0.0:8080 ]] || fail "CHALK_API_ADDR must match the Quadlet port"
[[ "$(env_value "${sync_env}" PORT)" == 4100 ]] || fail "Sync PORT must match the Quadlet port"
[[ "$(env_value "${api_env}" CHALK_REDIS_URL)" == redis://redis:6379/0 ]] || fail "CHALK_REDIS_URL must use the private Redis network alias"
[[ "$(env_value "${sync_env}" CHALK_SYNC_PROVIDER_BRIDGE_URL)" == https://chalk-api:8443 ]] || fail "Sync provider bridge URL must use the private API alias"
for file in "${api_env}" "${sync_env}"; do
  database_url="$(env_value "${file}" CHALK_DATABASE_URL)"
  [[ "${database_url}" =~ ^postgres(ql)?:// ]] || fail "CHALK_DATABASE_URL must be a PostgreSQL URL"
  [[ "${database_url}" == *'sslmode=verify-full'* ]] || fail "CHALK_DATABASE_URL must use sslmode=verify-full"
done
fi

certificates=(
  provider-bridge/api-server.crt
  provider-bridge/sync-client-ca.crt
  provider-bridge/sync-client.crt
  provider-bridge/api-server-ca.crt
)
keys=(provider-bridge/api-server.key provider-bridge/sync-client.key)
for relative in "${certificates[@]}"; do
  file="${secret_root}/${relative}"
  case "${relative}" in
    provider-bridge/api-server.crt) input_id=provider-bridge-api-server-cert ;;
    provider-bridge/sync-client-ca.crt) input_id=provider-bridge-sync-client-ca ;;
    provider-bridge/sync-client.crt) input_id=provider-bridge-sync-client-cert ;;
    provider-bridge/api-server-ca.crt) input_id=provider-bridge-api-server-ca ;;
  esac
  if is_excluded "${input_id}" && input_is_absent "${file}"; then
    continue
  fi
  secure_regular_file "${file}"
  openssl x509 -in "${file}" -noout >/dev/null 2>&1 || fail "invalid X.509 input: ${file}"
done
for relative in "${keys[@]}"; do
  file="${secret_root}/${relative}"
  case "${relative}" in
    provider-bridge/api-server.key) input_id=provider-bridge-api-server-key ;;
    provider-bridge/sync-client.key) input_id=provider-bridge-sync-client-key ;;
  esac
  if is_excluded "${input_id}" && input_is_absent "${file}"; then
    continue
  fi
  secure_regular_file "${file}"
  openssl pkey -in "${file}" -noout >/dev/null 2>&1 || fail "invalid private-key input: ${file}"
done
if ! input_is_absent "${secret_root}/provider-bridge/api-server.crt" && ! input_is_absent "${secret_root}/provider-bridge/api-server.key"; then
  certificate_matches_private_key "${secret_root}/provider-bridge/api-server.crt" "${secret_root}/provider-bridge/api-server.key"
fi
if ! input_is_absent "${secret_root}/provider-bridge/sync-client.crt" && ! input_is_absent "${secret_root}/provider-bridge/sync-client.key"; then
  certificate_matches_private_key "${secret_root}/provider-bridge/sync-client.crt" "${secret_root}/provider-bridge/sync-client.key"
fi
if ! is_excluded cloudflare-tunnel-token || ! input_is_absent "${secret_root}/cloudflare/tunnel-token"; then
  secure_regular_file "${secret_root}/cloudflare/tunnel-token"
fi

secure_regular_file "${sync_proof}"
jq -e '
  .schema_version == 1 and
  .provider == "planetscale-postgresql" and
  .postgresql_major == 18 and
  .connection_mode == "direct" and
  .role_query_supported == true and
  .pg_stat_replication_visible == true and
  .synchronous_standby_names_configured == true and
  .synchronous_standbys >= 1 and
  (.evidence_id | type == "string" and length > 0) and
  (.verified_at | type == "string" and length > 0)
' "${sync_proof}" >/dev/null || fail "PlanetScale does not have an accepted Sync production-probe proof"

[[ -f "${manifest}" && ! -L "${manifest}" ]] || fail "release manifest is not a regular file"
image_pattern='^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$'
for component in api sync redis cloudflared; do
  image="$(jq -er ".images.${component}" "${manifest}")" || fail "manifest is missing the ${component} image"
  [[ "${image}" =~ ${image_pattern} ]] || fail "manifest ${component} image is not digest-addressed"
done
manifest_schema_version="$(jq -er '.schema_version' "${manifest}")" || fail "release manifest schema version is missing"
case "${manifest_schema_version}" in
  1)
    jq -e '
      .schema_version == 1 and
      (.architectures == ["linux/arm64"] or .architectures == ["linux/amd64", "linux/arm64"]) and
      (.database_compatibility.engine == "postgresql" and .database_compatibility.major == 18 and (.database_compatibility.minimum_migration | type == "number" and . >= 20260713130000) and .database_compatibility.maximum_migration == null) and
      .protocol_compatibility.sync == 1
    ' "${manifest}" >/dev/null || fail "release manifest v1 compatibility contract is invalid"
    ;;
  2)
    jq -e '
      .schema_version == 2 and
      (.architectures == ["linux/arm64"] or .architectures == ["linux/amd64", "linux/arm64"]) and
      (.affected_components | type == "array" and length >= 1 and length <= 2 and unique == . and (length == 1 or . == ["api", "sync"]) and all(.[]; . == "api" or . == "sync")) and
      (.component_releases | type == "object" and (keys | sort) == ["api", "sync"] and all(.[]; type == "object" and (keys | sort) == ["release_id", "source_revision"] and (.release_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:@+=-]{0,127}$")) and (.source_revision | test("^[0-9a-f]{40}$")))) and
      (.database_compatibility.engine == "postgresql" and .database_compatibility.major == 18 and (.database_compatibility.minimum_migration | type == "number" and . >= 20260713130000) and .database_compatibility.maximum_migration == null) and
      .protocol_compatibility.sync == 1
    ' "${manifest}" >/dev/null || fail "release manifest v2 component compatibility contract is invalid"
    ;;
  *)
    fail "release manifest schema version is unsupported"
    ;;
esac
manifest_api_release_id="$(jq -er 'if .schema_version == 2 then .component_releases.api.release_id else .release_id end' "${manifest}")" || fail "release manifest API identity is invalid"
manifest_sync_release_id="$(jq -er 'if .schema_version == 2 then .component_releases.sync.release_id else .release_id end' "${manifest}")" || fail "release manifest Sync identity is invalid"
manifest_sync_source_revision="$(jq -er 'if .schema_version == 2 then .component_releases.sync.source_revision else .source_revision end' "${manifest}")" || fail "release manifest Sync source revision is invalid"
[[ "${manifest_api_release_id}" =~ ^[A-Za-z0-9][A-Za-z0-9._:@+=-]{0,127}$ ]] || fail "release manifest API identity is unsafe"
[[ "${manifest_sync_release_id}" =~ ^[A-Za-z0-9][A-Za-z0-9._:@+=-]{0,127}$ ]] || fail "release manifest Sync identity is unsafe"
[[ "${manifest_sync_source_revision}" =~ ^[0-9a-f]{40}$ ]] || fail "release manifest Sync source revision is unsafe"
if [[ "${api_available}" == true ]]; then
  [[ "$(env_value "${api_env}" CHALK_API_VERSION)" == "${manifest_api_release_id}" ]] || fail "API telemetry release identifier does not match the release manifest"
fi
if [[ "${sync_available}" == true ]]; then
  sync_release_id="$(env_value "${sync_env}" CHALK_SYNC_RELEASE_ID)"
  sync_source_commit="$(env_value "${sync_env}" CHALK_SYNC_SOURCE_COMMIT)"
  [[ "${sync_release_id}" == "${manifest_sync_release_id}" ]] || fail "Sync telemetry release identifier does not match the release manifest"
  [[ "${sync_source_commit}" == "${manifest_sync_source_revision}" ]] || fail "Sync telemetry source commit does not match the release manifest"
fi
if [[ "${allow_dirty}" != true && "$(jq -r '.source_tree_state' "${manifest}")" != clean ]]; then
  fail "dirty source manifests cannot be promoted"
fi

while IFS=$'\t' read -r relative expected; do
  [[ "${relative}" != /* && "${relative}" != *'..'* ]] || fail "manifest contains an unsafe artifact path"
  file="${managed_root}/${relative}"
  [[ -f "${file}" ]] || fail "manifest artifact is missing: ${relative}"
  if command -v sha256sum >/dev/null; then
    actual="$(sha256sum "${file}" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "${file}" | awk '{print $1}')"
  fi
  [[ "${actual}" == "${expected}" ]] || fail "manifest artifact digest mismatch: ${relative}"
done < <(jq -r '.runtime_artifacts | to_entries[] | [.key, .value] | @tsv' "${manifest}")

jq -e '
  .schema_version == 1 and .management == "remote" and .environment == "production" and
  .routes == [
    {hostname:"api.chalkmeet.com", service:"http://chalk-api:8080"},
    {hostname:"sync.chalkmeet.com", service:"http://chalk-sync:4100", websocket:true},
    {service:"http_status:404"}
  ]
' "${managed_root}/cloudflare/ingress.production.json" >/dev/null || fail "Cloudflare ingress contract is invalid"

if [[ -n "${rendered_root}" ]]; then
  for file in chalk-api.container chalk-sync.container chalk-redis.container chalk-cloudflared.container; do
    [[ -f "${rendered_root}/quadlet/${file}" ]] || fail "rendered Quadlet is missing: ${file}"
    grep -Eq '^Image=[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$' "${rendered_root}/quadlet/${file}" || fail "rendered Quadlet image is not immutable: ${file}"
    ! grep -q '__' "${rendered_root}/quadlet/${file}" || fail "rendered Quadlet contains a placeholder: ${file}"
  done
  migration_target="$(jq -er '.database_compatibility.minimum_migration | numbers' "${manifest}")" || fail "manifest migration target is invalid"
  [[ "${migration_target}" =~ ^[0-9]{14}$ ]] || fail "manifest migration target is invalid"
  migration_unit="${rendered_root}/quadlet/chalk-api-migrate.container"
  [[ -f "${migration_unit}" && ! -L "${migration_unit}" ]] || fail "rendered migration Quadlet is missing"
  grep -Fqx "Image=$(jq -er '.images.api' "${manifest}")" "${migration_unit}" || fail "migration Quadlet image does not match the API image"
  grep -Fqx 'PodmanArgs=--entrypoint=/usr/local/bin/chalk-migrate' "${migration_unit}" || fail "migration Quadlet does not select the migration binary"
  grep -Fqx "Exec=--database-url-file /run/chalk/migrate/database-url --target ${migration_target} --allow-missing-version 20260819120000" "${migration_unit}" || fail "migration Quadlet target or bounded repair is not bound to the manifest"
  grep -Fq 'Secret=chalk-managed-migrator-database-url,' "${migration_unit}" || fail "migration Quadlet does not mount the dedicated migrator credential"
  ! grep -Fq 'chalk-managed-migrator-database-url' "${rendered_root}/quadlet/chalk-api.container" || fail "API Quadlet exposes the dedicated migrator credential"
  ! grep -Fq 'chalk-managed-migrator-database-url' "${rendered_root}/quadlet/chalk-sync.container" || fail "Sync Quadlet exposes the dedicated migrator credential"
  [[ -f "${rendered_root}/quadlet/chalk-runtime.network" ]] || fail "rendered network Quadlet is missing"
  [[ -f "${rendered_root}/systemd/chalk-runtime.target" ]] || fail "rendered runtime target is missing"
  expected_rendered_root="$(mktemp -d)"
  trap 'rm -rf "${expected_rendered_root}"' EXIT
  "${managed_root}/scripts/render-runtime" "${manifest}" "${expected_rendered_root}" >/dev/null
  diff -qr "${expected_rendered_root}/quadlet" "${rendered_root}/quadlet" >/dev/null || fail "rendered Quadlets differ from the release templates"
  diff -qr "${expected_rendered_root}/systemd" "${rendered_root}/systemd" >/dev/null || fail "rendered systemd units differ from the release templates"
  cmp -s "${expected_rendered_root}/release-manifest.json" "${rendered_root}/release-manifest.json" || fail "rendered release manifest differs from the promoted manifest"
fi

echo "PASS runtime inputs, release manifest, route contract, and rendered units"

#!/usr/bin/env bash
set -euo pipefail

managed_root="$(cd "$(dirname "$0")/.." && pwd)"
fixture="$(mktemp -d)"
trap 'rm -rf "$fixture"' EXIT

# Stop at the Sync input so this exercises the real staging check without any secrets.
sed -E 's/__[A-Z0-9_]+__/fixture/g' "$managed_root/env/api.env.example" > "$fixture/full.env"
fixture_api="$fixture/api.env"
fixture_manifest="$fixture/manifest.json"
cat >"$fixture/controller.env" <<'EOF'
CHALK_SFU_WINDOW_ENVIRONMENT=production
CHALK_SFU_WINDOW_MODE=scale
CHALK_SFU_WINDOW_DATABASE_URL=postgresql://controller@db.example/chalk?sslmode=verify-full
CHALK_SFU_APPLICATION_ID=fixture-application
CHALK_SFU_SERVER_NAME=sfu.example
CHALK_SFU_CA_FILE=/home/chalk-sfu-window/secrets/client-ca.crt
CHALK_SFU_CLIENT_CERT_FILE=/home/chalk-sfu-window/secrets/server.crt
CHALK_SFU_CLIENT_KEY_FILE=/home/chalk-sfu-window/secrets/server.key
CHALK_SFU_WINDOW_PROVIDER_TOKEN=fixture-provider-token
CHALK_SFU_WINDOW_SNAPSHOT_ID=123456
CHALK_SFU_WINDOW_REVISION=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
CHALK_SFU_WINDOW_REGION=sgp1
CHALK_SFU_WINDOW_VPC_UUID=123e4567-e89b-42d3-a456-426614174000
CHALK_SFU_WINDOW_FIREWALL_ID=123e4567-e89b-42d3-a456-426614174001
CHALK_SFU_WINDOW_STANDING_SLOTS=8
EOF
chmod 600 "$fixture/controller.env"
check_refusal() {
  local reason="$1" output
  chmod 600 "$fixture_api"
  if output="$("$managed_root/scripts/validate-runtime" --env-root "$fixture" --sfu-window-env "$fixture/controller.env" --secret-root "$fixture" --manifest "$fixture_manifest" --sync-proof "$fixture/not-needed" 2>&1)"; then
    echo "Expected refusal: $reason" >&2
    exit 1
  fi
  [[ "$output" == *"$reason"* ]] || { printf 'Expected %s; got %s\n' "$reason" "$output" >&2; exit 1; }
}

grep -v '^CHALK_SFU_' "$fixture/full.env" > "$fixture_api"
printf '{"database_compatibility":{"minimum_migration":20261120073000}}\n' > "$fixture_manifest"
check_refusal 'sync.env'
printf '{"database_compatibility":{"minimum_migration":20261121120000}}\n' > "$fixture_manifest"
check_refusal 'CHALK_SFU_ENABLED must be true'
printf 'CHALK_SFU_ENABLED=true\n' >> "$fixture_api"
check_refusal 'CHALK_SFU_APPLICATION_ID must occur'

# Recording without a capture flag stops every new Recording, so history-only has to be chosen.
sed 's/^CHALK_RECORDING_ENABLED=false$/CHALK_RECORDING_ENABLED=true/' "$fixture/full.env" > "$fixture_api"
check_refusal 'stops every new Recording'
printf 'CHALK_SFU_CAPTURE_ENABLED=false\n' >> "$fixture_api"
check_refusal 'stops every new Recording'
printf 'CHALK_RECORDING_HISTORY_ONLY=true\n' >> "$fixture_api"
check_refusal 'sync.env'
printf 'CHALK_SFU_COLOCATED_CAPTURE=ON\n' >> "$fixture_api"
check_refusal 'CHALK_SFU_COLOCATED_CAPTURE needs CHALK_SFU_CAPTURE_ENABLED=true'
sed 's/^CHALK_SFU_CAPTURE_ENABLED=false$/CHALK_SFU_CAPTURE_ENABLED=1/' "$fixture_api" > "$fixture/colocated.env"
cp "$fixture/colocated.env" "$fixture_api"
check_refusal 'CHALK_RECORDING_HISTORY_ONLY conflicts with CHALK_SFU_CAPTURE_ENABLED=true'
grep -v '^CHALK_RECORDING_HISTORY_ONLY=' "$fixture_api" > "$fixture/capture.env"
cp "$fixture/capture.env" "$fixture_api"
check_refusal 'sync.env'

# The previous release still reads these, and a workflow rollback runs it against the current inputs.
for legacy in CHALK_DEFAULT_MEDIA_PLANE CHALK_PUBLIC_INVITE_DEFAULT_MEDIA_PLANE CHALK_CLOUDFLARE_REALTIME_APP_ID CHALK_CLOUDFLARE_REALTIME_APP_SECRET; do
  grep -v "^$legacy=" "$fixture/full.env" > "$fixture_api"
  check_refusal "$legacy"
done
sed 's/^CHALK_DEFAULT_MEDIA_PLANE=cf_sfu$/CHALK_DEFAULT_MEDIA_PLANE=other/' "$fixture/full.env" > "$fixture_api"
check_refusal 'CHALK_DEFAULT_MEDIA_PLANE must stay cf_sfu or chalk_sfu'
sed 's/^CHALK_PUBLIC_INVITE_DEFAULT_MEDIA_PLANE=cf_sfu$/CHALK_PUBLIC_INVITE_DEFAULT_MEDIA_PLANE=other/' "$fixture/full.env" > "$fixture_api"
check_refusal 'CHALK_PUBLIC_INVITE_DEFAULT_MEDIA_PLANE must stay cf_sfu or chalk_sfu'
sed 's/^CHALK_DEFAULT_MEDIA_PLANE=cf_sfu$/CHALK_DEFAULT_MEDIA_PLANE=chalk_sfu/' "$fixture/full.env" | grep -v '^CHALK_SFU_CAPTURE_ENABLED=' > "$fixture_api"
check_refusal 'CHALK_DEFAULT_MEDIA_PLANE=chalk_sfu needs CHALK_SFU_CAPTURE_ENABLED=true'
grep -v '^CHALK_CLOUDFLARE_TURN_KEY_ID=' "$fixture/full.env" > "$fixture_api"
check_refusal 'CHALK_CLOUDFLARE_TURN_KEY_ID'
# Only production keeps a rollback target: nightly may drop the legacy settings.
grep -v -e '^CHALK_DEFAULT_MEDIA_PLANE=' -e '^CHALK_PUBLIC_INVITE_DEFAULT_MEDIA_PLANE=' -e '^CHALK_CLOUDFLARE_' "$fixture/full.env" | sed 's/^CHALK_API_ENV=production$/CHALK_API_ENV=nightly/' > "$fixture_api"
check_refusal 'sync.env'

for value in true yes on 1 ' YES '; do
  sed "s/^CHALK_SFU_ENABLED=true$/CHALK_SFU_ENABLED=$value/" "$fixture/full.env" > "$fixture_api"
  check_refusal 'sync.env'
done
sed 's/^CHALK_SFU_ENABLED=true$/CHALK_SFU_ENABLED=false/' "$fixture/full.env" > "$fixture_api"
check_refusal 'CHALK_SFU_ENABLED must be true'

for flag in CHALK_SFU_COLOCATED_CAPTURE CHALK_SFU_CAPTURE_ENABLED CHALK_SFU_ENABLED CHALK_RECORDING_HISTORY_ONLY; do
  grep -v "^$flag=" "$fixture/full.env" > "$fixture_api"
  printf '%s=true\n%s=true\n' "$flag" "$flag" >> "$fixture_api"
  check_refusal "$flag must occur at most once"
done
cp "$fixture/controller.env" "$fixture/controller.valid"
grep -v '^CHALK_SFU_WINDOW_MODE=' "$fixture/controller.valid" > "$fixture/controller.env"
check_refusal 'CHALK_SFU_WINDOW_MODE must occur'
sed 's/^CHALK_SFU_WINDOW_MODE=scale$/CHALK_SFU_WINDOW_MODE=destroy/' "$fixture/controller.valid" > "$fixture/controller.env"
check_refusal 'CHALK_SFU_WINDOW_MODE must be scale or retire'
sed 's|^CHALK_SFU_CA_FILE=.*|CHALK_SFU_CA_FILE=/tmp/client-ca.crt|' "$fixture/controller.valid" > "$fixture/controller.env"
check_refusal 'CHALK_SFU_CA_FILE must use the managed controller CA path'
sed 's/^CHALK_SFU_WINDOW_STANDING_SLOTS=8$/CHALK_SFU_WINDOW_STANDING_SLOTS=41/' "$fixture/controller.valid" > "$fixture/controller.env"
check_refusal 'CHALK_SFU_WINDOW_STANDING_SLOTS must be 1 to 40'
cp "$fixture/controller.valid" "$fixture/controller.env"
printf 'CHALK_SFU_WINDOW_BUDGET_NODE_HOURS=01000\n' >> "$fixture/controller.env"
check_refusal 'CHALK_SFU_WINDOW_BUDGET_NODE_HOURS must be 1 to 930'
cp "$fixture/controller.valid" "$fixture/controller.env"
printf 'CHALK_SFU_WINDOW_BUDGET_NODE_HOURS=10\nCHALK_SFU_WINDOW_BUDGET_NODE_HOURS=20\n' >> "$fixture/controller.env"
check_refusal 'CHALK_SFU_WINDOW_BUDGET_NODE_HOURS must occur at most once'
mv "$fixture/controller.valid" "$fixture/controller.env"
chmod 600 "$fixture/controller.env"
echo 'PASS managed Chalk SFU runtime input contract'

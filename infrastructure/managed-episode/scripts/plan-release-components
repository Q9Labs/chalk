#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: plan-release-components [--component api|sync|both|shared|redis|none] [--runtime-dependency] [changed-path ...]" >&2
  echo "       echo changed-path | plan-release-components" >&2
}

fail() {
  echo "$1" >&2
  exit 1
}

command -v jq >/dev/null || fail "jq is required"

explicit_components=()
explicit_components_present=false
paths=()
paths_present=false
runtime_dependency=false
while (($# > 0)); do
  case "$1" in
    --component)
      case "${2:-}" in
        api|sync|both|shared|redis|none)
          explicit_components+=("$2")
          explicit_components_present=true
          ;;
        *) fail "unknown component: ${2:-}" ;;
      esac
      shift 2
      ;;
    --runtime-dependency)
      runtime_dependency=true
      shift
      ;;
    --)
      shift
      if (($# > 0)); then
        paths+=("$@")
        paths_present=true
      fi
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      fail "unknown option: $1"
      ;;
    *)
      paths+=("$1")
      paths_present=true
      shift
      ;;
  esac
done

if [[ "${paths_present}" == false ]] && [[ ! -t 0 ]]; then
  while IFS= read -r path; do
    if [[ -n "${path}" ]]; then
      paths+=("${path}")
      paths_present=true
    fi
  done
fi

classifications=()
classification_count=0
runtime_path_changed=false
add_classification() {
  classifications+=("$1")
  classification_count=$((classification_count + 1))
}
classify_path() {
  local path="$1"
  case "${path}" in
    apps/api/internal/recordernodebootstrap/attestation.go|apps/api/internal/recordernodebootstrap/attestation_test.go)
      # These files are compiled into the recorder-node-bootstrap binary in the
      # CPU worker image; they are not imported by the managed API service.
      add_classification none
      ;;
    apps/api|apps/api/*|infrastructure/managed-episode/images/api.Dockerfile)
      add_classification api
      ;;
    apps/sync|apps/sync/*|infrastructure/managed-episode/images/sync.Dockerfile)
      add_classification sync
      ;;
    infrastructure/managed-episode/quadlet/chalk-redis.container.in)
      add_classification shared
      runtime_path_changed=true
      ;;
    infrastructure/managed-episode/env/api.env.example|infrastructure/managed-episode/scripts/validate-api-runtime|infrastructure/managed-episode/scripts/test-api-config)
      add_classification api
      ;;
    infrastructure/managed-episode/env/sync.env.example|infrastructure/managed-episode/scripts/validate-sync-runtime)
      add_classification sync
      ;;
    infrastructure/managed-episode/scripts/plan-release-components|infrastructure/managed-episode/scripts/validate-runtime)
      add_classification none
      ;;
    infrastructure/managed-episode/README.md|infrastructure/managed-episode/scripts/generate-release-manifest|infrastructure/managed-episode/contracts/release-manifest.schema.json|infrastructure/managed-episode/controller/chalk-deployment-controller|infrastructure/managed-episode/scripts/test-deployment-controller|infrastructure/recorder/README.md|infrastructure/recorder/images/cpu/*)
      add_classification none
      ;;
    infrastructure/managed-episode/*)
      add_classification shared
      ;;
    .github/workflows/ci.yml|CHANGELOG.md|GLOSSARY.md|package.json|pnpm-lock.yaml|pnpm-workspace.yaml|product.yaml|contract|contract/*|packages|packages/*|sdks|sdks/*|apps/web|apps/web/*|apps/docs|apps/docs/*|apps/mobile|apps/mobile/*|scripts/dev|scripts/dev/*)
      add_classification none
      ;;
    *)
      add_classification unknown
      ;;
  esac
}

if [[ "${explicit_components_present}" == true ]]; then
  for component in "${explicit_components[@]}"; do
    case "${component}" in
      api) add_classification api ;;
      sync) add_classification sync ;;
      both|shared) add_classification shared ;;
      redis)
        add_classification shared
        runtime_dependency=true
        ;;
      none) add_classification none ;;
    esac
  done
fi
if [[ "${paths_present}" == true ]]; then
  for path in "${paths[@]}"; do
    classify_path "${path}"
  done
fi
if ((classification_count == 0)) && [[ "${runtime_dependency}" == true ]]; then
  add_classification shared
fi
((classification_count > 0)) || fail "at least one component or changed path is required"

has_api=false
has_sync=false
has_shared=false
has_redis=false
has_none=false
has_unknown=false
for classification in "${classifications[@]}"; do
  case "${classification}" in
    api) has_api=true ;;
    sync) has_sync=true ;;
    shared) has_shared=true ;;
    none) has_none=true ;;
    unknown) has_unknown=true ;;
    *) fail "cannot classify component: ${classification}" ;;
  esac
done
if [[ "${runtime_dependency}" == true || "${runtime_path_changed}" == true ]]; then
  has_redis=true
fi
if [[ "${has_unknown}" == true ]]; then
  has_shared=true
fi

affected_components_json='["api"]'
build_set_json='["api"]'
restart_components_json='["api"]'
restart_units_json='["chalk-api.service"]'
classification="api"

if [[ "${has_shared}" == true || ("${has_api}" == true && "${has_sync}" == true) ]]; then
  classification="both"
  affected_components_json='["api","sync"]'
  build_set_json='["api","sync"]'
  restart_components_json='["api","sync"]'
  restart_units_json='["chalk-api.service","chalk-sync.service"]'
elif [[ "${has_sync}" == true ]]; then
  classification="sync"
  affected_components_json='["sync"]'
  build_set_json='["sync"]'
  restart_components_json='["sync"]'
  restart_units_json='["chalk-sync.service"]'
elif [[ "${has_none}" == true && "${has_api}" == false && "${has_sync}" == false ]]; then
  classification="none"
  affected_components_json='[]'
  build_set_json='[]'
  restart_components_json='[]'
  restart_units_json='[]'
fi

if [[ "${has_redis}" == true ]]; then
  # Redis is a runtime dependency, not a separately built release component.
  case "${classification}" in
    api)
      restart_components_json='["redis","api"]'
      restart_units_json='["chalk-redis.service","chalk-api.service"]'
      ;;
    sync)
      restart_components_json='["redis","sync"]'
      restart_units_json='["chalk-redis.service","chalk-sync.service"]'
      ;;
    both)
      restart_components_json='["redis","api","sync"]'
      restart_units_json='["chalk-redis.service","chalk-api.service","chalk-sync.service"]'
      ;;
  esac
fi

jq -n \
  --arg classification "${classification}" \
  --argjson affected_components "${affected_components_json}" \
  --argjson build_set "${build_set_json}" \
  --argjson restart_components "${restart_components_json}" \
  --argjson restart_closure "${restart_units_json}" \
  --argjson runtime_dependency_changed "${has_redis}" \
  --argjson unknown_paths "${has_unknown}" \
  '{
    classification: $classification,
    affected_components: $affected_components,
    build_set: $build_set,
    restart_components: $restart_components,
    restart_closure: $restart_closure,
    runtime_dependency_changed: $runtime_dependency_changed,
    unknown_paths: $unknown_paths
  }'

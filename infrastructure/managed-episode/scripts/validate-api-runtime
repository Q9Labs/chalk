#!/usr/bin/env bash
set -euo pipefail

api_env=""
usage() {
  echo "usage: validate-api-runtime --env-file <api.env>" >&2
}

while (($# > 0)); do
  case "$1" in
    --env-file) api_env="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

[[ -n "${api_env}" ]] || { usage; exit 2; }

fail() {
  echo "FAIL $1" >&2
  exit 1
}

secure_regular_file() {
  local file="$1"
  [[ -f "${file}" && ! -L "${file}" ]] || fail "required input is not a regular file: ${file}"
  [[ -s "${file}" ]] || fail "required input is empty: ${file}"
  local mode
  if stat -f '%Lp' "${file}" >/dev/null 2>&1; then
    mode="$(stat -f '%Lp' "${file}")"
  else
    mode="$(stat -c '%a' "${file}")"
  fi
  if ((8#${mode} & 077)); then
    fail "required input must not grant group or other permissions: ${file}"
  fi
}

env_value() {
  local file="$1"
  local name="$2"
  awk -v name="${name}" '
    index($0, name "=") == 1 { count++; value=substr($0, length(name) + 2) }
    END { if (count == 1 && length(value) > 0) print value; else exit 1 }
  ' "${file}"
}

require_env() {
  local name="$1"
  env_value "${api_env}" "${name}" >/dev/null || fail "${name} must occur exactly once with a non-empty value in ${api_env}"
}

env_enabled() {
  case "$(env_value "${api_env}" "$1" | awk '{sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); print tolower($0)}')" in
    true|yes|on|1) return 0 ;;
    *) return 1 ;;
  esac
}

secure_regular_file "${api_env}"
if grep -Eq '__[A-Z0-9_]+__' "${api_env}"; then
  fail "API environment contains unresolved placeholders"
fi

duplicate_flag="$(awk -F= '
  { key = $1; sub(/^[[:space:]]+/, "", key); sub(/[[:space:]]+$/, "", key) }
  NF > 1 && key ~ /^CHALK_SFU_(ENABLED|CAPTURE_ENABLED|COLOCATED_CAPTURE|NEW_EPISODES|NODES)$|^CHALK_RECORDING_HISTORY_ONLY$/ && ++seen[key] == 2 { print key; exit }
' "${api_env}")"
[[ -z "${duplicate_flag}" ]] || fail "${duplicate_flag} must occur at most once"

env_enabled CHALK_SFU_ENABLED || fail "CHALK_SFU_ENABLED must be true (true, yes, on, or 1)"
for name in CHALK_SFU_APPLICATION_ID CHALK_SFU_NODES CHALK_SFU_SERVER_NAME CHALK_SFU_CA_FILE CHALK_SFU_CLIENT_CERT_FILE CHALK_SFU_CLIENT_KEY_FILE; do
  require_env "$name"
done
nodes="$(env_value "${api_env}" CHALK_SFU_NODES | tr ',' '\n' | awk '{gsub(/[[:space:]]/, ""); if (length($0) > 0) n++} END {print n + 0}')"
((nodes > 0)) || fail "CHALK_SFU_NODES must name at least one node"
# New Episodes have no other media plane to fall back to, so a paused floor would refuse every new call.
if env_value "${api_env}" CHALK_SFU_NEW_EPISODES >/dev/null 2>&1 && ! env_enabled CHALK_SFU_NEW_EPISODES; then
  fail "CHALK_SFU_NEW_EPISODES must be unset or on: off refuses every new Episode"
fi
if env_enabled CHALK_SFU_COLOCATED_CAPTURE && ! env_enabled CHALK_SFU_CAPTURE_ENABLED; then
  fail "CHALK_SFU_COLOCATED_CAPTURE needs CHALK_SFU_CAPTURE_ENABLED=true"
fi
# Without a capture flag a Chalk SFU Episode cannot be recorded, so new Recordings fail with
# recording_capture_unsupported. Keeping only the history of old Recordings has to be said out loud.
if env_enabled CHALK_RECORDING_ENABLED; then
  if env_enabled CHALK_SFU_CAPTURE_ENABLED; then
    ! env_enabled CHALK_RECORDING_HISTORY_ONLY || fail "CHALK_RECORDING_HISTORY_ONLY conflicts with CHALK_SFU_CAPTURE_ENABLED=true"
  else
    env_enabled CHALK_RECORDING_HISTORY_ONLY || fail "CHALK_RECORDING_ENABLED=true without CHALK_SFU_CAPTURE_ENABLED=true stops every new Recording: set CHALK_SFU_CAPTURE_ENABLED=true, or CHALK_RECORDING_HISTORY_ONLY=true to keep only the history of existing Recordings"
  fi
fi

# A workflow rollback runs the previous release's images against the current inputs, and that release
# still reads the Cloudflare settings. Keep them until the release after this one has been promoted.
case "$(env_value "${api_env}" CHALK_DEFAULT_MEDIA_PLANE || true)" in
  cf_sfu) ;;
  chalk_sfu)
    env_enabled CHALK_SFU_CAPTURE_ENABLED || fail "CHALK_DEFAULT_MEDIA_PLANE=chalk_sfu needs CHALK_SFU_CAPTURE_ENABLED=true so the previous release still boots on rollback"
    ;;
  *) fail "CHALK_DEFAULT_MEDIA_PLANE must stay cf_sfu or chalk_sfu: a rollback to the previous release reads it" ;;
esac
require_env CHALK_PUBLIC_INVITE_DEFAULT_MEDIA_PLANE
require_env CHALK_CLOUDFLARE_REALTIME_APP_ID
require_env CHALK_CLOUDFLARE_REALTIME_APP_SECRET

# TURN can serve Chalk SFU peers on networks that cannot reach its public media port.
turn_key_set=false
turn_token_set=false
env_value "${api_env}" CHALK_CLOUDFLARE_TURN_KEY_ID >/dev/null && turn_key_set=true
env_value "${api_env}" CHALK_CLOUDFLARE_TURN_API_TOKEN >/dev/null && turn_token_set=true
[[ "${turn_key_set}" == "${turn_token_set}" ]] || fail "CHALK_CLOUDFLARE_TURN_KEY_ID and CHALK_CLOUDFLARE_TURN_API_TOKEN must be set together"
case "$(env_value "${api_env}" CHALK_API_ENV || true)" in
  nightly | production)
    require_env CHALK_CLOUDFLARE_TURN_KEY_ID
    require_env CHALK_CLOUDFLARE_TURN_API_TOKEN
    ;;
esac

echo "PASS API runtime contract"

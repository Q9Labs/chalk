#!/usr/bin/env bash
set -euo pipefail

managed_root="$(cd "$(dirname "$0")/.." && pwd)"
repo_root="$(cd "${managed_root}/../.." && pwd)"
fixture_root="$(mktemp -d)"
trap 'rm -rf "${fixture_root}"' EXIT

if grep -ERq '^(Entrypoint|LogOpt|Memory|NetworkAlias|StopSignal|StopTimeout)=' "${managed_root}/quadlet"; then
  echo "Quadlet templates use keys unsupported by the production Podman 4.9 generator" >&2
  exit 1
fi
for argument in --entrypoint=/usr/local/bin/cloudflared --log-opt=tag=chalk-api --memory=1g --network-alias=chalk-api --stop-signal=SIGTERM --stop-timeout=20; do
  grep -Fq "PodmanArgs=${argument}" "${managed_root}/quadlet/"* || { echo "missing production-compatible Quadlet argument: ${argument}" >&2; exit 1; }
done
grep -Fq "Exec=redis-server --save '\"\"' --appendonly no" "${managed_root}/quadlet/chalk-redis.container.in" || { echo "Redis persistence disablement is not generator-safe" >&2; exit 1; }
grep -Fq 'HealthCmd=["/usr/local/bin/chalk-healthcheck","http://127.0.0.1:8080/readyz"]' "${managed_root}/quadlet/chalk-api.container.in" || { echo "scratch API image healthcheck must use exec form" >&2; exit 1; }
grep -Fq 'Requires=network-online.target chalk-api.service' "${managed_root}/quadlet/chalk-sync.container.in" || { echo "Sync must hard-require the API unit" >&2; exit 1; }
grep -Fq 'Requires=network-online.target chalk-api.service chalk-sync.service' "${managed_root}/quadlet/chalk-cloudflared.container.in" || { echo "cloudflared must hard-require application units" >&2; exit 1; }
grep -Fq 'Requires=chalk-redis.service chalk-api.service chalk-sync.service chalk-cloudflared.service' "${managed_root}/systemd/chalk-runtime.target" || { echo "runtime target must fail closed on partial start" >&2; exit 1; }
grep -Fq 'After=network-online.target' "${managed_root}/systemd/chalk-runtime-restore.service" || { echo "restore unit must wait for network-online" >&2; exit 1; }
grep -Fq 'Before=chalk-runtime.target' "${managed_root}/systemd/chalk-runtime-restore.service" || { echo "restore unit must precede the runtime target" >&2; exit 1; }
if grep -Fqx 'ProtectKernelModules=true' "${managed_root}/systemd/chalk-runtime-watchdog.service"; then
  echo "watchdog uses a capability sandbox unsupported by the rootless production user manager" >&2
  exit 1
fi

mkdir -p "${fixture_root}/env" "${fixture_root}/secrets/provider-bridge" "${fixture_root}/secrets/cloudflare"

render_example_env() {
  local source="$1"
  local output="$2"
  sed -E \
    -e 's|__SECRET_PLANETSCALE_PGBOUNCER_URL_WITH_SSLMODE_VERIFY_FULL__|postgresql://test:test@pgbouncer.example.com:6432/chalk?sslmode=verify-full|' \
    -e 's|__SECRET_PLANETSCALE_DIRECT_URL_WITH_SSLMODE_VERIFY_FULL__|postgresql://test:test@primary.example.com:5432/chalk?sslmode=verify-full|' \
    -e 's|__SECRET_JSON_KEYRING__|{"test":"dGVzdA"}|' \
    -e 's|__SECRET_AT_LEAST_32_BYTES__|test-only-32-byte-workload-secret|' \
    -e 's|__SECRET_BASE64_32_BYTES__|MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=|' \
    -e 's|__SECRET_AXIOM_TRACE_OTLP_HEADERS__|authorization=test-trace-token,x-axiom-dataset=chalk-traces-test|' \
    -e 's|__SECRET_AXIOM_LOG_OTLP_HEADERS__|authorization=test-log-token,x-axiom-dataset=chalk-logs-test|' \
    -e 's|__SECRET_AXIOM_METRICS_OTLP_HEADERS__|authorization=test-metrics-token,x-axiom-metrics-dataset=chalk-metrics-test|' \
    -e 's|__SECRET_EPISODE_DIAGNOSTICS_HMAC_KEY_AT_LEAST_32_BYTES__|test-only-32-byte-diagnostics-key|' \
    -e 's|__SECRET_EPISODE_DIAGNOSTICS_OPERATOR_ISSUER_HTTPS_URL__|https://identity.example.test|' \
    -e 's|__SECRET_EPISODE_DIAGNOSTICS_OPERATOR_JWKS__|{"keys":[{"kty":"OKP","crv":"Ed25519","alg":"EdDSA","use":"sig","kid":"operator-1","x":"MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA"}]}|' \
    -e 's|__SECRET_EPISODE_DIAGNOSTICS_SERVICE_KEY_ID__|diagnostics-1|' \
    -e 's|__SECRET_EPISODE_DIAGNOSTICS_ED25519_PRIVATE_KEY__|MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMA|' \
    -e 's|__SECRET_EPISODE_DIAGNOSTICS_SERVICE_VERIFICATION_KEYS__|{"diagnostics-1":"MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA"}|' \
    -e 's|__SYNC_INSTANCE_ID__|sync-test-instance|' \
    -e 's|__SYNC_GENERATION__|1|' \
    -e 's|__RELEASE_ID__|test-release|' \
    -e 's|__SECRET[A-Z0-9_]*__|test-value|g' \
    "${source}" >"${output}"
}

render_example_env "${managed_root}/env/api.env.example" "${fixture_root}/env/api.env"
render_example_env "${managed_root}/env/sync.env.example" "${fixture_root}/env/sync.env"

openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj '/CN=chalk-runtime-test' \
  -keyout "${fixture_root}/test.key" -out "${fixture_root}/test.crt" >/dev/null 2>&1
for name in api-server.crt sync-client-ca.crt sync-client.crt api-server-ca.crt; do
  cp "${fixture_root}/test.crt" "${fixture_root}/secrets/provider-bridge/${name}"
done
for name in api-server.key sync-client.key; do
  cp "${fixture_root}/test.key" "${fixture_root}/secrets/provider-bridge/${name}"
done
printf 'test-only-tunnel-token\n' >"${fixture_root}/secrets/cloudflare/tunnel-token"

jq -n '{
  schema_version: 1,
  provider: "planetscale-postgresql",
  postgresql_major: 18,
  connection_mode: "direct",
  role_query_supported: true,
  pg_stat_replication_visible: true,
  synchronous_standby_names_configured: true,
  synchronous_standbys: 1,
  evidence_id: "test-only-evidence",
  verified_at: "2026-07-22T00:00:00Z"
}' >"${fixture_root}/sync-proof.json"
chmod 600 "${fixture_root}/env/"* "${fixture_root}/secrets/provider-bridge/"* \
  "${fixture_root}/secrets/cloudflare/tunnel-token" "${fixture_root}/sync-proof.json"

digest_a="$(printf 'a%.0s' {1..64})"
digest_b="$(printf 'b%.0s' {1..64})"
"${managed_root}/scripts/generate-release-manifest" \
  --api-image "ghcr.io/q9labs/chalk-api@sha256:${digest_a}" \
  --sync-image "ghcr.io/q9labs/chalk-sync@sha256:${digest_b}" \
  --output "${fixture_root}/release-manifest.json" \
  --source-revision "$(git -C "${repo_root}" rev-parse HEAD)" \
  --allow-dirty >/dev/null

"${managed_root}/scripts/render-runtime" \
  "${fixture_root}/release-manifest.json" "${fixture_root}/rendered" >/dev/null
"${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null

jq -e '
  .schema_version == 2 and
  .affected_components == ["api", "sync"] and
  (.component_releases | (keys | sort) == ["api", "sync"])
' "${fixture_root}/release-manifest.json" >/dev/null

component_digest="$(printf 'c%.0s' {1..64})"
"${managed_root}/scripts/generate-release-manifest" \
  --stable-manifest "${fixture_root}/release-manifest.json" \
  --affected-components api \
  --api-image "ghcr.io/q9labs/chalk-api@sha256:${component_digest}" \
  --output "${fixture_root}/api-release-manifest.json" \
  --source-revision "$(git -C "${repo_root}" rev-parse HEAD)" \
  --release-id "managed-episode-20260815T120000Z-$(git -C "${repo_root}" rev-parse --short=8 HEAD)-abcdef12" \
  --allow-dirty >/dev/null
jq -e --slurpfile stable "${fixture_root}/release-manifest.json" '
  .schema_version == 2 and .affected_components == ["api"] and
  .images.api == ("ghcr.io/q9labs/chalk-api@sha256:" + ("c" * 64)) and
  .images.sync == $stable[0].images.sync and
  .component_releases.sync == $stable[0].component_releases.sync and
  .component_releases.api != $stable[0].component_releases.api
' "${fixture_root}/api-release-manifest.json" >/dev/null

if "${managed_root}/scripts/generate-release-manifest" \
  --stable-manifest "${fixture_root}/release-manifest.json" \
  --affected-components sync,api \
  --api-image "ghcr.io/q9labs/chalk-api@sha256:${component_digest}" \
  --sync-image "ghcr.io/q9labs/chalk-sync@sha256:${digest_b}" \
  --output "${fixture_root}/unsorted-release-manifest.json" \
  --source-revision "$(git -C "${repo_root}" rev-parse HEAD)" \
  --allow-dirty >/dev/null 2>&1; then
  echo "unsorted affected components were accepted" >&2
  exit 1
fi
if "${managed_root}/scripts/generate-release-manifest" \
  --stable-manifest "${fixture_root}/release-manifest.json" \
  --affected-components api \
  --output "${fixture_root}/missing-image-release-manifest.json" \
  --source-revision "$(git -C "${repo_root}" rev-parse HEAD)" \
  --allow-dirty >/dev/null 2>&1; then
  echo "missing affected component image was accepted" >&2
  exit 1
fi

"${managed_root}/scripts/plan-release-components" apps/api/internal/httpapi/routes.go |
  jq -e '.classification == "api" and .build_set == ["api"] and .restart_closure == ["chalk-api.service"]' >/dev/null
"${managed_root}/scripts/plan-release-components" apps/sync/lib/chalk_sync/protocol.ex |
  jq -e '.classification == "sync" and .build_set == ["sync"] and .restart_closure == ["chalk-sync.service"]' >/dev/null
"${managed_root}/scripts/plan-release-components" --component shared |
  jq -e '.classification == "both" and .affected_components == ["api", "sync"]' >/dev/null
"${managed_root}/scripts/plan-release-components" --runtime-dependency --component api |
  jq -e '.build_set == ["api"] and .restart_closure == ["chalk-redis.service", "chalk-api.service"]' >/dev/null
"${managed_root}/scripts/plan-release-components" infrastructure/managed-episode/README.md |
  jq -e '.classification == "both" and .build_set == ["api", "sync"]' >/dev/null
"${managed_root}/scripts/plan-release-components" package.json |
  jq -e '.classification == "none" and .build_set == [] and .restart_closure == []' >/dev/null
"${managed_root}/scripts/plan-release-components" --component none |
  jq -e '.classification == "none" and .affected_components == []' >/dev/null
"${managed_root}/scripts/plan-release-components" unknown/path |
  jq -e '.classification == "both" and .unknown_paths == true and .build_set == ["api", "sync"]' >/dev/null
if "${managed_root}/scripts/plan-release-components" --component nope >/dev/null 2>&1; then
  echo "unknown component input was accepted" >&2
  exit 1
fi

cp -R "${fixture_root}/env" "${fixture_root}/weak-ops-token-env"
sed -i.bak 's/^CHALK_OPS_INGEST_TOKEN=.*/CHALK_OPS_INGEST_TOKEN=too-short/' \
  "${fixture_root}/weak-ops-token-env/api.env"
rm "${fixture_root}/weak-ops-token-env/api.env.bak"
if "${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/weak-ops-token-env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null 2>&1; then
  echo "weak CHALK_OPS_INGEST_TOKEN was accepted" >&2
  exit 1
fi

cp -R "${fixture_root}/env" "${fixture_root}/recording-env"
sed -i.bak 's/^CHALK_RECORDING_ENABLED=false$/CHALK_RECORDING_ENABLED=maybe/' \
  "${fixture_root}/recording-env/api.env"
rm "${fixture_root}/recording-env/api.env.bak"
if "${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/recording-env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null 2>&1; then
  echo "invalid recording capability flag was accepted" >&2
  exit 1
fi

for mutation in \
  'api.env|CHALK_EPISODE_DIAGNOSTICS=hosted|CHALK_EPISODE_DIAGNOSTICS=off' \
  'api.env|CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN=true|CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN=false' \
  'sync.env|CHALK_EPISODE_DIAGNOSTICS=hosted|CHALK_EPISODE_DIAGNOSTICS=off' \
  'sync.env|CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN=true|CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN=false' \
  'api.env|CHALK_RECORDING_ENABLED=false|CHALK_RECORDING_ENABLED=true' \
  'api.env|CHALK_TRANSCRIPTION_ENABLED=false|CHALK_TRANSCRIPTION_ENABLED=true'; do
  IFS='|' read -r file_name expected replacement <<<"${mutation}"
  rejected_env="${fixture_root}/rejected-$(printf '%s' "${file_name}-${replacement}" | tr -cs '[:alnum:]' '-')"
  cp -R "${fixture_root}/env" "${rejected_env}"
  sed -i.bak "s|^${expected}$|${replacement}|" "${rejected_env}/${file_name}"
  rm "${rejected_env}/${file_name}.bak"
  if "${managed_root}/scripts/validate-runtime" \
    --env-root "${rejected_env}" \
    --secret-root "${fixture_root}/secrets" \
    --manifest "${fixture_root}/release-manifest.json" \
    --sync-proof "${fixture_root}/sync-proof.json" \
    --rendered-root "${fixture_root}/rendered" \
    --allow-dirty >/dev/null 2>&1; then
    echo "invalid production runtime mutation was accepted: ${replacement}" >&2
    exit 1
  fi
done

cp -R "${fixture_root}/env" "${fixture_root}/mismatched-diagnostics-service-env"
sed -i.bak 's/^CHALK_EPISODE_DIAGNOSTICS_SERVICE_KEY_ID=.*/CHALK_EPISODE_DIAGNOSTICS_SERVICE_KEY_ID=other-key/' \
  "${fixture_root}/mismatched-diagnostics-service-env/sync.env"
rm "${fixture_root}/mismatched-diagnostics-service-env/sync.env.bak"
if "${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/mismatched-diagnostics-service-env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null 2>&1; then
  echo "mismatched API and Sync diagnostics service identities were accepted" >&2
  exit 1
fi

for missing_entry in \
  'api.env|CHALK_API_OTLP_ENDPOINT' \
  'api.env|OTEL_EXPORTER_OTLP_TRACES_HEADERS' \
  'api.env|OTEL_EXPORTER_OTLP_LOGS_HEADERS' \
  'api.env|OTEL_EXPORTER_OTLP_METRICS_HEADERS' \
  'sync.env|CHALK_SYNC_OTLP_ENDPOINT' \
  'sync.env|OTEL_EXPORTER_OTLP_TRACES_HEADERS'; do
  IFS='|' read -r file_name env_name <<<"${missing_entry}"
  missing_env="${fixture_root}/missing-$(printf '%s' "${file_name}-${env_name}" | tr -cs '[:alnum:]' '-')"
  cp -R "${fixture_root}/env" "${missing_env}"
  sed -i.bak "/^${env_name}=/d" "${missing_env}/${file_name}"
  rm "${missing_env}/${file_name}.bak"
  if "${managed_root}/scripts/validate-runtime" \
    --env-root "${missing_env}" \
    --secret-root "${fixture_root}/secrets" \
    --manifest "${fixture_root}/release-manifest.json" \
    --sync-proof "${fixture_root}/sync-proof.json" \
    --rendered-root "${fixture_root}/rendered" \
    --allow-dirty >/dev/null 2>&1; then
    echo "missing production observability input was accepted: ${env_name}" >&2
    exit 1
  fi
done

cp -R "${fixture_root}/env" "${fixture_root}/shared-axiom-signal-header-env"
trace_headers="$(sed -n 's/^OTEL_EXPORTER_OTLP_TRACES_HEADERS=//p' "${fixture_root}/env/api.env")"
sed -i.bak "s|^OTEL_EXPORTER_OTLP_LOGS_HEADERS=.*|OTEL_EXPORTER_OTLP_LOGS_HEADERS=${trace_headers}|" \
  "${fixture_root}/shared-axiom-signal-header-env/api.env"
rm "${fixture_root}/shared-axiom-signal-header-env/api.env.bak"
if "${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/shared-axiom-signal-header-env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null 2>&1; then
  echo "shared Axiom trace and log headers were accepted" >&2
  exit 1
fi

cp -R "${fixture_root}/env" "${fixture_root}/mismatched-axiom-trace-header-env"
sed -i.bak 's/^OTEL_EXPORTER_OTLP_TRACES_HEADERS=.*/OTEL_EXPORTER_OTLP_TRACES_HEADERS=test-other-trace-header/' \
  "${fixture_root}/mismatched-axiom-trace-header-env/sync.env"
rm "${fixture_root}/mismatched-axiom-trace-header-env/sync.env.bak"
if "${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/mismatched-axiom-trace-header-env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null 2>&1; then
  echo "mismatched API and Sync Axiom trace headers were accepted" >&2
  exit 1
fi

for endpoint_entry in 'api.env|CHALK_API_OTLP_ENDPOINT' 'sync.env|CHALK_SYNC_OTLP_ENDPOINT'; do
  IFS='|' read -r file_name env_name <<<"${endpoint_entry}"
  pathful_env="${fixture_root}/pathful-$(printf '%s' "${file_name}-${env_name}" | tr -cs '[:alnum:]' '-')"
  cp -R "${fixture_root}/env" "${pathful_env}"
  sed -i.bak "s|^${env_name}=.*|${env_name}=https://api.axiom.co/v1/traces|" "${pathful_env}/${file_name}"
  rm "${pathful_env}/${file_name}.bak"
  if "${managed_root}/scripts/validate-runtime" \
    --env-root "${pathful_env}" \
    --secret-root "${fixture_root}/secrets" \
    --manifest "${fixture_root}/release-manifest.json" \
    --sync-proof "${fixture_root}/sync-proof.json" \
    --rendered-root "${fixture_root}/rendered" \
    --allow-dirty >/dev/null 2>&1; then
    echo "pathful production OTLP endpoint was accepted: ${env_name}" >&2
    exit 1
  fi
done

cp -R "${fixture_root}/env" "${fixture_root}/unbounded-otel-resource-env"
sed -i.bak 's/^OTEL_RESOURCE_ATTRIBUTES=.*/OTEL_RESOURCE_ATTRIBUTES=service.name=chalk-sync/' \
  "${fixture_root}/unbounded-otel-resource-env/sync.env"
rm "${fixture_root}/unbounded-otel-resource-env/sync.env.bak"
if "${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/unbounded-otel-resource-env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null 2>&1; then
  echo "incomplete Sync telemetry resource attributes were accepted" >&2
  exit 1
fi

cp -R "${fixture_root}/env" "${fixture_root}/whiteboard-env"
sed -i.bak \
  -e '/^CHALK_R2_ACCOUNT_ID=/d' \
  -e '/^CHALK_R2_ACCESS_KEY_ID=/d' \
  -e '/^CHALK_R2_SECRET_ACCESS_KEY=/d' \
  -e '/^CHALK_R2_BUCKET=/d' \
  "${fixture_root}/whiteboard-env/api.env"
rm "${fixture_root}/whiteboard-env/api.env.bak"
sed -i.bak 's/^CHALK_WHITEBOARD_FILES_ENABLED=false$/CHALK_WHITEBOARD_FILES_ENABLED=true/' \
  "${fixture_root}/whiteboard-env/api.env"
rm "${fixture_root}/whiteboard-env/api.env.bak"
if "${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/whiteboard-env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null 2>&1; then
  echo "enabled whiteboard files were accepted without R2 configuration" >&2
  exit 1
fi
printf '%s\n' \
  'CHALK_R2_ACCOUNT_ID=test-account' \
  'CHALK_R2_ACCESS_KEY_ID=test-access-key' \
  'CHALK_R2_SECRET_ACCESS_KEY=test-secret-key' \
  'CHALK_R2_BUCKET=chalk-whiteboard-test' >>"${fixture_root}/whiteboard-env/api.env"
"${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/whiteboard-env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null

cp "${managed_root}/contracts/planetscale-sync-proof.example.json" "${fixture_root}/unverified-sync-proof.json"
chmod 600 "${fixture_root}/unverified-sync-proof.json"
if "${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/unverified-sync-proof.json" \
  --rendered-root "${fixture_root}/rendered" \
  --allow-dirty >/dev/null 2>&1; then
  echo "unverified PlanetScale proof was accepted" >&2
  exit 1
fi

cp -R "${fixture_root}/rendered" "${fixture_root}/tampered-rendered"
sed -i.bak 's/^ReadOnly=true$/ReadOnly=false/' "${fixture_root}/tampered-rendered/quadlet/chalk-api.container"
rm "${fixture_root}/tampered-rendered/quadlet/chalk-api.container.bak"
if "${managed_root}/scripts/validate-runtime" \
  --env-root "${fixture_root}/env" \
  --secret-root "${fixture_root}/secrets" \
  --manifest "${fixture_root}/release-manifest.json" \
  --sync-proof "${fixture_root}/sync-proof.json" \
  --rendered-root "${fixture_root}/tampered-rendered" \
  --allow-dirty >/dev/null 2>&1; then
  echo "tampered rendered runtime was accepted" >&2
  exit 1
fi

echo "PASS managed-episode config smoke"

# Render to /run/chalk/env/api.env with mode 0600. Values marked __SECRET__ come
# from the nightly SSM namespace and must never enter the release manifest.
CHALK_API_ADDR=0.0.0.0:8080
CHALK_API_CORS_ALLOWED_ORIGINS=https://nightly.chalkmeet.com
CHALK_API_ENV=nightly
CHALK_API_TRUSTED_PROXY_CIDRS=10.89.0.0/24
CHALK_API_LOG_FORMAT=json
CHALK_API_LOG_LEVEL=info
CHALK_API_OPERATION_LOGS=true
CHALK_API_REQUEST_LOGS=errors
CHALK_API_SERVICE=chalk-api
CHALK_API_VERSION=__RELEASE_ID__
CHALK_API_OTLP_ENDPOINT=https://api.axiom.co
OTEL_EXPORTER_OTLP_TRACES_HEADERS=__SECRET_AXIOM_TRACE_OTLP_HEADERS__
OTEL_EXPORTER_OTLP_LOGS_HEADERS=__SECRET_AXIOM_LOG_OTLP_HEADERS__
OTEL_EXPORTER_OTLP_METRICS_HEADERS=__SECRET_AXIOM_METRICS_OTLP_HEADERS__
CHALK_DATABASE_URL=__SECRET_PLANETSCALE_PGBOUNCER_URL_WITH_SSLMODE_VERIFY_FULL__
CHALK_DATABASE_MAX_CONNS=4
CHALK_DATABASE_MIN_CONNS=1
CHALK_REDIS_URL=redis://redis:6379/0
CHALK_SYNC_TOKEN_ISSUER=https://nightly-api.chalkmeet.com
CHALK_SYNC_TOKEN_AUDIENCE=chalk-nightly-sync
CHALK_SYNC_TOKEN_KEY_ID=__SECRET__
CHALK_SYNC_TOKEN_PRIVATE_KEY=__SECRET__
CHALK_MEDIA_TOKEN_VERIFICATION_KEYS=__SECRET__
CHALK_PROVIDER_BRIDGE_ADDRESS=0.0.0.0:8443
CHALK_PROVIDER_BRIDGE_SERVER_CERT_FILE=/run/chalk/provider-bridge/server.crt
CHALK_PROVIDER_BRIDGE_SERVER_KEY_FILE=/run/chalk/provider-bridge/server.key
CHALK_PROVIDER_BRIDGE_CLIENT_CA_FILE=/run/chalk/provider-bridge/client-ca.crt
CHALK_PROVIDER_BRIDGE_SPIFFE_TRUST_DOMAIN=chalkmeet.com
CHALK_DEFAULT_MEDIA_PLANE=cf_sfu
CHALK_CLOUDFLARE_ACCOUNT_ID=__SECRET__
CHALK_CLOUDFLARE_API_TOKEN=__SECRET__
CHALK_CLOUDFLARE_REALTIME_APP_ID=__SECRET__
CHALK_CLOUDFLARE_REALTIME_APP_SECRET=__SECRET__
CHALK_R2_ACCOUNT_ID=__SECRET__
CHALK_R2_ACCESS_KEY_ID=__SECRET__
CHALK_R2_SECRET_ACCESS_KEY=__SECRET__
CHALK_R2_BUCKET=chalk-recorder-nightly
CHALK_RECORDING_KMS_KEY_ID=__SECRET_NIGHTLY_RECORDING_KMS_KEY_ID__
CHALK_RECORDING_KMS_REGION=ap-southeast-1
CHALK_RECORDING_ENABLED=true
CHALK_TRANSCRIPTION_ENABLED=true
# Required only when CHALK_TRANSCRIPTION_ENABLED=true. The workload secret must
# be the same value read by the dispatcher from its exact SSM SecureString ARN.
CHALK_TRANSCRIPTION_WORKLOAD_AUTH_SECRET=__SECRET_TRANSCRIPTION_WORKLOAD_AUTH_SECRET__
CHALK_TRANSCRIPTION_CONTROL_AUDIENCE=chalk-nightly-control-api
CHALK_TRANSCRIPTION_DISPATCHER_FUNCTION_NAME=chalk-nightly-transcription-dispatcher
CHALK_WHITEBOARD_FILES_ENABLED=false
# Shared R2 storage enables chat attachments. The whiteboard flag controls
# whether the same private bucket also serves whiteboard-v1 files.
CHALK_WEBHOOK_ENCRYPTION_KEY=__SECRET_BASE64_32_BYTES__

# The controller injects the three mTLS file paths at deploy time.
CHALK_RECORDER_FLEET_ISSUER_URL=https://host.containers.internal:8444
CHALK_RECORDER_FLEET_ISSUER_SERVER_NAME=nightly-recording-control.chalkmeet.com

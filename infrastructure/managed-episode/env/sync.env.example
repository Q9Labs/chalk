# Render to /run/chalk/env/sync.env with mode 0600. This contract intentionally
# leaves production boot checks enabled.
PORT=4100
CHALK_SYNC_BIND_IP=0.0.0.0
CHALK_API_ENV=production
CHALK_API_URL=https://api.chalkmeet.com
CHALK_DATABASE_URL=__SECRET_PLANETSCALE_DIRECT_URL_WITH_SSLMODE_VERIFY_FULL__
CHALK_SYNC_DATABASE_POOL_SIZE=2
CHALK_EPISODE_DIAGNOSTICS=hosted
CHALK_EPISODE_DIAGNOSTICS_PRODUCTION_OPT_IN=true
CHALK_EPISODE_DIAGNOSTICS_SERVICE_ISSUER=https://api.chalkmeet.com
CHALK_EPISODE_DIAGNOSTICS_SERVICE_KEY_ID=__SECRET_EPISODE_DIAGNOSTICS_SERVICE_KEY_ID__
CHALK_EPISODE_DIAGNOSTICS_SERVICE_PRIVATE_KEY=__SECRET_EPISODE_DIAGNOSTICS_ED25519_PRIVATE_KEY__
CHALK_SYNC_DIAGNOSTICS_ALLOWED_HOSTS=api.chalkmeet.com
CHALK_SYNC_INSTANCE_ID=__SYNC_INSTANCE_ID__
CHALK_SYNC_GENERATION=__SYNC_GENERATION__
CHALK_SYNC_RELEASE_ID=__RELEASE_ID__
CHALK_SYNC_TOKEN_ISSUER=https://api.chalkmeet.com
CHALK_SYNC_TOKEN_AUDIENCE=chalk-sync
CHALK_SYNC_TOKEN_PUBLIC_KEYS=__SECRET_JSON_KEYRING__
CHALK_SYNC_MAX_WAL_LAG_BYTES=16777216
CHALK_SYNC_PROVIDER_BRIDGE_URL=https://chalk-api:8443
CHALK_SYNC_PROVIDER_BRIDGE_CERTFILE=/run/chalk/provider-bridge/client.crt
CHALK_SYNC_PROVIDER_BRIDGE_KEYFILE=/run/chalk/provider-bridge/client.key
CHALK_SYNC_PROVIDER_BRIDGE_CAFILE=/run/chalk/provider-bridge/server-ca.crt
CHALK_SYNC_OTLP_ENDPOINT=https://api.axiom.co
OTEL_EXPORTER_OTLP_TRACES_HEADERS=__SECRET_AXIOM_TRACE_OTLP_HEADERS__
OTEL_RESOURCE_ATTRIBUTES=service.name=chalk-sync,service.version=__RELEASE_ID__,deployment.environment.name=production,service.instance.id=__SYNC_INSTANCE_ID__

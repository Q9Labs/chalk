#!/usr/bin/env bash
# Runs the nightly real-call proofs under the staging SFU lease that the caller holds.
#
#   run-proofs <run-prefix> <status-dir> <proof>...
#
# Proofs run one after another: every proof serves the one proof origin on a fixed loopback port that the Tenant
# allows, so two at once fail with EADDRINUSE. Each proof's exit status goes to <status-dir>/<proof>, and a failed
# proof does not stop the rest. Exit 0 means every proof passed.
set -uo pipefail

if [ "$#" -lt 3 ]; then
  echo "usage: run-proofs <run-prefix> <status-dir> <proof>..." >&2
  exit 2
fi
prefix=$1
status_dir=$2
shift 2

prove() {
  local proof=$1 start status=0
  start=$(date +%s)
  CHALK_PROOF_RUN_ID="${prefix}-${proof}" pnpm prod:proof "$proof" 2>&1 || status=$?
  [ -z "${GITHUB_STEP_SUMMARY:-}" ] || echo "$proof wall seconds: $(($(date +%s) - start))" >> "$GITHUB_STEP_SUMMARY"
  echo "$status" > "${status_dir}/${proof}"
}

mkdir -p "$status_dir"
for proof in "$@"; do
  prove "$proof" | sed -u "s/^/[${proof}] /"
done

for proof in "$@"; do
  [ "$(cat "${status_dir}/${proof}" 2> /dev/null || echo 1)" = 0 ] || exit 1
done

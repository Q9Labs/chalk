#!/usr/bin/env bash
# Runs the nightly real-call proofs under the staging SFU lease that the caller holds.
#
#   run-proofs <run-prefix> <status-dir> <proof>...
#
# A Space holds one live Episode, so proofs on one Space run one after another. call-artifacts has its own Space
# (the automatic Recording and Transcript one), so it runs beside the others. Each proof's exit status goes to
# <status-dir>/<proof>, and a failed proof does not stop the rest. Exit 0 means every proof passed.
set -uo pipefail

if [ "$#" -lt 3 ]; then
  echo "usage: run-proofs <run-prefix> <status-dir> <proof>..." >&2
  exit 2
fi
prefix=$1
status_dir=$2
shift 2

prove() {
  local proof=$1 start status=0
  start=$(date +%s)
  CHALK_PROOF_RUN_ID="${prefix}-${proof}" pnpm prod:proof "$proof" 2>&1 || status=$?
  [ -z "${GITHUB_STEP_SUMMARY:-}" ] || echo "$proof wall seconds: $(($(date +%s) - start))" >> "$GITHUB_STEP_SUMMARY"
  echo "$status" > "${status_dir}/${proof}"
}

# Output is labelled by proof, because two proofs print at the same time.
lane() {
  local proof
  for proof in "$@"; do
    prove "$proof" | sed -u "s/^/[${proof}] /"
  done
}

mkdir -p "$status_dir"
shared=()
own=()
for proof in "$@"; do
  if [ "$proof" = call-artifacts ]; then own+=("$proof"); else shared+=("$proof"); fi
done

lane ${own[@]+"${own[@]}"} &
lane ${shared[@]+"${shared[@]}"} &
wait

for proof in "$@"; do
  [ "$(cat "${status_dir}/${proof}" 2> /dev/null || echo 1)" = 0 ] || exit 1
done

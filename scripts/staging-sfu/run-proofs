#!/usr/bin/env bash
# Runs the nightly real-call proofs under the staging SFU lease that the caller holds.
#
#   run-proofs <run-prefix> <status-dir> <proof>...
#
# A Space holds one live Episode, so proofs on one Space run one after another. A proof with its own Space
# (ownSpace in scripts/prod-proof/registry.json) can run beside the others, but each proof serves its guests from a
# proof_origin that the Tenant allows by port. It runs beside the others only when CHALK_PROOF_PROOF_ORIGIN_OWN
# names a second allowed origin for it; otherwise every proof runs one after another on CHALK_PROOF_PROOF_ORIGIN.
# Each proof's exit status goes to <status-dir>/<proof>, and a failed proof does not stop the rest. Exit 0 means every proof passed.
set -uo pipefail

if [ "$#" -lt 3 ]; then
  echo "usage: run-proofs <run-prefix> <status-dir> <proof>..." >&2
  exit 2
fi
prefix=$1
status_dir=$2
shift 2

prove() {
  local origin=$1 proof=$2 start status=0
  start=$(date +%s)
  CHALK_PROOF_PROOF_ORIGIN="$origin" CHALK_PROOF_RUN_ID="${prefix}-${proof}" pnpm prod:proof "$proof" 2>&1 || status=$?
  [ -z "${GITHUB_STEP_SUMMARY:-}" ] || echo "$proof wall seconds: $(($(date +%s) - start))" >> "$GITHUB_STEP_SUMMARY"
  echo "$status" > "${status_dir}/${proof}"
}

# Output is labelled by proof, because two proofs print at the same time. The runner honours a workflow command only at the
# start of a line, so ::add-mask:: lines pass through unlabelled, and any other line has a proof API key replaced.
lane() {
  local origin=$1 proof
  shift
  for proof in "$@"; do
    prove "$origin" "$proof" | sed -u -e '/^::add-mask::/b' -e 's/chalk_sk_[A-Za-z0-9._-]*/chalk_sk_***/g' -e "s/^/[${proof}] /"
  done
}

mkdir -p "$status_dir"
origin=${CHALK_PROOF_PROOF_ORIGIN:?CHALK_PROOF_PROOF_ORIGIN is not set}
if [ -n "${CHALK_PROOF_PROOF_ORIGIN_OWN:-}" ] && [ "$CHALK_PROOF_PROOF_ORIGIN_OWN" != "$origin" ]; then
  shared=()
  own=()
  for proof in "$@"; do
    if [ "$(node scripts/prod-proof/registry.mjs lane "$proof")" = own ]; then own+=("$proof"); else shared+=("$proof"); fi
  done
  lane "$CHALK_PROOF_PROOF_ORIGIN_OWN" ${own[@]+"${own[@]}"} &
  lane "$origin" ${shared[@]+"${shared[@]}"} &
  wait
else
  lane "$origin" "$@"
fi

for proof in "$@"; do
  [ "$(cat "${status_dir}/${proof}" 2> /dev/null || echo 1)" = 0 ] || exit 1
done

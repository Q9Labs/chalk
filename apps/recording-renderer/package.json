{
  "name": "@chalk/recording-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:node",
    "build:node": "vite build --config vite.node.config.ts",
    "fixture": "vite build --config vite.node.config.ts --mode fixture && node ./dist/fixture/compose-fixture.js",
    "check-types": "tsc-rs --noEmit",
    "lint": "pnpm exec oxfmt --check . && pnpm run check-types"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@napi-rs/canvas": "1.0.9",
    "@q9labsai/chalk-react": "workspace:^",
    "@q9labsai/chalk-whiteboard": "workspace:^",
    "@q9labsai/recording-presentation": "workspace:^",
    "happy-dom": "^21.0.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "vite": "8.1.6"
  }
}

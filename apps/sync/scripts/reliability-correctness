#!/usr/bin/env bash
# reliability-correctness [server|clients|all]: the Sync server gate, the client proofs against it, or both (the default).
set -euo pipefail
repository_root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$repository_root"
part="${1:-all}"
case "$part" in
  server | clients | all) ;;
  *)
    echo "usage: reliability-correctness [server|clients|all]" >&2
    exit 2
    ;;
esac
if [[ "$part" != clients ]]; then
  apps/sync/scripts/gate.sh run
fi
if [[ "$part" != server ]]; then
  # The client proofs start the Sync fixture with mix, which needs the locked dependencies; the server part fetches them in its own gate.
  if [[ "$part" == clients ]]; then
    apps/sync/scripts/gate.sh deps
  fi
  pnpm --dir sdks/typescript/client run test
  pnpm --dir packages/whiteboard run test
  pnpm --dir sdks/typescript/client run test:sync-browser
fi

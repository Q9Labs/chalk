#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# shellcheck source=scripts/gates/owned-command.sh
source ../../scripts/gates/owned-command.sh

output="$(mktemp "${TMPDIR:-/tmp}/chalk-sync-test-output.XXXXXX")"
cleanup() {
  stop_owned
  rm -f "${output}"
}
trap cleanup EXIT

strict_tests() {
  mix test "$@" 2>&1 | tee "${output}"
  return "${PIPESTATUS[0]}"
}

test_status=0
run_owned strict_tests "$@" || test_status="$?"

if ((test_status != 0)); then
  exit "${test_status}"
fi

if grep -Eq '(^|, )[1-9][0-9]* (invalid|skipped)' "${output}"; then
  echo "Sync tests reported invalid or skipped cases; the strict reliability gate requires zero" >&2
  exit 1
fi

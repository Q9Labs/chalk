{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-log.mjs dev:raw",
    "dev:raw": "node scripts/local-dev.mjs",
    "dev:vite": "vite dev --host 127.0.0.1",
    "build": "pnpm --filter @q9labsai/chalk-whiteboard run build && pnpm run sync:public && vite build && pnpm exec tsx scripts/prepare-pages-spa.mjs && pnpm run build:dashboard-functions",
    "sync:public": "pnpm exec tsx scripts/sync-public-assets.ts",
    "brand:assets": "pnpm exec tsx scripts/brand-assets.ts",
    "preview": "vite preview",
    "test": "pnpm run sync:public && node ../../scripts/test/run.mjs node --import tsx --test tests/selfhost-assets/headers.mjs tests/selfhost-assets/versions.mjs tests/selfhost-assets/sync-public-assets.mjs tests/selfhost-assets/store.mjs && node ../../scripts/test/run.mjs pnpm exec vitest run --config ./vitest.config.ts",
    "check-types": "tsc-rs --project tsconfig.check-types.json --noEmit",
    "perf:call": "node scripts/check-call-performance.mjs",
    "perf:call:propose": "node scripts/propose-call-budgets.mjs",
    "test:dashboard": "node tests/dashboard/e2e.mjs",
    "check-types:dashboard": "tsc --project tsconfig.dashboard.json --noEmit",
    "build:dashboard-functions": "wrangler pages functions build --outdir dist/client/_worker.js --output-routes-path dist/client/_routes.json"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@q9labsai/chalk-client": "workspace:^5.2.3",
    "@q9labsai/chalk-react": "workspace:^5.2.3",
    "@q9labsai/chalk-ui": "workspace:^5.2.3",
    "@q9labsai/chalk-whiteboard": "workspace:^5.2.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.18",
    "effect": "4.0.0-beta.102",
    "nitro": "latest",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unenv": "^1.10.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.1",
    "@mdx-js/rollup": "3.1.1",
    "@shikijs/rehype": "4.4.3",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/mdx": "2.0.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "aws4fetch": "1.0.20",
    "github-slugger": "2.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "^6.0.3",
    "vite": "8.1.6",
    "vitest": "^4.1.12"
  }
}
